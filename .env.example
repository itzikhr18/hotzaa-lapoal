# Local/reference environment variables for hotzaa-lapoal.
# Do not put real secrets in this file.
# Copy the names into Cloudflare Pages > Settings > Environment variables > Production.

# Chatbot server key
GEMINI_API_KEY=replace_with_gemini_api_key

# Lead capture email delivery via Resend
RESEND_API_KEY=replace_with_resend_api_key
LEAD_NOTIFY_EMAIL=your_destination_email@example.com
LEAD_FROM_EMAIL="Hotzaa Lapoal <leads@your-verified-domain.com>"

# Optional: send leads to Make/Zapier/CRM webhook instead of, or in addition to, email
LEAD_WEBHOOK_URL=
