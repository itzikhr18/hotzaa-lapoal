---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { glossarySections as sections } from '../../data/glossary.mjs';

const publishDate = '2026-03-31';

// כל מונחי המילון — מקור אמת אחד לעמוד ולסכמת DefinedTermSet
// DefinedTermSet — נבנית אוטומטית מכל המונחים שבעמוד
const schema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'מילון מושגים — הוצאה לפועל בעברית פשוטה',
  description: 'מושגי הוצאה לפועל בעברית פשוטה, עם קישור למקור רשמי ותנאים שחשוב לבדוק.',
  inLanguage: 'he',
  url: 'https://hotzaa-lapoal.info/milon/',
  datePublished: publishDate,
  dateModified: '2026-09-13',
  hasDefinedTerm: sections.flatMap(sec =>
    sec.terms.map(t => ({
      '@type': 'DefinedTerm',
      '@id': `https://hotzaa-lapoal.info/milon/#${t.id}`,
      name: t.name,
      description: t.desc,
      inDefinedTermSet: 'https://hotzaa-lapoal.info/milon/',
    }))
  ),
};
---

<BaseLayout
  title="מילון מושגי הוצאה לפועל — הגדרות ומקורות רשמיים"
  description="מהם אזהרה, פרעתי, עיקול, צו תשלומים והפטר? מילון מושגים בעברית פשוטה עם מקורות רשמיים והבחנות חשובות לקריאת מכתב או החלטה בתיק."
  canonicalUrl="https://hotzaa-lapoal.info/milon/"
  ogType="website"
  schema={schema}
>
  <Header />

  <main id="main-content">

    <div class="max-w-4xl mx-auto px-4 pt-4">
      <Breadcrumb items={[{ label: 'מילון מונחים' }]} />
    </div>

    <!-- Hero -->
    <section class="bg-linear-to-l from-blue-700 to-blue-900 text-white py-12 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-blue-200 text-sm font-medium mb-2">עריכת תוכן: 13 בספטמבר 2026 | מידע כללי</p>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">מילון מושגים — הוצאה לפועל בעברית פשוטה</h1>
        <p class="text-lg text-blue-100 max-w-2xl mx-auto">
          {sections.reduce((sum, section) => sum + section.terms.length, 0)} מושגי הוצאה לפועל, עיקולים וחדלות פירעון — עם מקור לקריאה נוספת.
          הגדרה קצרה אינה מחליפה קריאת צו, דין או ייעוץ משפטי.
        </p>
      </div>
    </section>

    <!-- Sticky alpha nav -->
    <nav aria-label="ניווט לפי אות" class="sticky top-16 z-30 bg-white border-b border-gray-200 shadow-xs overflow-x-auto">
      <div class="max-w-4xl mx-auto px-2 py-2 flex gap-1 flex-nowrap text-sm font-medium">
        {sections.map(sec => (
          <a href={`#${sec.id}`} class="px-2 py-1 rounded-sm hover:bg-blue-50 text-blue-700 whitespace-nowrap">{sec.letter}</a>
        ))}
      </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 py-10">

      <!-- חיפוש -->
      <div class="mb-8">
        <label for="milon-search" class="sr-only">חיפוש מונח</label>
        <input
          id="milon-search"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="🔍 חיפוש מונח (למשל: עיקול רכב, ערב מוגן)…"
          class="w-full border border-neutral-border rounded-xl px-4 py-3 text-base focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
        />
        <p id="milon-noresults" class="hidden mt-3 text-sm text-gray-500">
          לא נמצא מונח תואם. נסו ניסוח אחר, או <a href="/tools/chatbot/" class="text-blue-600 underline">שאלו את הצ'אטבוט</a>.
        </p>
      </div>

      {sections.map(sec => (
        <section id={sec.id} class="mb-10 scroll-mt-28">
          <h2 class="text-2xl font-bold text-blue-800 border-b-2 border-blue-200 pb-2 mb-5">{sec.letter}</h2>
          <dl>
            {sec.terms.map(term => (
              <div id={term.id} class="milon-term scroll-mt-28">
                <dt class="font-bold text-gray-800 text-base mt-4">{term.name}</dt>
                <dd class="text-gray-600 text-sm mb-3">
                  {term.desc}
                  <a href={term.source.url} target="_blank" rel="noopener noreferrer" class="block text-blue-700 underline text-xs mt-2">מקור לקריאה ולבירור: {term.source.label}</a>
                  {term.guide && <a href={term.guide} class="text-blue-600 hover:underline text-xs mr-1">← קרא מדריך מלא</a>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}


      <!-- CTA / disclaimer -->
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mt-8">
        <h2 class="text-xl font-bold text-blue-800 mb-2">לא מצאתם מושג? יש שאלה?</h2>
        <p class="text-gray-700 text-sm mb-4">
          אם מצאתם טעות או חסר מונח, אפשר <a href="/contact/" class="underline">לדווח לנו</a> עם קישור למקור רשמי, בלי לשלוח פרטי תיק.
          למידע נוסף בקרו בעמוד <a href="/guides/" class="text-blue-600 hover:underline">המדריכים המלאים</a>.
        </p>
        <p class="text-xs text-gray-500">
          המידע במילון זה הוא כללי ואינו מהווה ייעוץ משפטי. לשאלות ספציפיות פנו לעורך דין או ללשכת הסיוע המשפטי.
        </p>
      </div>

    </div>
  </main>

  <script>
    const input = document.getElementById('milon-search');
    const noResults = document.getElementById('milon-noresults');
    const sections = Array.from(document.querySelectorAll('main section[id]'));
    const norm = (s) => (s || '').toLowerCase();
    input?.addEventListener('input', () => {
      const q = norm(input.value.trim());
      let anyVisible = false;
      sections.forEach(sec => {
        let secVisible = false;
        sec.querySelectorAll('.milon-term').forEach(t => {
          const match = !q || norm(t.textContent).includes(q);
          t.style.display = match ? '' : 'none';
          if (match) secVisible = true;
        });
        sec.style.display = secVisible ? '' : 'none';
        if (secVisible) anyVisible = true;
      });
      if (noResults) noResults.classList.toggle('hidden', anyVisible || !q);
    });
  </script>

  <Footer />
</BaseLayout>
