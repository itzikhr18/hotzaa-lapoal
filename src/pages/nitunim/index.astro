---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { officialSources } from '../../data/reference-content.mjs';

const report = officialSources.report2025;
const PAGE_URL = 'https://hotzaa-lapoal.info/nitunim/';
const UPDATED = '2026-10-06';

// כל המספרים בעמוד הועתקו מדוח פעילות רשות האכיפה והגבייה לשנת 2025 (נכון לסוף 2025).
// אין להוסיף מספר בלי פרק בדוח שבו הוא מופיע.
const keyStats = [
  { value: '560,894', label: 'חייבים עם תיקים פתוחים', note: 'סוף 2025. חייב נספר פעם אחת גם אם יש לו כמה תיקים. כולל כ־59 אלף תאגידים וגופים אחרים.' },
  { value: '1,945,329', label: 'תיקים פתוחים', note: 'כולל תיקי איחוד, לא כולל תיקי חדלות פירעון.' },
  { value: '73.8%', label: 'מהחייבים הפרטיים בלי עורך דין', note: '370,249 מתוך 501,498 חייבים פרטיים.' },
  { value: '8,963,863', label: 'בקשות לעיקול אצל צד שלישי שהוגשו ב־2025', note: 'בנק, מעסיק וכדומה. בקשה נפרדת לכל גורם.' },
  { value: '692,134', label: 'הגבלות דרכון פעילות', note: 'נספרות לפי תיק, לא לפי אדם.' },
  { value: '1,277', label: 'חייבים קיבלו הפטר ב־2025', note: 'בהליכי חדלות פירעון בהוצאה לפועל.' },
];

const caseTypes = [
  { label: 'תביעה על סכום קצוב', pct: 41 },
  { label: 'שיקים ושטרות', pct: 30 },
  { label: 'מימוש פסק דין', pct: 17 },
  { label: 'כביש אגרה', pct: 7 },
  { label: 'מזונות', pct: 3 },
];

const districts = [
  { label: 'חיפה והצפון', count: '658,045', pct: 34 },
  { label: 'תל אביב', count: '552,783', pct: 28 },
  { label: 'המרכז', count: '502,007', pct: 26 },
  { label: 'ירושלים והדרום', count: '232,492', pct: 12 },
];

// לוח 3.6 בדוח: חייבים פרטיים ואחוזם מתושבי העיר בני 15 ומעלה. ממוין לפי אחוז.
const cities = [
  { name: 'בת ים', debtors: '8,948', pct: '8.3%' },
  { name: 'ירושלים', debtors: '53,662', pct: '7.7%' },
  { name: 'אשקלון', debtors: '8,776', pct: '7.0%' },
  { name: 'באר שבע', debtors: '12,024', pct: '6.9%' },
  { name: 'חיפה', debtors: '15,761', pct: '6.7%' },
  { name: 'נתניה', debtors: '10,961', pct: '6.1%' },
  { name: 'אשדוד', debtors: '9,975', pct: '5.9%' },
  { name: 'תל אביב־יפו', debtors: '19,972', pct: '5.0%' },
  { name: 'חולון', debtors: '7,495', pct: '5.0%' },
  { name: 'ראשון לציון', debtors: '9,233', pct: '4.5%' },
  { name: 'בית שמש', debtors: '4,040', pct: '4.4%' },
  { name: 'פתח תקווה', debtors: '7,900', pct: '3.9%' },
  { name: 'רחובות', debtors: '3,995', pct: '3.6%' },
  { name: 'הרצליה', debtors: '2,980', pct: '3.5%' },
  { name: 'רמת גן', debtors: '4,880', pct: '3.5%' },
  { name: 'בני ברק', debtors: '3,919', pct: '3.1%' },
];

const faqs = [
  {
    q: 'כמה חייבים יש בהוצאה לפועל?',
    a: 'לפי דוח רשות האכיפה והגבייה, בסוף 2025 היו במערכת ההוצאה לפועל 560,894 חייבים, ולהם כ־2 מיליון תיקים פתוחים. כ־89% מהם חייבים פרטיים, כלומר אנשים ולא חברות.',
  },
  {
    q: 'כמה תיקים פתוחים יש בהוצאה לפועל?',
    a: 'בסוף 2025 היו 1,945,329 תיקים פתוחים, כולל תיקי איחוד ולא כולל תיקי חדלות פירעון. זו ירידה של 1.6% לעומת סוף 2024. במהלך 2025 נפתחו 360,690 תיקים חדשים ונסגרו 392,655.',
  },
  {
    q: 'כמה חייבים מיוצגים על ידי עורך דין?',
    a: 'ל־73.8% מהחייבים הפרטיים (370,249 אנשים) אין עורך דין באף אחד מהתיקים הפתוחים שלהם. אצל הזוכים התמונה הפוכה: ל־72% מהם יש ייצוג. הדוח מציין שחלק מהחייבים מקבלים ייעוץ בלי ייצוג פורמלי, בקליניקות ובעמדות סיוע.',
  },
  {
    q: 'מה סכום החוב הממוצע בתיק הוצאה לפועל?',
    a: 'בתיקים שהיו פתוחים בסוף 2025, סכום החוב בפתיחת התיק היה בממוצע כ־38,661 ₪ ובחציון כ־7,132 ₪. החציון מתאר טוב יותר תיק רגיל: בחצי מהתיקים החוב בפתיחה נמוך ממנו. ובתיקים החדשים שנפתחו ב־2025, כ־51% נפתחו על פחות מ־5,000 ₪.',
  },
  {
    q: 'כמה אנשים מקבלים הפטר בחדלות פירעון?',
    a: 'ב־2025 קיבלו הפטר 1,277 חייבים בהליכי חדלות הפירעון שבמערכת ההוצאה לפועל. מאז שהחוק נכנס לתוקף ב־15.9.2019 ועד סוף 2025 הוגשו במערכת הזו 35,680 בקשות לפתיחת הליך.',
  },
  {
    q: 'האם אפשר להסיק מהנתונים מה יקרה בתיק שלי?',
    a: 'לא. אלה נתונים ארציים על כל המערכת. הם לא אומרים מה הסיכוי שבקשה מסוימת תתקבל, ולא מחליפים בדיקה של התיק האישי באזור האישי של רשות האכיפה והגבייה.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'נתוני הוצאה לפועל בישראל 2025 — המספרים מהדוח הרשמי',
    description: 'חייבים, תיקים, ייצוג, עיקולים, הגבלות, מזונות וחדלות פירעון: הנתונים המרכזיים מדוח רשות האכיפה והגבייה לשנת 2025, עם הגדרות והסבר פשוט.',
    datePublished: '2026-03-31',
    dateModified: UPDATED,
    author: { '@type': 'Organization', name: 'מערכת הוצאהלפועל.info', url: 'https://hotzaa-lapoal.info/about/' },
    publisher: { '@type': 'Organization', name: 'הוצאהלפועל.info', url: 'https://hotzaa-lapoal.info/' },
    mainEntityOfPage: PAGE_URL,
    citation: { '@type': 'Report', name: report.label, url: report.url },
    temporalCoverage: '2025',
    spatialCoverage: { '@type': 'Country', name: 'ישראל' },
    inLanguage: 'he',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout
  title="נתוני הוצאה לפועל 2025: חייבים, תיקים, עיקולים והגבלות"
  description="560,894 חייבים, 1.95 מיליון תיקים פתוחים, 73.8% מהחייבים הפרטיים בלי עורך דין. כל הנתונים המרכזיים מהדוח הרשמי של רשות האכיפה והגבייה לשנת 2025, עם הגדרות ומקור."
  schema={schema}
>
  <Header />
  <main id="main-content" class="max-w-4xl mx-auto px-4 py-10">
    <Breadcrumb items={[{ label: 'נתוני הוצאה לפועל' }]} />
    <article class="prose prose-lg max-w-none rtl-prose">
      <h1>נתוני הוצאה לפועל בישראל 2025 — המספרים מהדוח הרשמי</h1>
      <p class="text-sm text-gray-600">עודכן: <time datetime={UPDATED}>6 באוקטובר 2026</time>. הנתונים נכונים לסוף 2025, לפי <a href={report.url} target="_blank" rel="noopener noreferrer">{report.label}</a>. זו לא ספירה חיה של 2026.</p>

      <p>כמה אנשים חייבים כסף בהוצאה לפועל? כמה מהם מתמודדים לבד, בלי עורך דין? כמה עיקולים והגבלות מוטלים בשנה? בעמוד הזה ריכזנו את המספרים המרכזיים מהדוח השנתי של רשות האכיפה והגבייה, עם הסבר קצר לכל נתון: מה הוא סופר, ומה הוא לא אומר.</p>
      <p>אם קיבלתם מכתב מההוצאה לפועל: אתם לא לבד. מאות אלפי אנשים נמצאים באותו מצב, ורובם מתמודדים בלי ייצוג.</p>

      <h2 id="summary">המספרים העיקריים במבט אחד</h2>
      <div class="not-prose grid gap-4 sm:grid-cols-2 lg:grid-cols-3 my-6">
        {keyStats.map((s) => (
          <section class="rounded-xl border border-blue-200 bg-blue-50 p-5">
            <p class="text-3xl font-bold text-blue-900" dir="ltr" style="text-align:right">{s.value}</p>
            <h3 class="font-bold text-gray-900 mt-1">{s.label}</h3>
            <p class="text-sm text-gray-700 mt-2">{s.note}</p>
          </section>
        ))}
      </div>

      <h2 id="cases">תיקים: כמה נפתחו, כמה נסגרו ומאיזה סוג</h2>
      <ul>
        <li><strong>1,945,329 תיקים פתוחים</strong> בסוף 2025, ירידה של 1.6% לעומת השנה הקודמת. המספר כולל תיקי איחוד ולא כולל תיקי חדלות פירעון.</li>
        <li><strong>360,690 תיקים חדשים נפתחו</strong> ב־2025, כ־17,500 פחות מב־2024. באותה שנה <strong>נסגרו 392,655 תיקים</strong>.</li>
        <li><strong>80% מהתיקים נפתחים ישירות בהוצאה לפועל, בלי הליך בבית משפט קודם.</strong> למשל תביעה על סכום קצוב, שיק או שטר.</li>
        <li><strong>כ־51% מהתיקים שנפתחו ב־2025 הם על חובות של עד 5,000 ₪,</strong> ורובם נפתחו באופן מקוון.</li>
      </ul>

      <h3>התפלגות התיקים הפתוחים לפי סוג</h3>
      <div class="not-prose space-y-3 my-4" role="list">
        {caseTypes.map((c) => (
          <div role="listitem">
            <div class="flex justify-between text-sm font-medium text-gray-800"><span>{c.label}</span><span>{c.pct}%</span></div>
            <div class="h-3 rounded bg-gray-100 overflow-hidden" aria-hidden="true"><div class="h-3 rounded bg-blue-600" style={`width:${c.pct}%`}></div></div>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-600">שאר התיקים, כ־1.6%, הם תיקי משכון (0.9%) ותיקי איחוד (0.7%). <strong>תביעה על סכום קצוב</strong> היא חוב בסכום מוגדר שיש עליו ראיה בכתב (למשל חוזה או התחייבות), או חוב לפי חוק. אפשר לפתוח עליו תיק ישירות בהוצאה לפועל, בלי פסק דין, עד 75,000 ₪ ביום ההגשה.</p>

      <h3>התפלגות התיקים הפתוחים לפי מחוז</h3>
      <div class="not-prose overflow-x-auto my-4">
        <table class="w-full text-sm border-collapse">
          <thead><tr class="bg-gray-100"><th class="border border-gray-300 px-3 py-2 text-right">מחוז</th><th class="border border-gray-300 px-3 py-2 text-right">תיקים פתוחים</th><th class="border border-gray-300 px-3 py-2 text-right">חלק מהמלאי</th></tr></thead>
          <tbody>
            {districts.map((d) => (
              <tr><td class="border border-gray-300 px-3 py-2">{d.label}</td><td class="border border-gray-300 px-3 py-2">{d.count}</td><td class="border border-gray-300 px-3 py-2">כ־{d.pct}%</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="debtors">חייבים: מי נמצא בהוצאה לפועל</h2>
      <ul>
        <li><strong>560,894 חייבים</strong> עם כ־2 מיליון תיקים פתוחים בסוף 2025. כ־89% מהם חייבים פרטיים.</li>
        <li><strong>255,441 חייבים (כ־46%) יש להם תיק אחד בלבד.</strong></li>
        <li><strong>ל־18% מהחייבים (101,838) יש תיק אחד, והחוב בפתיחתו נמוך מ־5,000 ₪.</strong> זה חוב קטן יחסית, שכדאי לטפל בו מוקדם, לפני שהוא גדל בריבית ובהוצאות.</li>
        <li>בקצה השני, <strong>ל־7.7% מהחייבים (42,924) יש יותר מ־10 תיקים.</strong> ל־6.1% (34,219) יש יותר מ־10 תיקים וגם חוב בפתיחה של מעל 100,000 ₪ בכל התיקים יחד. למצב כזה מיועדים <a href="/guides/ichud-tikim/">איחוד תיקים</a> ו<a href="/insolvency/">חדלות פירעון</a>.</li>
        <li>לפי מספר תעודת זהות, יש בהוצאה לפועל <strong>501,498 חייבים פרטיים</strong>. השכיחות של חייבים גבוהה יותר בגילי העבודה 35 עד 64, בהשוואה לכלל האוכלוסייה הבוגרת.</li>
      </ul>

      <h3 id="cities">חייבים לפי עיר: 16 הערים הגדולות</h3>
      <p>כמה מתושבי העיר הם חייבים בהוצאה לפועל? הטבלה מציגה את מספר החייבים הפרטיים בכל אחת מ־16 הערים הגדולות, ואת אחוזם מתושבי העיר בני 15 ומעלה.</p>
      <div class="not-prose overflow-x-auto my-4">
        <table class="w-full text-sm border-collapse">
          <thead><tr class="bg-gray-100"><th class="border border-gray-300 px-3 py-2 text-right">עיר</th><th class="border border-gray-300 px-3 py-2 text-right">חייבים פרטיים</th><th class="border border-gray-300 px-3 py-2 text-right">אחוז מבני 15 ומעלה</th></tr></thead>
          <tbody>
            {cities.map((c) => (
              <tr><td class="border border-gray-300 px-3 py-2">{c.name}</td><td class="border border-gray-300 px-3 py-2">{c.debtors}</td><td class="border border-gray-300 px-3 py-2">{c.pct}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>האחוזים הגבוהים ביותר בארץ נמדדו דווקא ביישובים קטנים יותר. בראש רשימת היישובים בדוח נמצא ג׳סר א־זרקא, שבו 28.5% מבני 15 ומעלה הם חייבים בהוצאה לפועל. הרשות מפרסמת באתר שלה קובץ מלא לכל יישוב שיש בו יותר ממאה חייבים. אחוז גבוה משקף בעיקר מצב כלכלי באזור, ולא אומר דבר על אדם מסוים שגר בו.</p>

      <h3>כמה גדול חוב טיפוסי?</h3>
      <p>בתיקים שהיו פתוחים בסוף 2025, <strong>סכום החוב בפתיחת התיק היה בממוצע כ־38,661 ₪</strong>, אבל <strong>החציון היה כ־7,132 ₪ בלבד</strong>. ובתיקים החדשים שנפתחו ב־2025, כ־51% נפתחו על פחות מ־5,000 ₪.</p>
      <p><strong>מה זה חציון?</strong> זה הסכום שבאמצע: בחצי מהתיקים החוב בפתיחה נמוך ממנו, ובחצי גבוה ממנו. הממוצע גבוה הרבה יותר כי מעט תיקים עם חובות ענקיים מושכים אותו למעלה. לכן החציון מתאר טוב יותר תיק רגיל. (בחישוב הוחרגו כ־100 תיקים עם חוב של יותר מ־10 מיליון ₪.)</p>

      <h2 id="representation">פער הייצוג: הזוכים עם עורך דין, החייבים לבד</h2>
      <div class="not-prose rounded-xl border border-amber-300 bg-amber-50 p-5 my-6">
        <p class="text-lg font-bold text-amber-900">לפי סיכום הדוח, ל־72% מהזוכים יש עורך דין, לעומת 28% בלבד מהחייבים (בתיק אחד לפחות).</p>
        <p class="mt-2 text-gray-800">מבין החייבים הפרטיים, <strong>73.8% (370,249 אנשים) מתמודדים בלי עורך דין</strong> באף אחד מהתיקים הפתוחים שלהם.</p>
      </div>
      <p>הדוח מוסיף שחלק מהחייבים נעזרים בייעוץ משפטי בלי ייצוג פורמלי, בקליניקות ובעמדות סיוע. כלומר, "בלי ייצוג" לא תמיד אומר "בלי עזרה בכלל".</p>
      <p>המשמעות המעשית: רוב החייבים צריכים להבין לבד מה מותר לעקל, אילו בקשות אפשר להגיש ומה המועדים. בשביל זה נכתבו המדריכים באתר, למשל <a href="/guides/bitul-ikul/">ביטול עיקול</a>, <a href="/guides/tzav-tashlumim/">צו תשלומים</a> ו<a href="/rights/skhomim-mugganim/">סכומים מוגנים מעיקול</a>. אם אתם שוקלים ייצוג, ראו <a href="/guides/orech-din/">מתי כדאי עורך דין</a>.</p>

      <h2 id="requests">בקשות, החלטות ועיקולים</h2>
      <ul>
        <li><strong>8,963,863 בקשות לעיקול אצל צד שלישי</strong> הוגשו ב־2025. צד שלישי הוא מי שמחזיק נכסים של החייב או חייב לו כסף, כמו בנק או מעסיק. הבקשה השכיחה ביותר היא לעיקול משכורת או עיקול מתחדש.</li>
        <li><strong>443,427 בקשות הגישו חייבים או עורכי הדין שלהם,</strong> כ־3% מכל הבקשות.</li>
        <li><strong>2,636,872 החלטות</strong> נתנו רשמי ההוצאה לפועל ב־2025 (לא כולל החלטות מנהליות והחלטות מערכת). ההחלטות השכיחות ניתנו בבקשות למתן צו למסירת מידע על החייב (788,856) ובבקשות למימוש עיקול אצל צד שלישי (684,298), כלומר להעברת הכסף שעוקל.</li>
      </ul>
      <p><strong>חשוב לקרוא נכון את ה־3%.</strong> לפי הדוח, הפער לא בהכרח מעיד שחייבים לא מעורבים בתיק. זוכה שלא יודע איפה החייב מחזיק כסף מגיש בקשת עיקול נפרדת לכל בנק או מעסיק. חייב יכול להגיש בקשה אחת נגד כל העיקולים. לכן מספר הבקשות של זוכים גבוה בהרבה מטבעו.</p>

      <h2 id="restrictions">הגבלות: דרכון, יציאה מהארץ, כרטיס חיוב</h2>
      <ul>
        <li><strong>291,600 בקשות להטלת הגבלות</strong> הוגשו ב־2025.</li>
        <li><strong>692,134 הגבלות דרכון היו פעילות בסוף 2025,</strong> מתוכן 135,904 הוטלו במהלך 2025.</li>
      </ul>
      <p>שימו לב: ההגבלות מוטלות בתיק, לא על האדם. לחייב עם כמה תיקים יכולות להיות כמה הגבלות דרכון. לכן 692,134 הוא מספר ההגבלות, לא מספר האנשים המוגבלים. איך מבטלים הגבלה: <a href="/guides/bitul-hagbalot/">ביטול הגבלות</a>, <a href="/rights/hagbalot/">זכויות בנושא הגבלות</a> ו<a href="/guides/ikul-yetzia/">עיכוב יציאה מהארץ</a>.</p>

      <h2 id="limited-means">חייבים מוגבלים באמצעים</h2>
      <p>בסוף 2025 היו במערכת <strong>33,220 חייבים שהוכרזו כמוגבלים באמצעים</strong>, ו־8,471 מהם בהליך חדלות פירעון פעיל (בהוצאה לפועל או אצל הממונה, כולל הליכי פשיטת רגל). לפי הדוח, מאז 15.9.2019, כשחוק חדלות פירעון נכנס לתוקף, אין אפשרות להכריז על חייבים חדשים כמוגבלים באמצעים. חייב שלא יכול לשלם את החוב בתקופה שקובע החוק מופנה להליכי חדלות פירעון. הסבר: <a href="/guides/hayav-mugbal/">חייב מוגבל באמצעים</a>.</p>

      <h2 id="creditors">זוכים: מי גובה את החובות</h2>
      <ul>
        <li><strong>188,189 זוכים</strong> בסוף 2025. 79% מהם זוכים פרטיים ו־19% תאגידים.</li>
        <li><strong>ל־73% מהזוכים יש תיק אחד בלבד,</strong> ומנגד 171 זוכים (0.1%) מנהלים כל אחד יותר מאלף תיקים.</li>
        <li><strong>תאגידים (בנקים, חברות תקשורת, חברות ביטוח ועוד) הם כ־20% מהזוכים, אבל מחזיקים כ־70% מהתיקים הפתוחים.</strong> הזוכים הפרטיים מחזיקים כ־14% מהתיקים.</li>
        <li><strong>כ־182 אלף תיקים הם תיקי חוב לבנקים.</strong></li>
      </ul>

      <h2 id="alimony">מזונות</h2>
      <p>בסוף 2025 היו <strong>64,967 תיקי מזונות פתוחים, של 57,101 חייבים</strong>. במסלול המזונות האישי, שבו פקידי ההוצאה לפועל מנהלים את התיק במקום הזוכה, מטופלים 15,835 תיקים של זוכים פרטיים ועוד 41,399 תיקים שהזוכה בהם הוא המוסד לביטוח לאומי. מה עושים עם חוב מזונות: <a href="/guides/mazamot/">מזונות בהוצאה לפועל</a>.</p>

      <h2 id="insolvency">חדלות פירעון בהוצאה לפועל</h2>
      <ul>
        <li>מ־15.9.2019 ועד סוף 2025 הוגשו <strong>35,680 בקשות לפתיחת הליך חדלות פירעון</strong> שנותבו ליחידות חדלות הפירעון במערכת ההוצאה לפועל. 942 בקשות עוד לא אושרו ונמצאות בסטטוס תיק זמני.</li>
        <li>ב־2025 התקיימו 4,782 ישיבות הסדר, 2,079 אסיפות נושים ו־1,443 דיוני שיקום כלכלי.</li>
        <li><strong>1,277 חייבים קיבלו הפטר ב־2025.</strong></li>
      </ul>
      <p><strong>הפטר</strong> הוא החלטה שפוטרת את החייב מיתרת החובות שנוצרו לפני צו פתיחת ההליכים, למעט חריגים שקבועים בחוק. בדרך כלל הוא ניתן בסוף תקופת התשלומים, אם החייב עמד בתנאים, ולפעמים מיד. המספרים כאן הם של מערכת ההוצאה לפועל בלבד. לפרטים: <a href="/insolvency/process/">הליך חדלות פירעון שלב אחר שלב</a> ו<a href="/insolvency/haftar/">מה זה הפטר</a>.</p>

      <h2 id="fines">המרכז לגביית קנסות: מערכת נפרדת עם חפיפה גדולה</h2>
      <p>רשות האכיפה והגבייה מפעילה גם את המרכז לגביית קנסות, שגובה קנסות, אגרות והוצאות עבור המדינה. זו מערכת נפרדת מההוצאה לפועל.</p>
      <ul>
        <li><strong>3,554,401 תיקים פתוחים</strong> במרכז בסוף 2025 (כולל תיקים בשלב טרום חוב). בלי תיקי טרום חוב, כמחצית מהתיקים הם דוחות משטרה, והחוב הממוצע בפתיחה בתיקים האלה הוא 631 ₪.</li>
        <li><strong>710,693 חייבים</strong> במרכז (לא כולל חייבים שיש להם רק תיקים בשלב טרום חוב). כ־77% מהם פרטיים.</li>
        <li><strong>267,073 חייבים נמצאים בשתי המערכות.</strong> הם כ־47% מהחייבים בהוצאה לפועל וכ־38% מהחייבים במרכז לגביית קנסות. (בלוח הזה בדוח מספר החייבים בהוצאה לפועל הוא 558,180, מעט שונה מהמספר בסיכום.)</li>
        <li>בסך הכול מטופלים ברשות האכיפה והגבייה <strong>808,923 חייבים פרטיים</strong>, לפי מספר תעודת זהות.</li>
      </ul>

      <h2 id="limits">מה אי אפשר להסיק מהנתונים</h2>
      <ul>
        <li>מספר תיקים אינו מספר חייבים, ומספר חייבים אינו מספר משקי בית.</li>
        <li>מספר הגבלות אינו מספר אנשים מוגבלים, כי ההגבלות נספרות לפי תיק.</li>
        <li>מלאי בסוף שנה (כמה פתוחים) שונה ממספר התיקים שנפתחו או נסגרו במהלך השנה.</li>
        <li>נתוני ההוצאה לפועל אינם נתוני המרכז לגביית קנסות, ואינם כלל החובות במשק.</li>
        <li>היקף המערכת אינו מעיד על הסיכוי לבטל עיקול, לקבל הפטר או לאשר בקשה מסוימת.</li>
      </ul>
      <p>למה אין כאן שיעורי הצלחה של בקשות או אומדן לגידול חוב? כי לא מצאנו להם מקור רשמי עם הגדרה ותקופת מדידה שאפשר לבדוק. נוסיף נתון רק כשיש לו מקור כזה.</p>

