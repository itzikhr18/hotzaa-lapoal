---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { officialSources } from '../../data/reference-content.mjs';

const report = officialSources.report2025;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'נתוני הוצאה לפועל בישראל — דוח רשות האכיפה 2025',
  description: 'שני נתוני יסוד מהדוח הרשמי, עם תקופת ייחוס והסבר על ההבדל בין חייבים לתיקים.',
  datePublished: '2026-03-31',
  dateModified: '2026-09-13',
  author: { '@type': 'Organization', name: 'מערכת הוצאהלפועל.info', url: 'https://hotzaa-lapoal.info/about/' },
  mainEntityOfPage: 'https://hotzaa-lapoal.info/nitunim/',
  citation: { '@type': 'Report', name: report.label, url: report.url },
  inLanguage: 'he',
};
---
<BaseLayout title="נתוני הוצאה לפועל בישראל — דוח רשות האכיפה 2025" description="כמה חייבים וכמה תיקים פתוחים יש בהוצאה לפועל? נתונים מהדוח הרשמי לשנת 2025, הבחנה בין מדדים והסבר מדוע אין להסיק מהם סיכויי הצלחה בתיק אישי." schema={schema}>
  <Header />
  <main id="main-content" class="max-w-4xl mx-auto px-4 py-10">
    <Breadcrumb items={[{ label: 'נתוני הוצאה לפועל' }]} />
    <article class="prose prose-lg max-w-none rtl-prose">
      <h1>נתוני הוצאה לפועל בישראל — לפי דוח 2025</h1>
      <p class="text-sm text-gray-600">עריכה: <time datetime="2026-09-13">13 בספטמבר 2026</time>. הנתונים מתייחסים לסוף 2025, לא לספירה חיה של שנת 2026.</p>
      <p>כדי להבין את היקף מערכת ההוצאה לפועל חשוב להפריד בין מספר החייבים לבין מספר התיקים. אותו חייב יכול להופיע בכמה תיקים. להלן נתוני היסוד שמופיעים בדוח השנתי של רשות האכיפה והגבייה.</p>
      <div class="not-prose grid gap-4 sm:grid-cols-2 my-6">
        <section class="rounded-xl border border-blue-200 bg-blue-50 p-5">
          <h2 class="font-bold text-blue-900">חייבים עם תיקים פתוחים</h2>
          <p class="text-3xl font-bold my-2">560,894</p>
          <p class="text-sm">מערכת ההוצאה לפועל, סוף שנת 2025. זה אינו מספר המשפחות בישראל ואינו מונה של אנשים פרטיים בלבד.</p>
        </section>
        <section class="rounded-xl border border-blue-200 bg-blue-50 p-5">
          <h2 class="font-bold text-blue-900">תיקים פתוחים</h2>
          <p class="text-3xl font-bold my-2">כ־2 מיליון</p>
          <p class="text-sm">מספר מעוגל, כפי שמופיע בסיכום הדוח. לאותו חייב יכולים להיות כמה תיקים.</p>
        </section>
      </div>
      <p><a href={report.url} target="_blank" rel="noopener noreferrer">מקור: {report.label} (PDF)</a> — סיכום הדוח ופרק החייבים, לרבות לוח 3.2. יש לעיין בהגדרות ובתקופת הייחוס לפני השוואה לדוח אחר.</p>
      <h2>מה אי אפשר להסיק מהנתונים?</h2>
      <ul>
        <li>מספר תיקים אינו מספר חייבים, ומספר חייבים אינו מספר משקי בית.</li>
        <li>נתוני ההוצאה לפועל אינם זהים לנתוני המרכז לגביית קנסות או לכלל החובות במשק.</li>
        <li>מלאי בסוף שנה שונה ממספר התיקים שנפתחו או נסגרו במהלך השנה.</li>
        <li>היקף המערכת אינו מעיד על הסיכוי לביטול עיקול, לקבלת הפטר או לאישור בקשה מסוימת.</li>
      </ul>
      <h2>למה לא מוצגים כאן שיעורי הצלחה ואומדן גידול חוב?</h2>
      <p>לא נמצא בבדיקה בסיס רשמי מספק לנתונים שהוצגו קודם בעמוד על שיעורי הצלחה, התפלגות נושים, גידול חוב שנתי ועלויות ייצוג. הם הוסרו כדי שלא להציג הערכות כעובדות. מספרים כאלה יתווספו רק עם מקור, הגדרה ותקופת מדידה שניתן לבדוק.</p>
      <h2>המידע בתיק האישי</h2>
      <p>לבדיקת יתרה, החלטה או עיקול יש להשתמש במידע הרשמי בתיק, לא בסטטיסטיקה ארצית. התחילו ב<a href="/guides/bdika-tik/">מדריך בדיקת תיק</a> או ב<a href={officialSources.personal.url} target="_blank" rel="noopener noreferrer">אזור האישי הממשלתי</a>. האתר אינו מבקש פרטי זיהוי לצורך קריאת המדריך.</p>
      <h2>מקורות נוספים ובדיקת עדכונים</h2>
      <p>לנתוני האשראי האישיים פנו ל<a href={officialSources.credit.url} target="_blank" rel="noopener noreferrer">מערכת נתוני האשראי של בנק ישראל</a>. אלה נתונים אחרים, ואין להסיק שסגירת תיק מוחקת מיד כל רישום או מבטיחה אשראי חדש.</p>
      <p>מצאנו טעות? אפשר <a href="/contact/">לדווח על העמוד</a> ולצרף קישור למקור, ללא מסמכים אישיים. <a href="/about/#editorial-policy">מדיניות העריכה</a> מסבירה את ההבדל בין עדכון תוכן לבין בדיקה משפטית מקצועית.</p>
    </article>
  </main>
  <Footer />
</BaseLayout>
