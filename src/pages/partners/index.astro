---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PartnerContact from '../../components/PartnerContact.astro';
import { PARTNER_EMAIL, PARTNER_CONTACT_HREF } from '../../data/partners';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'רישוי כלי הכנה לפגישת ייעוץ למשרדי עורכי דין',
  serviceType: 'התאמה, הטמעה ותחזוקה של כלי דיגיטלי תחת מותג המשרד',
  description: 'כלי White-Label להכנת פונים לפגישה: בחירת נושא, רשימת מסמכים כללית והדפסה, עם התאמת מיתוג ותוכן באישור המשרד.',
  url: 'https://hotzaa-lapoal.info/partners/',
  areaServed: { '@type': 'Country', name: 'Israel' },
  provider: {
    '@type': 'Organization',
    name: 'הוצאהלפועל.info',
    url: 'https://hotzaa-lapoal.info/',
    email: PARTNER_EMAIL,
  },
};

const benefits = [
  {
    title: 'חוויה דיגיטלית תחת המותג שלכם',
    text: 'התאמת צבעים, לוגו, ניסוחים וקישורי יצירת קשר כך שהכלים ירגישו חלק טבעי מאתר המשרד.',
    icon: 'brand',
  },
  {
    title: 'רשימת הכנה שאפשר להדפיס',
    text: 'הפונה בוחר נושא, מסמן אילו מסמכים כבר בידיו ומקבל רשימת הכנה כללית. את התוכן המקצועי בודק ומאשר המשרד.',
    icon: 'flow',
  },
  {
    title: 'הקמה ותחזוקה מרוכזות',
    text: 'אנחנו מטפלים בהטמעה, בהתאמות הטכניות ובשיפור שוטף לפי ההיקף שיוגדר בהסכם.',
    icon: 'tools',
  },
];

const faq = [
  {
    q: 'האם אתם מוכרים לידים או פרטי גולשים?',
    a: 'לא. מסלול הרישוי מבוסס על דמי הקמה ותשלום חודשי עבור שימוש בכלים. הוא אינו כולל מכירת פרטי גולשים או תשלום עבור הפניה לעורך דין.',
  },
  {
    q: 'מהו הכלי הראשון שאפשר לבדוק?',
    a: 'כלי הכנה לפגישת ייעוץ: בחירת נושא, סימון מסמכים שכבר נמצאים בידי הפונה ויצירת רשימה להדפסה. אפשר להתנסות בהדגמה לפני הפנייה. כלים נוספים והתאמות נבחנים בנפרד לפי צורכי המשרד.',
  },
  {
    q: 'האם הכלים נותנים ייעוץ משפטי?',
    a: 'לא. הכלים מיועדים למסירת מידע כללי ולהכנת הגולש לשיחה מקצועית. המשרד אחראי לבדיקת הנוסחים המשפטיים, להנחיות המקצועיות ולייעוץ האישי ללקוח.',
  },
  {
    q: 'כמה עולה הרישוי?',
    a: 'המודל כולל דמי הקמה ותשלום חודשי. המחיר נקבע לפי מספר הכלים, עומק ההתאמה, החיבורים הנדרשים ורמת התחזוקה.',
  },
  {
    q: 'איך מתחילים?',
    a: 'שולחים דוא״ל ל־itzikhr18@gmail.com עם כתובת אתר המשרד ותחום העיסוק. מקבלים בדוא״ל את התכולה, המחיר, תנאי הרישוי ואופן האספקה לפני החלטה על רכישה. אין צורך בשיחת מכירה ואין לצרף פרטי לקוחות או תיקים.',
  },
  {
    q: 'האם חייבים לתאם שיחה כדי לרכוש?',
    a: 'לא. אפשר לבקש פרטים ולהתקדם לרכישה בהתכתבות בדוא״ל בלבד. כרגע אין באתר סליקה או אספקה אוטומטיות; לחיצה על הקישור פותחת טיוטה ואינה יוצרת הזמנה או חיוב.',
  },
  {
    q: 'האם נשלחים אליכם מסמכים או פרטי פונים בהדגמה?',
    a: 'לא. ההדגמה אינה מבקשת שם, טלפון, סכום או מספר תיק, ואינה מאפשרת העלאת מסמכים. הבחירות ברשימת ההכנה נשארות בדפדפן ואינן נשלחות אלינו. בפיילוט מגדירים מראש את גבולות השימוש והפרטיות.',
  },
];
---

<BaseLayout
  title="כלי הכנה לפגישת ייעוץ למשרדי עורכי דין | רישוי"
  description="כלי הכנה לפגישת ייעוץ תחת מותג משרד עורכי הדין: רשימת מסמכים להדפסה, מיתוג והטמעה. התנסו בהדגמה וקבלו פרטי רכישה בדוא״ל, ללא שיחת מכירה."
  schema={serviceSchema}
>
  <Header />
  <main id="main-content">
    <section class="relative overflow-hidden border-b border-neutral-border bg-linear-to-b from-brand-pale to-white">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-blue-100/70 blur-3xl"></div>
        <div class="absolute -bottom-28 -right-20 h-80 w-80 rounded-full bg-cyan-100/60 blur-3xl"></div>
      </div>

      <div class="relative max-w-6xl mx-auto px-4 pt-8 pb-16 md:pt-12 md:pb-24">
        <Breadcrumb items={[{ label: 'רישוי למשרדי עורכי דין' }]} />

        <div class="max-w-4xl mx-auto text-center pt-6">
          <span class="inline-flex items-center rounded-full border border-brand-light bg-white px-4 py-2 text-sm font-semibold text-brand-dark shadow-xs">
            למשרדי עורכי דין · פנייה לרכישה בדוא״ל, ללא שיחת מכירה
          </span>
          <h1 class="mt-6 text-4xl md:text-6xl font-bold leading-tight text-gray-950">
            כלי הכנה לפגישת ייעוץ — תחת המותג של המשרד שלכם
          </h1>
          <p class="mt-6 max-w-3xl mx-auto text-lg md:text-xl leading-relaxed text-gray-700">
            אפשרו לפונים לבחור נושא, לרכז מסמכים ולהדפיס רשימת הכנה לשיחה.
            מתחילים בכלי אחד לאתר המשרד, עם התאמת מיתוג, תוכן באישורכם והיקף הטמעה מוגדר.
          </p>
          <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/partners/demo/"
              rel="nofollow"
              data-growth-event="partner_demo_open"
              data-growth-placement="partners_hero"
              class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center rounded-xl bg-brand-dark px-7 py-3 font-bold text-white shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
            >
              התנסות בהדגמה חיה
            </a>
            <a
              href={PARTNER_CONTACT_HREF}
              data-growth-event="partner_contact_intent"
              data-growth-placement="partners_hero"
              class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center rounded-xl border border-neutral-border bg-white px-7 py-3 font-bold text-brand-dark transition-colors duration-200 hover:border-brand hover:bg-brand-pale focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
            >
              פנייה לרכישה בדוא״ל — ללא שיחה
            </a>
          </div>
          <p class="mt-4 text-sm text-gray-600">הדגמה ללא הרשמה · בלי שיחת מכירה · הדוא״ל נפתח כטיוטה בלבד, ללא שליחה או חיוב אוטומטיים</p>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <p class="text-sm font-bold uppercase tracking-wider text-brand">הערך למשרד</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-950">מה אפשר להתאים לכלי באתר המשרד?</h2>
        <p class="mt-4 text-gray-700 leading-relaxed">
          רשימת הכנה, מיתוג וקישור המשך למשרד — בתכולה שתוגדר מראש בהצעה ובהסכם הרישוי.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {benefits.map((benefit) => (
          <article class="rounded-2xl border border-neutral-border bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-brand-light hover:shadow-md">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-pale text-brand-dark" aria-hidden="true">
              {benefit.icon === 'brand' && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 3l7 4v5c0 4.6-2.8 7.7-7 9-4.2-1.3-7-4.4-7-9V7l7-4z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              )}
              {benefit.icon === 'flow' && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="4" width="7" height="5" rx="1"></rect>
                  <rect x="14" y="15" width="7" height="5" rx="1"></rect>
                  <path d="M10 6.5h4a3 3 0 013 3V15M7 9v7a2 2 0 002 2h5"></path>
                </svg>
              )}
              {benefit.icon === 'tools' && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M14.5 6.5a4 4 0 01-5 5L4 17l3 3 5.5-5.5a4 4 0 005-5l-2.5 2.5-3-3L14.5 6.5z"></path>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold text-gray-950">{benefit.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-700">{benefit.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 pb-16 md:pb-20" aria-labelledby="pilot-scope-heading">
      <div class="rounded-2xl border border-brand-light bg-brand-pale p-6 md:p-9">
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h2 id="pilot-scope-heading" class="text-2xl font-bold text-gray-950">פיילוט אחד, עם תכולה ברורה</h2>
            <p class="mt-4 leading-relaxed text-gray-700">בפנייה הראשונה בודקים את אתר המשרד ואת מטרת הכלי. ההצעה לפיילוט מפרטת:</p>
            <ul class="mt-5 list-disc space-y-3 ps-5 text-sm leading-relaxed text-gray-700">
              <li>נושאי ההכנה ורשימת המסמכים שהמשרד יבדוק ויאשר.</li>
              <li>התאמת לוגו, צבעים וניסוחים, ורשימה שאפשר להדפיס.</li>
              <li>מיקום ההטמעה וקישור המשך ליצירת קשר עם המשרד.</li>
              <li>בדיקות תצוגה במובייל, נגישות ותפעול; אחריות התחזוקה ותנאי הרישוי.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-neutral-border bg-white p-6">
            <h3 class="text-xl font-bold text-gray-950">למי כדאי לבדוק התאמה?</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-700">למשרד בתחום הוצאה לפועל או חדלות פירעון, עם אתר פעיל ואיש צוות שיכול לאשר את התוכן ולתת משוב על ההכנה לפגישות.</p>
            <p class="mt-4 text-sm leading-relaxed text-gray-700">אפשר לבחון כיוון נוסף בהמשך. בפיילוט מגדירים כלי אחד, תכולה ודרך לבחון אם הוא מועיל למשרד; אין התחייבות לכמות פניות או לתוצאה משפטית.</p>
            <a href="/partners/demo/" rel="nofollow" data-growth-event="partner_demo_open" data-growth-placement="partners_offer" class="mt-5 inline-flex min-h-11 items-center font-bold text-brand-dark underline underline-offset-4 focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark">ראו את רשימת ההכנה בהדגמה ←</a>
          </div>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="border-y border-neutral-border bg-gray-50 scroll-mt-24">
      <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-brand">פיילוט ממוקד</p>
            <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-950">מתחילים קטן, מודדים, ורק אז מרחיבים</h2>
            <p class="mt-5 leading-relaxed text-gray-700">
              לפני ההתחלה מקבלים בדוא״ל תכולה, מחיר, לוח זמנים ותנאי רישוי. אין חובה לתאם שיחת מכירה. מסכימים בכתב מה בודקים: האם רשימת ההכנה מובנת והאם הכלי משתלב באתר המשרד.
            </p>
          </div>

          <ol class="space-y-4">
            {[
              ['1', 'פרטי רכישה בדוא״ל', 'שולחים קישור לאתר המשרד ומקבלים תכולה, עלות, תנאים ולוח זמנים בכתב — ללא שיחת מכירה.'],
              ['2', 'התאמה ואישור תוכן', 'מתאימים את המיתוג ורשימת ההכנה. המשרד בודק ומאשר את התוכן המקצועי וקישור ההמשך.'],
              ['3', 'הטמעה ובדיקה', 'בודקים את הכלי בסביבת המשרד, כולל מובייל, נגישות והדפסה, לפני העלאה לקהל.'],
              ['4', 'משוב והחלטה', 'בוחנים שימושיות ומשוב מהצוות ומחליטים על המשך בהתאם לתנאים שסוכמו.'],
            ].map(([number, title, text]) => (
              <li class="flex gap-4 rounded-2xl border border-neutral-border bg-white p-5">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-dark font-bold text-white" aria-hidden="true">{number}</span>
                <div>
                  <h3 class="font-bold text-gray-950">{title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-gray-700">{text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 py-16 md:py-20">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <p class="text-sm font-bold uppercase tracking-wider text-brand">שקיפות מסחרית</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-950">מודל רישוי, לא מודל מכירת לידים</h2>
        <p class="mt-4 leading-relaxed text-gray-700">
          התשלום הוא עבור התאמה, רישוי ותחזוקת הכלים. פרטי גולשים אינם מוצר ואינם נמכרים לצדדים שלישיים.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-neutral-border p-6 text-center">
          <p class="text-sm text-gray-600">שלב ראשון</p>
          <p class="mt-2 text-xl font-bold text-gray-950">דמי הקמה</p>
          <p class="mt-2 text-sm text-gray-700">לפי עומק ההתאמה וההטמעה</p>
        </div>
        <div class="rounded-2xl border border-brand-light bg-brand-pale p-6 text-center">
          <p class="text-sm text-gray-600">לאחר ההשקה</p>
          <p class="mt-2 text-xl font-bold text-gray-950">רישוי חודשי</p>
          <p class="mt-2 text-sm text-gray-700">לפי מספר הכלים ורמת התחזוקה</p>
        </div>
        <div class="rounded-2xl border border-neutral-border p-6 text-center">
          <p class="text-sm text-gray-600">העיקרון</p>
          <p class="mt-2 text-xl font-bold text-gray-950">ללא תשלום לליד</p>
          <p class="mt-2 text-sm text-gray-700">ללא מכירת פרטי גולשים</p>
        </div>
      </div>
    </section>

    <section class="border-y border-neutral-border bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 py-16 md:py-20">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-950">שאלות נפוצות</h2>
        </div>
        <div class="space-y-3">
          {faq.map((item) => (
            <details class="group rounded-xl border border-neutral-border bg-white p-5">
              <summary class="cursor-pointer list-none font-bold text-gray-950 focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-dark">
                <span class="flex items-center justify-between gap-4">
                  {item.q}
                  <svg viewBox="0 0 20 20" class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M5 7.5l5 5 5-5"></path>
                  </svg>
                </span>
              </summary>
              <p class="mt-4 border-t border-neutral-border pt-4 text-sm leading-relaxed text-gray-700">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="partner-contact" class="max-w-5xl mx-auto px-4 py-16 scroll-mt-24 md:py-24">
      <div class="overflow-hidden rounded-3xl bg-brand-dark px-6 py-12 text-center text-white shadow-xl md:px-12 md:py-16">
        <h2 class="text-3xl md:text-4xl font-bold">מעוניינים לרכוש? מתחילים בדוא״ל</h2>
        <p class="mx-auto mt-4 max-w-2xl text-blue-100 leading-relaxed">
          מספיק להתחיל בקישור לאתר המשרד, תחום העיסוק וההכנה שהייתם רוצים להציע לפונים.
          פרטי התכולה, המחיר ואופן האספקה יימסרו בכתב, ללא צורך בשיחת מכירה.
        </p>
        <PartnerContact placement="partners_contact" tone="dark" />
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 pb-8 text-center text-xs leading-relaxed text-gray-600">
      <p>
        הכלים מספקים מידע כללי בלבד ואינם מחליפים ייעוץ משפטי. כל התקשרות מסחרית תהיה כפופה להסכם רישוי נפרד ולבדיקה משפטית של הצדדים.
      </p>
      <p class="mt-2">
        למידע נוסף ראו <a href="/legal/terms/" class="underline hover:text-brand-dark">תנאי שימוש</a> ו<a href="/legal/privacy/" class="underline hover:text-brand-dark">מדיניות פרטיות</a>.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
