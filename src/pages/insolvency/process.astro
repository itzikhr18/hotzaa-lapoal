---
import GuideLayout from '../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "האם ההליך מסתיים שלוש שנים אחרי ההגשה?",
    "a": "לא. ברירת המחדל היא שלוש שנות תשלומים מצו השיקום הכלכלי. לפניו יש הגשה ותקופת ביניים, והתקופה יכולה להשתנות לפי הדין והצו."
  },
  {
    "q": "מי קובע את גובה התשלום?",
    "a": "הסכום נקבע במסגרת החלטות הגורם המוסמך לפי החוק, הנתונים והשלב בהליך. אין אחוז אחיד או סכום מובטח לפי משכורת בלבד."
  },
  {
    "q": "מה קורה אם ההכנסה ירדה?",
    "a": "יש לדווח ולהגיש בקשה מתאימה לשינוי לפי ההנחיות, עם אסמכתאות. עד להחלטה אין להניח שהתשלום שנקבע בוטל או הופחת."
  }
];
const sources = [
  {
    "label": "רשות האכיפה — הכנת בקשה והיעדר עיכוב אוטומטי",
    "href": "https://www.gov.il/BlobFolder/policy/opening-insolvency-request-regulation/he/Forms_insolvency-guide.pdf"
  },
  {
    "label": "הממונה — שלבי ההליך",
    "href": "https://www.gov.il/he/pages/insolvency_iaw?chapterIndex=5"
  },
  {
    "label": "הממונה — תקופת התשלומים ושינויה",
    "href": "https://www.gov.il/BlobFolder/policy/installments-111125/ar/061125.pdf"
  },
  {
    "label": "חוק חדלות פירעון — צו שיקום והפטר",
    "href": "https://fs.knesset.gov.il/20/law/20_lsr_491934.pdf"
  }
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
