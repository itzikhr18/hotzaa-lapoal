---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = 'חדלות פירעון ליחיד: תנאי הגשה, שלבים, עלויות והפטר';
const description = 'מרכז מידע על חדלות פירעון בישראל: למי מגישים, מתי נעצרים הליכים, כמה זמן נמשכת תקופת התשלומים ומה כולל הפטר. מדריכים ומקורות רשמיים.';
const pageUrl = 'https://hotzaa-lapoal.info/insolvency/';
const guides = [
  { title: 'מהי חדלות פירעון?', description: 'המצב הכלכלי, ההליך המשפטי והשלכותיו', href: '/insolvency/what-is/' },
  { title: 'תנאי הגשה ומסלולים', description: 'סכומי סף, זיקה לישראל והגורם המטפל', href: '/insolvency/eligibility/' },
  { title: 'שלבי ההליך', description: 'הגשה, צו פתיחה, צו שיקום ותקופת תשלומים', href: '/insolvency/process/' },
  { title: 'אגרות ועלויות', description: 'מה לבדוק לגבי הגשה, סיוע משפטי וייצוג', href: '/insolvency/costs/' },
  { title: 'הפטר: מה נכלל ומה לא?', description: 'חובות עבר, חריגים ובדיקות לאחר ההפטר', href: '/insolvency/haftar/' },
];
const faqs = [
  { q: 'האם הגשת הבקשה עוצרת עיקולים?', a: 'לא אוטומטית. לפני צו מתאים יש לבדוק בקשה לעיכוב הליכים והחלטה בה. אישור שהבקשה התקבלה אינו צו עיכוב.' },
  { q: 'האם ההליך נמשך שלוש שנים?', a: 'ברירת המחדל היא שלוש שנות תשלומים מצו השיקום הכלכלי, לא מההגשה או מצו הפתיחה. התקופה עשויה להשתנות לפי החוק וההחלטות.' },
  { q: 'האם ההפטר מבטל את כל החובות?', a: 'לא. ההפטר חל על חובות עבר בכפוף לחריגים בחוק ולהחלטות בתיק; הוא אינו מבטיח מחיקת כל חיוב או רישום.' },
];
const pageSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: pageUrl, inLanguage: 'he',
  dateModified: '2026-09-13',
  hasPart: guides.map(item => ({ '@type': 'WebPage', name: item.title, url: 'https://hotzaa-lapoal.info' + item.href })),
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---
<BaseLayout title={title} description={description} canonicalUrl={pageUrl} schema={[pageSchema, faqSchema]}>
  <Header />
  <main id="main-content" class="max-w-4xl mx-auto px-4 py-10">
    <Breadcrumb items={[{ label: 'חדלות פירעון' }]} />
    <h1 class="text-3xl font-bold text-brand-dark mb-4">חדלות פירעון בישראל — מדריכים ליחידים</h1>
    <p class="text-lg text-gray-600 mb-6">חדלות פירעון ושיקום כלכלי היא מסגרת לטיפול בחובות ובנכסים, שעשויה להסתיים בהפטר. כאן מתחילים להבין את התנאים וההשלכות — בלי הבטחה להתאמה, למחיקת חובות או לתוצאה מסוימת.</p>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
      <h2 class="font-bold mb-2">לפני שמגישים בקשה</h2>
      <p>הגשת בקשה אינה מעכבת הליכים אוטומטית. אם קיימת אזהרה, עיקול או מועד מימוש — יש לבדוק את המועד ואת ההחלטה הרלוונטית, ולא להניח שההליך נעצר. <a href="https://www.gov.il/BlobFolder/policy/opening-insolvency-request-regulation/he/Forms_insolvency-guide.pdf" target="_blank" rel="noopener noreferrer" class="underline">ההנחיה במדריך הרשמי</a>.</p>
    </div>
    <section aria-label="מדריכי חדלות פירעון" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
      {guides.map(item => (
        <a href={item.href} class="border border-neutral-border rounded-xl p-5 hover:border-brand hover:bg-brand-pale">
          <h2 class="text-lg font-bold text-brand-dark mb-2">{item.title}</h2>
          <p class="text-sm text-gray-600">{item.description}</p>
        </a>
      ))}
    </section>
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-3">מה כדאי לברר תחילה?</h2>
      <ul class="list-disc list-inside space-y-3">
        <li>מהם החובות, סוגיהם וההליכים שכבר מתנהלים — לא רק הסכום הכולל.</li>
        <li>לאיזה גורם מגישים: רשות האכיפה והגבייה או הממונה, לפי התנאים והסכום. לתאגידים מסלול אחר.</li>
        <li>אילו נכסים, זכויות, מגבלות וחובות דיווח עשויים להיות מושפעים.</li>
        <li>מהן החלופות: <a href="/guides/tzav-tashlumim/" class="underline">צו תשלומים</a>, <a href="/guides/ichud-tikim/" class="underline">איחוד תיקים</a> או <a href="/guides/hisdurim-chov/" class="underline">הסדר עם נושים</a>.</li>
      </ul>
      <p class="mt-4">לבדיקת תנאים עדכניים: <a href="https://www.gov.il/he/pages/insovlency-request-guide?chapterindex=4" target="_blank" rel="noopener noreferrer" class="underline">מדריך רשות האכיפה והגבייה</a>. חיפוש לפי המונח הישן? ראו <a href="/guides/pshitat-regel/" class="underline">פשיטת רגל והמעבר לחוק חדלות פירעון</a>.</p>
    </section>
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-3">כמה זמן עד הפטר?</h2>
      <p>ברירת המחדל היא שלוש שנות תשלומים מצו השיקום הכלכלי. המדריך הרשמי מתאר מסגרת כוללת של כארבע שנים מצו הפתיחה, אך אין בכך התחייבות למשך התיק. יש חריגים, קיצור, הארכה ותנאים נוספים. <a href="https://www.gov.il/BlobFolder/policy/installments-111125/ar/061125.pdf" target="_blank" rel="noopener noreferrer" class="underline">מדיניות הממונה על תקופת התשלומים</a>; <a href="https://www.gov.il/he/pages/insolvency_iaw?chapterIndex=5" target="_blank" rel="noopener noreferrer" class="underline">מדריך שלבי ההליך</a>.</p>
    </section>
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-4">שאלות נפוצות</h2>
      <div class="space-y-3">{faqs.map(faq => (
        <details class="border border-neutral-border rounded-xl"><summary class="p-4 font-semibold cursor-pointer">{faq.q}</summary><p class="px-4 pb-4 text-gray-600">{faq.a}</p></details>
      ))}</div>
    </section>
    <p class="text-sm text-gray-700 bg-blue-50 border border-blue-200 p-4 rounded-xl">מידע כללי לציבור בלבד. הדין והחלטות הגורמים המוסמכים גוברים. אין כאן קביעת זכאות או ייעוץ משפטי אישי. אפשר לבדוק <a href="https://www.gov.il/he/service/legal_aid_application" target="_blank" rel="noopener noreferrer" class="underline">זכאות לסיוע משפטי במשרד המשפטים</a>.</p>
  </main>
  <Footer />
</BaseLayout>
