const faqs = [
  {
    "q": "האם הפטר מוחק את כל החובות?",
    "a": "לא. ההפטר חל על חובות עבר בהתאם לחוק ולהחלטות. קיימים חריגים, ובהם תשלום עונשי, חובות מסוימים שנוצרו במרמה או בעבירה וחוב מזונות לפי פסק דין; קיימת גם סמכות חריגה במקרים המפורטים בחוק."
  },
  {
    "q": "האם חוב מזונות לעולם אינו מופטר?",
    "a": "ברירת המחדל היא שחוב מזונות לפי פסק דין אינו נכלל. סעיף 175(ב) מאפשר לבית המשפט לקבוע אחרת בנסיבות חריגות ובתנאים הקבועים בו. אין בכך הבטחה להחלת הפטר במקרה מסוים."
  },
  {
    "q": "האם נתוני האשראי מתאפסים ביום ההפטר?",
    "a": "לא ניתן להסיק זאת. הפטר ונתוני אשראי הם עניינים שונים. אפשר לעיין בנתונים האישיים ולבקש תיקון של טעות, אך אין כאן הבטחת מחיקה או אישור אשראי."
  }
];
const sources = [
