---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { officialSources, REFERENCE_EDITED } from '../../data/reference-content.mjs';

const schema = {
  '@context': 'https://schema.org', '@type': 'AboutPage',
  name: 'אודות הוצאהלפועל.info — עריכה, מקורות ותיקונים',
  url: 'https://hotzaa-lapoal.info/about/', dateModified: REFERENCE_EDITED,
  inLanguage: 'he',
  mainEntity: {
    '@type': 'Organization', '@id': 'https://hotzaa-lapoal.info/#organization',
    name: 'הוצאהלפועל.info', url: 'https://hotzaa-lapoal.info/',
    description: 'אתר מידע עצמאי בעברית על הוצאה לפועל וחדלות פירעון',
    areaServed: 'IL',
    contactPoint: { '@type': 'ContactPoint', contactType: 'editorial corrections', email: 'legal@hotzaa-lapoal.info', availableLanguage: 'Hebrew', url: 'https://hotzaa-lapoal.info/contact/' },
  },
};
---
<BaseLayout
  title="אודות הוצאהלפועל.info — מקורות, מדיניות עריכה ותיקונים"
  description="מי עומד מאחורי אתר המידע, כיצד נעזרים במקורות רשמיים ובבינה מלאכותית, מה נבדק ומה לא, ואיך מדווחים על טעות בתוכן."
  schema={schema}
>
  <Header />
  <main id="main-content" class="max-w-3xl mx-auto px-4 py-12">
    <Breadcrumb items={[{ label: 'אודות' }]} />
    <h1 class="text-3xl font-bold text-brand-dark mb-4">אודות הוצאהלפועל.info</h1>
    <p class="text-sm text-neutral-muted mb-8">נערך ב־13 בספטמבר 2026</p>
    <div class="rtl-prose space-y-8">
      <section>
        <h2>מטרת האתר ומי עורך אותו</h2>
        <p>הוצאהלפועל.info הוא אתר מידע עצמאי וחינמי בעברית. מטרתו לעזור להבין מושגים, לזהות נושאים לבירור ולמצוא טפסים ושירותים רשמיים. האתר אינו חלק מרשות האכיפה והגבייה, אינו משרד עורכי דין ואינו מגיש בקשות בשם המשתמשים.</p>
        <p>התוכן מתפרסם בשם <strong>מערכת הוצאהלפועל.info</strong>. זהו שם מערכתי, לא שם של עורך דין או אישור למומחיות משפטית. בעריכה ובבדיקות נעשה גם שימוש בכלי בינה מלאכותית. כלים אלה עשויים לטעות; עצם השימוש בהם או הוספת מקור אינם תחליף לביקורת משפטית מקצועית.</p>
      </section>
      <section id="editorial-policy" class="scroll-mt-24">
        <h2>מדיניות עריכה ומקורות</h2>
        <ol>
          <li><strong>מקור ראשוני קודם:</strong> חקיקה ופרסומי הכנסת, שירותי gov.il, פרסומי הביטוח הלאומי ובנק ישראל. כאשר מקשרים לחוק מאוחד, יש לבדוק גם תיקונים מאוחרים, תחילה והוראות מעבר.</li>
          <li><strong>מקור סמוך לטענה:</strong> בתוכן שנערך בבדיקה זו נוספו הפניות ממוקדות ליד ההסבר או ברשימת המקורות. קישור כללי לאתר ממשלתי אינו אישור לכל משפט בעמוד.</li>
          <li><strong>תנאים וחריגים:</strong> מציינים הבדלים בין סוגי חוב, שלבי הליך ומועדים. לא מסיקים זכאות, עיכוב הליכים או סכום סופי מנתון בודד.</li>
          <li><strong>אי־ודאות גלויה:</strong> כשאין ביסוס מספק, מסירים מספר או הבטחה ומפנים לבירור רשמי. אין להסתמך על תקציר בלי לקרוא את התנאים במקור.</li>
          <li><strong>תאריך עריכה אינו תאריך בדיקה מקצועית:</strong> תאריך משתנה כאשר תוכן העמוד נערך. הוא אינו מבטיח שכל הדין עדכני לאותו יום או שעורך דין בדק את העמוד.</li>
        </ol>
        <p>כל־זכות ומאגרים מסחריים כגון נבו הם מקורות עזר משניים, לא אתרי ממשלה. כאשר משתמשים בהם, יש להבחין בינם לבין חקיקה ופרסומים רשמיים.</p>
        <ul>
          {[officialSources.execution, officialSources.wage, officialSources.benefits, officialSources.insolvency, officialSources.credit].map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}
        </ul>
      </section>
      <section>
        <h2>מה נבדק ומה עדיין דורש זהירות</h2>
        <p>בספטמבר 2026 בוצעה בדיקת תוכן פנימית מול מקורות רשמיים, עם דגש על מועדי תגובה, עיקולים וכספים מוגנים, חדלות פירעון, טפסים, שאלות נפוצות ומונחים. תוקנו טענות גורפות והוסרו אומדנים שלא נמצא להם ביסוס מספיק.</p>
        <p><strong>לא הושלמה בדיקה משפטית חיצונית לכל האתר.</strong> אין לראות באף עמוד אישור משפטי לתיק אישי. שם בודק מקצועי ותאריך בדיקתו יוצגו רק אם התקבלה בפועל בדיקה מזוהה של אותו תוכן. תיקונים מאוחרים לבדיקה כזאת יסומנו בנפרד.</p>
        <p>הבדיקה אינה אישור לנכונות כל תשובה עתידית של צ׳אטבוט. שאלוני ההכוונה, המחשבון ונוסחי העזר אינם קובעים זכאות ואינם מחליפים החלטה או מסמך רשמי.</p>
      </section>
      <section>
        <h2>עדכונים ותיקון טעויות</h2>
        <p>מקורות רשמיים עשויים להשתנות, והאתר אינו מתחייב לעדכון אוטומטי או מיידי אחרי כל שינוי. לפני הגשת בקשה, תשלום או פעולה שיש לה מועד, בדקו את המקור הרשמי ואת ההחלטות בתיק.</p>
        <p>מצאתם טעות? שלחו את כתובת העמוד, המשפט הבעייתי וקישור למקור הרשמי אל <a href="mailto:legal@hotzaa-lapoal.info">legal@hotzaa-lapoal.info</a>. אין לשלוח תעודת זהות, מספר תיק, מסמכים אישיים או מידע כספי. אפשר להתחיל גם ב<a href="/contact/">דף יצירת הקשר</a>.</p>
      </section>
      <section id="reviewer">
        <h2>מחפשים עורך או עורכת דין לבדיקה מקצועית</h2>
        <p>
          אנחנו מחפשים עורך או עורכת דין שעוסקים בהוצאה לפועל ובחדלות פירעון, רצוי בייצוג חייבים,
          שיבדקו את חמשת המדריכים המרכזיים באתר ויעירו על אי-דיוקים:
        </p>
        <ul>
          <li><a href="/guides/bitul-ikul/">ביטול עיקול</a></li>
          <li><a href="/guides/ikul-maskoret/">עיקול משכורת</a></li>
          <li><a href="/guides/bdika-tik/">בדיקת תיק הוצאה לפועל</a></li>
          <li><a href="/guides/tzav-tashlumim/">צו תשלומים</a></li>
          <li><a href="/guides/ichud-tikim/">איחוד תיקים</a></li>
        </ul>
        <div class="bg-white border border-neutral-border rounded-xl p-5 not-prose">
          <p class="font-semibold text-gray-800 text-sm mb-2">איך זה עובד</p>
          <ul class="text-sm text-gray-700 space-y-1.5">
            <li><strong>היקף:</strong> קריאה והערות על חמשת המדריכים, ובדיקה חוזרת פעם ברבעון.</li>
            <li><strong>קרדיט:</strong> על כל מדריך שנבדק יופיעו שם, תפקיד ותאריך הבדיקה, ואם תרצו גם קישור לאתר שלכם. הנוסח מתפרסם רק באישורכם, ויוסר בכל עת לפי בקשתכם.</li>
            <li><strong>מה הקרדיט מכסה:</strong> רק את טקסט המדריך שנבדק, לא את הכלים, הצ'אטבוט או פרסומות באתר. שינוי במדריך אחרי הבדיקה יסומן ככזה עד שתאשרו אותו.</li>
            <li><strong>בלי הפניות:</strong> ההסדר לא כולל הפניית לקוחות או תשלום עבור הפניות.</li>
            <li><strong>תנאים:</strong> את תנאי ההתקשרות, כולל תשלום אם רלוונטי, נסכם יחד.</li>
            <li><strong>אתיקה:</strong> כדאי לוודא שהקרדיט מתאים לכללי לשכת עורכי הדין בנושא פרסומת. נתאים את הנוסח לפי הצורך.</li>
          </ul>
          <p class="text-sm text-gray-800 mt-4">
            מעוניינים? כתבו ל־<a href="mailto:legal@hotzaa-lapoal.info?subject=%D7%91%D7%93%D7%99%D7%A7%D7%94%20%D7%9E%D7%A7%D7%A6%D7%95%D7%A2%D7%99%D7%AA" class="text-brand-dark font-semibold underline">legal@hotzaa-lapoal.info</a> עם תחום העיסוק והאזור שלכם, ונחזור אליכם.
          </p>
        </div>
      </section>
      <section>
        <h2>פרטיות, חינם ונגישות</h2>
        <p>המידע והכלים באתר מוצעים ללא תשלום. הפניות לשירותים רשמיים אינן בקשה להעביר אלינו פרטים אישיים. מידע על מדידה, הסכמה ושימוש בנתונים מופיע ב<a href="/legal/privacy/">מדיניות הפרטיות</a>.</p>
        <p>אנו פועלים לשיפור הנגישות והשימוש במובייל. אין בכך הצהרה שבוצעה בדיקת עמידה מלאה בכל תקן. ראו את <a href="/legal/accessibility/">הצהרת הנגישות</a>; לפנייה בנושא: <a href="mailto:accessibility@hotzaa-lapoal.info">accessibility@hotzaa-lapoal.info</a>.</p>
      </section>
      <section>
        <h2>כשצריך עזרה אישית</h2>
        <p>מידע כללי אינו ייעוץ משפטי. כאשר יש מועד קרוב, מחלוקת, חשש למימוש נכס או אי־בהירות בזכויות, פנו לעורך דין או בדקו <a href={officialSources.aid.url} target="_blank" rel="noopener noreferrer">בקשה לסיוע משפטי במשרד המשפטים</a>. קבלת הסיוע כפופה לתנאי השירות ולבדיקת הבקשה.</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
