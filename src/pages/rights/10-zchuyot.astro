---
import GuideLayout from '../../layouts/GuideLayout.astro';

const LAW = 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf';
const WAGE_LAW = 'https://www.btl.gov.il/Laws1/00_0106_000000.pdf';
const NII_LAW = 'https://www.btl.gov.il/Laws1/00_0001_000000.pdf';
const PERSONAL = 'https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page';
const DEBTORS_GUIDE = 'https://www.gov.il/he/pages/execution_debtors_guide';
const PAID = 'https://www.gov.il/he/service/debt_repayment_argument';
const RESTRICTIONS = 'https://www.gov.il/he/service/request_for_cancellation_of_restrictions';
const LEGAL_AID = 'https://www.gov.il/he/service/legal_aid_application';

const faqs = [
  {
    q: 'מה הזכויות של חייב בהוצאה לפועל?',
    a: 'בין העיקריות: לראות את התיק ואת פירוט החוב, לקבל אזהרה לפני הליכי גבייה, להתנגד לחוב או לטעון שהוא שולם, לבקש לשלם לפי היכולת בצו תשלומים, הגנה על חלק מהמשכורת ועל קצבאות ביטוח לאומי, הגנה על ציוד בסיסי בבית, תנאים לפני מכירת דירת מגורים, איחוד תיקים, ביטול הגבלות כשעומדים בתשלומים, ערעור על החלטות וסיוע משפטי למי שעומד בתנאים.',
    source: LAW,
  },
  {
    q: 'כמה מהמשכורת מותר לעקל?',
    a: 'בחוב שאינו מזונות, מוגן הנמוך מבין סכום בסיס לפי הרכב המשפחה (למשל 2,596 ₪ ליחיד ב־2026) לבין 80% מהשכר נטו. כלומר, מעקלים לכל היותר את מה שמעל הסכום המוגן. אחרי שהשכר הופקד בבנק, ההגנה נמשכת חודש ימים מיום התשלום.',
    source: WAGE_LAW,
  },
  {
    q: 'מותר לעקל קצבת ביטוח לאומי?',
    a: 'לפי סעיף 303 לחוק הביטוח הלאומי, הזכות לגמלת כסף אינה ניתנת לעיקול, למעט לתשלום מזונות לפי פסק דין. אחרי שהגמלה הופקדה בבנק, ההגנה נמשכת 30 ימים מיום התשלום, והבנק רשאי לנכות ממנה מקדמה שנתן על חשבונה.',
    source: NII_LAW,
  },
  {
    q: 'יכולים לקחת לי את הטלפון או המחשב?',
    a: 'לפי סעיף 22 לחוק ההוצאה לפועל, טלפונים ניידים ומחשבים אישיים בשימוש החייב ובני משפחתו הגרים איתו הם חלק מהמיטלטלין שאין מעקלים, לצד מזון, ריהוט, בגדים, מיטות, ציוד רפואי, כלי מטבח וכלי בית וכלי עבודה שהם מקור הפרנסה (עד תקרת שווי). החריג: פריטים שמשמשים לעסק שהחייב מנהל.',
    source: LAW,
  },
  {
    q: 'מותר למכור את הדירה היחידה שלי?',
    a: 'דירה יחידה אינה פטורה אוטומטית. לפי סעיף 38 לחוק, לפני מכירה ופינוי של דירה שמשמשת למגורים צריך להוכיח אחת משלוש: שלחייב ולמשפחתו יהיה מקום מגורים סביר, או שיש להם יכולת כלכלית לממן מקום מגורים סביר, או שהועמד להם סידור חלוף. במשכנתה יש הסדר מיוחד.',
    source: LAW,
  },
  {
    q: 'מגיע לי עורך דין בחינם?',
    a: 'לא אוטומטית. חובות בהוצאה לפועל נמצאים ברשימת הנושאים של הסיוע המשפטי במשרד המשפטים, אבל הזכאות מותנית במבחן הכנסה ונכסים ובבדיקת סיכויי התיק, ויש תשלום לפתיחת תיק. פונים באופן מקוון או במוקד ‎*6405.',
    source: LEGAL_AID,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'חוק ההוצאה לפועל (סעיפים 7, 7א, 7א1, 19, 22, 38, 66א–66ד, 74ג–74ט, 80, 81א, 81א1)', href: LAW },
  { label: 'חוק הגנת השכר — סעיף 8', href: WAGE_LAW },
  { label: 'חוק הביטוח הלאומי — סעיף 303', href: NII_LAW },
  { label: 'רשות האכיפה והגבייה — מידע לחייבים בתיקי הוצאה לפועל', href: DEBTORS_GUIDE },
  { label: 'רשות האכיפה והגבייה — טענת פרעתי', href: PAID },
  { label: 'רשות האכיפה והגבייה — בקשה לביטול הגבלות', href: RESTRICTIONS },
  { label: 'משרד המשפטים — בקשה לסיוע משפטי', href: LEGAL_AID },
];

const relatedGuides = [
  { title: 'כספים ונכסים מוגנים מעיקול', href: '/rights/skhomim-mugganim/' },
  { title: 'בקשה לצו תשלומים', href: '/guides/tzav-tashlumim/' },
  { title: 'התנגדות לתיק (טופס 218)', href: '/guides/hitnagdut-letik/' },
  { title: 'איך מבטלים עיקול', href: '/guides/bitul-ikul/' },
  { title: 'הגבלות על חייב', href: '/rights/hagbalot/' },
  { title: 'הגנת דירת מגורים', href: '/rights/bayit-muggan/' },
];

const rightsTable = [
  { right: 'לראות את התיק ואת פירוט החוב', how: 'אזור אישי — הוצאה לפועל', href: '/guides/bdika-tik/' },
  { right: 'אזהרה לפני הליכי גבייה', how: 'נבדק באזהרה ובתיק', href: '/guides/michtav-hotzaa/' },
  { right: 'להתנגד לחוב או לטעון שהוא שולם', how: 'טופס 218 / טופס 236', href: '/guides/hitnagdut-letik/' },
  { right: 'לשלם לפי היכולת', how: 'צו תשלומים — טופס 233', href: '/guides/tzav-tashlumim/' },
  { right: 'הגנה על חלק מהמשכורת', how: 'בקשה לביטול או צמצום עיקול', href: '/guides/ikul-maskoret/' },
  { right: 'הגנה על קצבאות', how: 'בקשה לביטול עיקול עו"ש', href: '/rights/skhomim-mugganim/' },
  { right: 'ציוד בסיסי שאסור לעקל', how: 'סעיף 22 לחוק', href: '/rights/skhomim-mugganim/' },
  { right: 'תנאים לפני מכירת דירת מגורים', how: 'סעיף 38 לחוק', href: '/rights/bayit-muggan/' },
  { right: 'תשלום אחד לרוב התיקים', how: 'איחוד תיקים — טופס 7', href: '/guides/ichud-tikim/' },
  { right: 'ביטול הגבלות כשעומדים בתשלומים', how: 'בקשה לביטול הגבלות', href: '/rights/hagbalot/' },
  { right: 'ערעור על החלטת רשם', how: 'בית משפט השלום (בענייני משפחה — בית המשפט לענייני משפחה)', href: '/guides/irur-hotzaa/' },
  { right: 'סיוע משפטי', how: 'משרד המשפטים, ‎*6405', href: LEGAL_AID },
];
---

<GuideLayout
  title="זכויות חייב בהוצאה לפועל: 12 זכויות שכדאי להכיר"
  description="מה מגיע לכם כשנפתח נגדכם תיק: אזהרה, התנגדות, צו תשלומים, הגנה על משכורת וקצבאות, ציוד שאסור לעקל, דירת מגורים, איחוד תיקים, ערעור וסיוע משפטי."
  breadcrumb={[{ label: 'זכויות חייב', href: '/rights/' }, { label: 'זכויות חייב בהוצאה לפועל', href: '/rights/10-zchuyot/' }]}
  publishDate="2026-03-24"
  updateDate="2026-10-08"
  readTime="9 דקות"
  sources={sources}
  relatedGuides={relatedGuides}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> חוב לא מבטל את הזכויות שלכם. החוק מגן על חלק מהמשכורת ועל קצבאות, אוסר לעקל ציוד בסיסי בבית, נותן זמן לפני הליכי גבייה, ומאפשר להתנגד לחוב, לשלם לפי היכולת ולערער על החלטות.</p>
    <p class="mb-0">אבל רוב הזכויות לא "מופעלות מעצמן". צריך לבקש אותן, בזמן ובמסלול הנכון. לכל זכות כאן יש קישור למדריך שמסביר איך.</p>
  </div>

  <p>לפי הדוח השנתי של רשות האכיפה והגבייה, ל־73.8% מהחייבים הפרטיים אין עורך דין באף אחד מהתיקים שלהם (<a href="/nitunim/#representation">הנתונים</a>). כלומר, רוב האנשים מתמודדים לבד, ולא תמיד יודעים מה מגיע להם. ריכזנו כאן את 12 הזכויות החשובות ביותר, מה כל אחת נותנת, ומה הגבולות שלה.</p>

  <h2 id="table" class="scroll-mt-24">הזכויות במבט אחד</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">הזכות</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">איך מממשים</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מדריך</th>
        </tr>
      </thead>
      <tbody>
        {rightsTable.map((r, i) => (
          <tr class={i % 2 ? 'bg-gray-50' : 'bg-white'}>
            <td class="border border-gray-300 px-4 py-2 font-semibold">{i + 1}. {r.right}</td>
            <td class="border border-gray-300 px-4 py-2">{r.how}</td>
            <td class="border border-gray-300 px-4 py-2"><a class="text-brand underline" href={r.href}>לפרטים</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="information" class="scroll-mt-24">1. הזכות לראות את התיק ואת פירוט החוב</h2>
  <p>אתם יכולים לראות, בחינם, את כל התיקים הפתוחים נגדכם: מי הזוכה, מה מקור החוב, מה ההחלטות ומה היתרה. ב<a href={PERSONAL}>אזור האישי של ההוצאה לפועל</a> נכנסים עם הזדהות לאומית, בלי צורך במספר תיק, ומורידים דף חשבון שמפרט קרן, ריבית, הוצאות ותשלומים. שימו לב: לפי <a href="https://www.gov.il/he/service/lawyer-request-for-report-of-debt-files">רשות האכיפה</a>, עם הפקת רשימת תיקים מתעדכנת מסירת אזהרה בתיקים שבהם עוד לא נמסרה. <a href="/guides/bdika-tik/">בדיקת תיק — המדריך המלא</a>.</p>

  <h2 id="warning" class="scroll-mt-24">2. הזכות לאזהרה לפני הליכי גבייה</h2>
  <p>ככלל, לפני שמעקלים או מגבילים, צריך למסור לכם אזהרה, ולתת לכם זמן לפעול. לפי מדריך הרשות לחייבים, תקופת האזהרה היא 30 ימים בתיקי שטרות ובתביעה על סכום קצוב, ו־20 ימים בשאר התיקים. סעיף 7 לחוק ההוצאה לפועל מאפשר חריגים, ולכן לא כל הליך שננקט לפני האזהרה בטל. התאריך המחייב הוא זה שבאזהרה שלכם. <a href="/guides/michtav-hotzaa/">קיבלתי מכתב מהוצאה לפועל — מה עושים</a>.</p>

  <h2 id="dispute" class="scroll-mt-24">3. הזכות להתנגד לחוב או לטעון שהוא שולם</h2>
  <p>אם החוב לא נכון, יש מסלולים להגיד את זה:</p>
  <ul>
    <li><strong>התנגדות:</strong> בתיק על צ'ק, שטר או תביעה על סכום קצוב — בתוך 30 ימים מהאזהרה, בטופס 218 עם תצהיר. התנגדות במועד עוצרת את הגבייה ומעבירה את המחלוקת לבית המשפט (סעיפים 81א ו־81א1). <a href="/guides/hitnagdut-letik/">התנגדות לתיק</a>.</li>
    <li><strong>"פרעתי":</strong> כשהחוב כבר שולם, כולו או חלקו — <a href={PAID}>טופס 236, קוד 119</a>, עם אסמכתאות.</li>
    <li><strong>התיישנות:</strong> בחוב ישן ייתכן שאפשר להעלות טענת התיישנות. <a href="/guides/hitiyashnoot-chov/">התיישנות חוב</a>.</li>
  </ul>

  <h2 id="payments" class="scroll-mt-24">4. הזכות לשלם לפי היכולת</h2>
  <p>חייב שלא יכול לשלם את כל החוב בבת אחת יכול לבקש <strong>צו תשלומים</strong> לפי סעיף 7א לחוק — בתוך 20 ימים מהמצאת האזהרה, או במועד אחר שנקבע בה. לפי סעיף 7א1, חוב של עד 100,000 ₪ אפשר לפרוס עד 3 שנים, וחוב גבוה מזה עד 4 שנים, והרשם מוסמך להאריך. לפי דף השירות של הרשות, הסכום החודשי המינימלי בבקשה הוא 150 ₪. שימו לב לסדר: לפי הרשות, בקשה בטופס 233 מגישים אחרי שחלפה תקופת האזהרה, ובתוך תקופת האזהרה מבקשים חקירת יכולת, שבה הרשם קובע סכום חודשי. אל תחכו: לפי סעיף 7ג(ב), מי שלא פעל אחרי האזהרה ולא ביקש צו תשלומים עלול להיחשב משתמט. <a href="/guides/tzav-tashlumim/">בקשה לצו תשלומים</a>.</p>

  <h2 id="wage" class="scroll-mt-24">5. הזכות שחלק מהמשכורת יישאר אצלכם</h2>
  <p>לפי סעיף 8 לחוק הגנת השכר, בחוב שאינו מזונות, מוגן <strong>הנמוך מבין</strong> סכום בסיס לפי הרכב המשפחה (למשל 2,596 ₪ ליחיד ב־2026) לבין 80% מהשכר נטו. אחרי שהשכר הופקד בחשבון, ההגנה נמשכת חודש ימים מיום התשלום. בחוב מזונות הכללים אחרים. <a href="/guides/ikul-maskoret/">עיקול משכורת — כמה מותר</a> · <a href="/tools/ikul-maskoret/">מחשבון הסכום המוגן</a>.</p>

  <h2 id="benefits" class="scroll-mt-24">6. הזכות שקצבאות ביטוח לאומי לא יעוקלו</h2>
  <p>לפי <a href={NII_LAW}>סעיף 303 לחוק הביטוח הלאומי</a>, הזכות לגמלת כסף אינה ניתנת לעיקול, למעט לתשלום מזונות לפי פסק דין. אחרי שהגמלה הופקדה בבנק, ההגנה נמשכת 30 ימים מיום התשלום, והבנק רשאי לנכות ממנה מקדמה שנתן על חשבונה. אם עיקלו חשבון שנכנסה אליו קצבה, מבקשים לבטל את העיקול ומצרפים אישור מביטוח לאומי ופירוט תנועות. <a href="/rights/skhomim-mugganim/">כספים מוגנים מעיקול</a>.</p>

  <h2 id="property" class="scroll-mt-24">7. הזכות לציוד בסיסי שאסור לעקל</h2>
  <p>סעיף 22 לחוק ההוצאה לפועל מונה מיטלטלין שאין מעקלים, ביניהם מזון ל־30 יום, ריהוט, בגדים, מיטות, ציוד רפואי ותרופות, כלי מטבח וכלי בית בשימוש המשפחה, תשמישי קדושה, חיות מחמד, <strong>טלפונים ניידים ומחשבים אישיים</strong> בשימוש החייב ומשפחתו, וכלי עבודה שהם מקור הפרנסה (עד תקרת שווי). החריג: פריטים שמשמשים לעסק שהחייב מנהל, גם אם הוא מנוהל מהבית. לרכב יש כללים נפרדים. <a href="/guides/ikul-nechassim/">עיקול נכסים</a> · <a href="/guides/ikul-rechev/">עיקול רכב</a>.</p>

  <h2 id="home" class="scroll-mt-24">8. הזכות לתנאים לפני מכירת דירת מגורים</h2>
  <p>דירה יחידה אינה פטורה אוטומטית ממכירה. אבל לפי סעיף 38 לחוק, הרשם לא יורה על מכירה ופינוי של דירה שמשמשת למגורים לפני שהוכחה אחת משלוש: שלחייב ולבני משפחתו שגרים איתו יהיה מקום מגורים סביר, או שיש להם יכולת כלכלית לממן מקום מגורים סביר, או שהועמד להם סידור חלוף. בהזמנה לדיון צריך להופיע מידע על האפשרות לבקש דחייה כדי לפנות לעורך דין או לסיוע משפטי. במשכנתה יש הסדר מיוחד. <a href="/rights/bayit-muggan/">הגנת דירת מגורים</a>.</p>

  <h2 id="consolidation" class="scroll-mt-24">9. הזכות לאחד תיקים לתשלום אחד</h2>
  <p>חייב עם כמה תיקים יכול לבקש <strong>איחוד תיקים</strong>: תשלום חודשי אחד שקובע הרשם ומתחלק בין הזוכים. לא כל תיק נכנס לאיחוד — למשל תיקי מזונות, משכון ומשכנתה, ושטרות או תביעות שהוגשה בהם התנגדות. לפי רשות האכיפה, התשלום החודשי הוא לפחות 3% מסך החובות. חשוב לדעת מראש: כשמוגשת בקשת איחוד, הרשם יורה בצו על עיכוב יציאה מהארץ (סעיף 74ד), אלא אם החליט אחרת מטעמים מיוחדים, וההליכים שכבר ננקטו לא נעצרים מעצמם (סעיף 74ג). <a href="/guides/ichud-tikim/">איחוד תיקים — המדריך המלא</a>.</p>

  <h2 id="restrictions" class="scroll-mt-24">10. הזכות לביטול הגבלות כשעומדים בתשלומים</h2>
  <p>הגבלות כמו עיכוב יציאה מהארץ, הגבלת דרכון או כרטיס חיוב לא מוטלות אוטומטית על כל חייב, והרשם צריך לבחון את התנאים בסעיף 66ב. לפי סעיף 66ד(ג), הרשם יורה על ביטול ההגבלות כשהוא נוכח שהחייב מקיים צו תשלומים או הסכם עם הזוכה. הסמכות להגביל רישיון נהיגה במסגרת סעיף 66א בוטלה. <a href={RESTRICTIONS}>בקשה לביטול הגבלות</a> · <a href="/rights/hagbalot/">הגבלות על חייב</a>.</p>

  <h2 id="appeal" class="scroll-mt-24">11. הזכות לערער על החלטות</h2>
  <p>החלטה של רשם ההוצאה לפועל אפשר לתקוף בבית המשפט. לפי סעיף 80 לחוק, בדרך כלל נדרשת רשות ערעור לבית משפט השלום, למעט החלטות שהחוק מונה במפורש. בענייני משפחה הערעור הוא לבית המשפט לענייני משפחה. הגשת ערעור לא עוצרת את הביצוע מעצמה; אם צריך עיכוב, מבקשים אותו בנפרד. <a href="/guides/irur-hotzaa/">ערעור על החלטת רשם</a>.</p>

  <h2 id="legal-aid" class="scroll-mt-24">12. הזכות לבדוק זכאות לסיוע משפטי</h2>
  <p>הסיוע המשפטי של משרד המשפטים מטפל, בין היתר, ב<strong>חובות בהוצאה לפועל</strong>. הזכאות מותנית בשלושה תנאים: שהנושא ברשימה, מבחן כלכלי ובדיקת סיכויי התיק. לפי דף השירות, מבחן ההכנסה מתחיל ב־67% מהשכר הממוצע במשק, ומבחן הנכסים לא כולל את דירת המגורים. משלמים אגרה לפתיחת תיק, ושכר הטרחה של עורך הדין משולם על ידי הסיוע המשפטי. פונים <a href={LEGAL_AID}>באופן מקוון</a> או במוקד ‎*6405.</p>

  <h2 id="insolvency" class="scroll-mt-24">ואם החובות גדולים מדי לכל זה?</h2>
  <p>כשגם פריסה ארוכה לא תספיק, יש מסלול נוסף: <a href="/insolvency/">חדלות פירעון</a>, שבסופו אפשר לקבל הפטר מיתרת החובות. זה הליך ארוך עם תנאים וחובות משלו, וכדאי לבדוק אותו מוקדם.</p>

  <div class="warn-box">
    <p class="font-semibold mb-1">זכות היא לא הבטחה</p>
    <p class="mb-0">לכל זכות כאן יש תנאים, חריגים ומועדים. רוב הבקשות לא עוצרות הליכים מעצמן (החריג הבולט: התנגדות שהוגשה במועד), וזכות עקרונית לא מבטלת עיקול בלי החלטה. אם יש מועד קרוב — מכירה, פינוי, טיסה או סוף תקופת האזהרה — טפלו בו קודם.</p>
