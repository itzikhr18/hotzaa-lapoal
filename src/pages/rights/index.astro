---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
const pages = [
  { title: '10 זכויות ובדיקות חשובות', href: '/rights/10-zchuyot/', description: 'מידע בתיק, אזהרה, טענות לחוב, תשלומים, ערעור וסיוע.' },
  { title: 'כספים ונכסים מוגנים', href: '/rights/skhomim-mugganim/', description: 'שכר, קצבאות, כספים בבנק וציוד חיוני — עם החריגים.' },
  { title: 'הגבלות ובקשות ביטול', href: '/rights/hagbalot/', description: 'ההבדל בין הגבלה לעיקול ומה משנה עמידה בתשלומים.' },
  { title: 'הגנת דירת מגורים', href: '/rights/bayit-muggan/', description: 'מגורים סבירים וסידור חלוף אינם פטור אוטומטי ממכירה.' },
];
---
<BaseLayout title="זכויות חייב בהוצאה לפועל — הגנות, תנאים וצעדים מעשיים" description="מפת זכויות חייב: הגנה על חלק מהשכר, קצבאות וציוד חיוני, דירת מגורים, הגבלות, בקשות וערעור. מקורות רשמיים וללא הבטחות לביטול אוטומטי.">
  <Header />
  <main id="main-content" class="max-w-4xl mx-auto px-4 py-10 space-y-8">
    <Breadcrumb items={[{ label: 'זכויות חייב' }]} />
    <h1 class="text-3xl font-bold text-brand-dark">זכויות חייב בהוצאה לפועל</h1>
    <p class="text-lg">החוק מקנה הגנות ודרכים להשמיע טענות, אבל לא כל הגנה חלה על כל חוב. התחילו מהצו שקיבלתם: מי הוציא אותו, באיזה תיק, על מה הוא חל ומה המועד הבא.</p>
    <p class="text-sm text-gray-600">עריכת תוכן: 13.09.2026. הסקירות הן מידע כללי המבוסס על המקורות המצוינים, ולא חוות דעת או ביקורת של עורך דין.</p>
    <section aria-label="מדריכי זכויות" class="grid md:grid-cols-2 gap-4">
      {pages.map(page => <a href={page.href} class="block border rounded-xl p-5 hover:bg-blue-50"><h2 class="font-bold text-xl mb-2">{page.title}</h2><p>{page.description}</p></a>)}
    </section>
    <section class="space-y-4">
      <h2 class="text-2xl font-bold">שלוש הגנות שחשוב לא לפרש באופן גורף</h2>
      <p><strong>שכר:</strong> בחוב שאינו מזונות, ההגנה לפי סעיף 8 היא הנמוך בין הבסיס המשפחתי לבין 80% מהשכר לאחר ניכויי חובה בחוק. אין פטור אוטומטי לשכר נמוך. <a href="https://www.btl.gov.il/Laws1/00_0106_000000.pdf" class="underline">חוק הגנת השכר</a>.</p>
      <p><strong>גמלת ביטוח לאומי:</strong> הגנת סעיף 303 כוללת חריג למזונות לפי פסק דין של ערכאה מוסמכת. לאחר תשלום לבנק או לחברת הדואר היא נמשכת 30 ימים, עם סייג למקדמה על חשבון הגמלה. <a href="https://www.btl.gov.il/Laws1/00_0001_000000.pdf" class="underline">חוק הביטוח הלאומי</a>.</p>
      <p><strong>דירת מגורים:</strong> סעיף 38 דורש בירור מגורים סבירים, יכולת מימון או סידור חלוף לפני מכירה ופינוי, עם הוראות מיוחדות למשכנתה. דירה יחידה אינה חסינה אוטומטית. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf" class="underline">חוק ההוצאה לפועל</a>.</p>
    </section>
    <section class="space-y-4">
      <h2 class="text-2xl font-bold">מה עושים לפני שפונים?</h2>
      <p>שמרו את הצו, החלטות התיק ואישורי המסירה והתשלום. אספו מסמכים שמוכיחים את הטענה ובדקו את מסלול ההגשה המתאים. בקשה או ערעור אינם בהכרח עיכוב הליך; אם נדרשת עצירה זמנית, צריך לבדוק סעד מתאים והחלטה.</p>
      <p><a href="https://www.gov.il/he/Departments/Topics/execution" class="underline">שירותי ההוצאה לפועל הרשמיים</a> · <a href="https://www.gov.il/he/service/legal_aid_application" class="underline">בדיקת זכאות לסיוע משפטי</a> · <a href="/guides/bdika-tik/" class="underline">מדריך בדיקת תיק</a></p>
    </section>
  </main>
  <Footer />
</BaseLayout>
