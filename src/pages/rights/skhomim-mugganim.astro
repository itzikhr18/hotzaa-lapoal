---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { WAGE_RULE_TEXT, WAGE_SOURCE_URL, WAGE_LAW_URL } from '../../data/protected-amounts';

const NII_LAW = 'https://www.btl.gov.il/Laws1/00_0001_000000.pdf';
const EXEC_LAW = 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf';
const CANCEL_BANK = 'https://www.gov.il/he/service/foreclosure_cancellation_request';

const faqs = [
  {
    q: 'האם מותר לעקל קצבת ביטוח לאומי?',
    a: 'לפי סעיף 303 לחוק הביטוח הלאומי, הזכות לגמלת כסף אינה ניתנת לעיקול, למעט לתשלום מזונות לפי פסק דין. אחרי שהגמלה הופקדה בבנק או בבנק הדואר, ההגנה נמשכת 30 ימים מיום התשלום. הבנק רשאי לנכות מהגמלה סכום שנתן לכם על חשבונה.',
    source: NII_LAW,
  },
  {
    q: 'כמה מהמשכורת מוגן מעיקול?',
    a: 'בחוב שאינו מזונות, מוגן הנמוך מבין סכום בסיס לפי הרכב המשפחה (למשל 2,596 ₪ ליחיד ב-2026) לבין 80% מהשכר נטו. אחרי שהשכר הופקד בבנק, ההגנה נמשכת חודש ימים מיום התשלום.',
    source: WAGE_LAW_URL,
  },
  {
    q: 'עיקלו לי את החשבון ונכנסה אליו קצבה. מה עושים?',
    a: 'מגישים בקשה לביטול עיקול חשבון עו"ש, בחינם, באזור האישי או בטופס 214, ומצרפים פירוט תנועות של שלושת החודשים האחרונים. מסמנים בתדפיס את הפקדת הקצבה ואת התאריך שלה, ומצרפים אישור מביטוח לאומי.',
    source: CANCEL_BANK,
  },
  {
    q: 'אילו חפצים בבית אסור לעקל?',
    a: 'סעיף 22 לחוק ההוצאה לפועל מונה מיטלטלין שאין מעקלים: מזון ל-30 יום, ריהוט, בגדים, מיטות, ציוד רפואי ותרופות, כלי מטבח וכלי בית בשימוש המשפחה, תשמישי קדושה, חיות מחמד, טלפונים ניידים ומחשבים אישיים בשימוש יחיד ומשפחתו, וכלי עבודה שהם מקור הפרנסה (עד תקרת שווי). חפצים ששימשו לעסק שמנוהל מהבית אינם בהכרח בכלל הפטור.',
    source: EXEC_LAW,
  },
  {
    q: 'האם ההגנות חלות גם בחוב מזונות?',
    a: 'לא באותה מידה. גמלת ביטוח לאומי ניתנת לעיקול לתשלום מזונות לפי פסק דין, ובשכר יש חריג למזונות בסעיף 8(ב) לחוק הגנת השכר. בחוב מזונות חשוב לבדוק את הכללים המיוחדים.',
    source: NII_LAW,
  },
  {
    q: 'פתחתי חשבון חדש רק לקצבה. זה מגן עליה?',
    a: 'ההגנה נקבעת לפי מקור הכסף ומועד ההפקדה, לא לפי החשבון. גם בחשבון נפרד, הקצבה מוגנת ל-30 יום מהתשלום, והשכר לחודש ימים. אבל חשבון נפרד מקל להוכיח מאיפה הגיע הכסף.',
    source: NII_LAW,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'חוק הביטוח הלאומי — סעיף 303', href: NII_LAW },
  { label: 'חוק הגנת השכר — סעיף 8', href: WAGE_LAW_URL },
  { label: 'ביטוח לאומי — סכומי הבסיס (טור ג׳) 2026', href: WAGE_SOURCE_URL },
  { label: 'חוק ההוצאה לפועל — סעיפים 22, 38 ו-66א1', href: EXEC_LAW },
  { label: 'רשות האכיפה והגבייה — בקשה לביטול עיקול חשבון עו"ש', href: CANCEL_BANK },
];

const relatedGuides = [
  { title: 'עיקול חשבון בנק', href: '/guides/ikul-heshbon/' },
  { title: 'עיקול משכורת', href: '/guides/ikul-maskoret/' },
  { title: 'ביטול עיקול', href: '/guides/bitul-ikul/' },
  { title: 'עיקול פנסיה', href: '/guides/ikul-pensiya/' },
  { title: 'דירת מגורים ועיקול', href: '/rights/bayit-muggan/' },
];
---

<GuideLayout
  title="כספים מוגנים מעיקול: קצבאות, שכר וחפצים שאסור לעקל"
  description="אילו כספים ונכסים מוגנים מעיקול בהוצאה לפועל: קצבאות ביטוח לאומי (30 יום בבנק), שכר (חודש ימים), חפצים בבית שאסור לעקל לפי סעיף 22, החריגים במזונות, ואיך מוכיחים ומשחררים כסף מוגן."
  breadcrumb={[{ label: 'זכויות חייב', href: '/rights/' }, { label: 'כספים מוגנים', href: '/rights/skhomim-mugganim/' }]}
  publishDate="2026-03-24"
  updateDate="2026-10-06"
  readTime="7 דקות"
  sources={sources}
  relatedGuides={relatedGuides}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> קצבאות ביטוח לאומי מוגנות מעיקול, וגם אחרי שהגיעו לבנק הן מוגנות ל-30 ימים. מהשכר מוגן החלק הנמוך מבין סכום בסיס לפי הרכב המשפחה לבין 80% מהנטו, ובבנק הוא מוגן לחודש ימים. בבית יש רשימה של חפצים שאסור לעקל, ובהם ריהוט, מיטות, בגדים, טלפון נייד ומחשב אישי.</p>
    <p class="mb-0">אבל ההגנה לא עובדת לבד: אם עיקלו כסף מוגן, צריך להגיש בקשה ולהוכיח מאיפה הגיע הכסף ומתי. <a href="#table">טבלת ההגנות</a> · <a href="#release">איך משחררים</a> · <a href="#items">חפצים שאסור לעקל</a>.</p>
  </div>

  <h2 id="table">מה מוגן, לכמה זמן, ומה החריג</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">סוג הכסף</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">ההגנה</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">כשהכסף בבנק</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">חריגים</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">גמלת כסף לפי חוק הביטוח הלאומי (למשל קצבת זקנה, נכות או ילדים)</td>
          <td class="border border-gray-300 px-4 py-2">הזכות לגמלה אינה ניתנת לעיקול</td>
          <td class="border border-gray-300 px-4 py-2">30 ימים מיום התשלום</td>
          <td class="border border-gray-300 px-4 py-2">מזונות לפי פסק דין; הבנק רשאי לנכות סכום שנתן על חשבון הגמלה</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">שכר עבודה</td>
          <td class="border border-gray-300 px-4 py-2">הנמוך מבין סכום הבסיס לפי הרכב המשפחה לבין 80% מהנטו</td>
          <td class="border border-gray-300 px-4 py-2">חודש ימים מיום התשלום</td>
          <td class="border border-gray-300 px-4 py-2">מזונות (סעיף 8(ב)); לשכר יומי כלל נפרד</td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">קצבת פנסיה תקופתית</td>
          <td class="border border-gray-300 px-4 py-2">נבחנת לפי סעיף 8(ה) לחוק הגנת השכר</td>
          <td class="border border-gray-300 px-4 py-2">לפי סוג התשלום</td>
          <td class="border border-gray-300 px-4 py-2">כספים בקופה ומשיכה חד-פעמית נבחנים אחרת. <a class="text-brand underline" href="/guides/ikul-pensiya/">עיקול פנסיה</a></td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">חסכונות ויתרה שהצטברה</td>
          <td class="border border-gray-300 px-4 py-2">אין הגנה כללית</td>
          <td class="border border-gray-300 px-4 py-2">—</td>
          <td class="border border-gray-300 px-4 py-2">כסף מוגן שעבר את פרק הזמן הופך לכסף רגיל</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="text-sm">מקורות: <a href={NII_LAW}>חוק הביטוח הלאומי, סעיף 303</a>; <a href={WAGE_LAW_URL}>חוק הגנת השכר, סעיף 8</a>.</p>

  <h2 id="kzbaot">קצבאות ביטוח לאומי: 30 יום בבנק</h2>
  <p>לפי <a href={NII_LAW}>סעיף 303 לחוק הביטוח הלאומי</a>, הזכות לגמלת כסף אינה ניתנת להעברה, לשעבוד או לעיקול, למעט לתשלום מזונות לפי פסק דין. ההגנה חלה גם על גמלה ששולמה דרך בנק או בנק הדואר, <strong>במשך 30 ימים מיום שהיא שולמה.</strong> הבנק רשאי לנכות מהגמלה סכום שנתן לכם על חשבונה, למשל מקדמה. לקצבה שמשולמת לפי חוק אחר בודקים את ההוראה שבאותו חוק.</p>
  <p><strong>דוגמה:</strong> קצבת נכות נכנסה לחשבון ב-1 בחודש, והחשבון עוקל ב-15 בחודש. את הקצבה, או מה שנשאר ממנה, אפשר לבקש לשחרר עד 30 ימים מיום התשלום. כסף שנכנס מזמן והצטבר אינו מוגן באותה צורה.</p>
  <div class="tip-box">
    <p class="mb-0"><strong>כרטיס חיוב לקצבה:</strong> לפי סעיף 66א1 לחוק ההוצאה לפועל, הגבלה על שימוש בכרטיסי חיוב לא חלה על כרטיס חיוב מיידי שאפשר להשתמש בו רק כנגד יתרת זכות, ולא על כרטיס שנטען בו רק כסף של גמלת ביטוח לאומי או תשלום אחר שאינו ניתן לעיקול. <a href={EXEC_LAW}>החוק</a>.</p>
  </div>

  <h2 id="maskoret">שכר עבודה</h2>
  <p>{WAGE_RULE_TEXT}</p>
  <p>סכום הבסיס נקבע לפי טור ג׳ בחוק הבטחת הכנסה בחודש שקדם לתשלום השכר. לשכר יומי יש כלל נפרד, ולחוב מזונות יש חריג. אחרי שהשכר שולם דרך בנק, ההגבלות על עיקולו חלות <strong>חודש ימים</strong> מיום התשלום. <a href={WAGE_SOURCE_URL}>טבלת הסכומים 2026</a> · <a href="/guides/ikul-maskoret/">מדריך עיקול משכורת עם טבלה ודוגמאות</a> · <a href="/tools/ikul-maskoret/">מחשבון</a>.</p>

  <h2 id="items">חפצים בבית שאסור לעקל (סעיף 22)</h2>
  <p>לפי <a href={EXEC_LAW}>סעיף 22 לחוק ההוצאה לפועל</a>, אלה מיטלטלין שאין מעקלים:</p>
  <ul>
    <li><strong>מזון</strong> לחייב ולבני המשפחה הגרים איתו, ל-30 יום.</li>
    <li><strong>ריהוט, בגדים, מיטות וכלי מיטה, ציוד רפואי ותרופות, כלי אוכל, כלי מטבח וכלי בית</strong> בשימוש המשפחה — אלא אם הם משמשים לעסק שמנוהל מהבית.</li>
    <li><strong>תשמישי קדושה.</strong></li>
    <li><strong>טלפונים ניידים ומחשבים אישיים</strong> בשימוש חייב שהוא יחיד ובני משפחתו — אלא אם הם משמשים לעסק.</li>
    <li><strong>כלי עבודה, מכשירים ורכב</strong> שבלעדיהם אי אפשר לעבוד במקצוע שהוא מקור הפרנסה — עד תקרת שווי שנקבעה בתקנות.</li>
    <li><strong>ציוד ורכב של נכה</strong> שנחוצים לו לשימושו האישי בגלל הנכות.</li>
    <li><strong>חיות מחמד</strong> שלא משמשות לעיסוק מסחרי.</li>
    <li>פריט אחד מכל סוג שבתוספת החמישית לחוק, ומיטלטלין ששוויים נמוך מסכום שנקבע — עד תקרות שבתקנות.</li>
  </ul>
  <p>שימו לב לחריג: חלק מהפטורים (תשמישי קדושה, כלי עבודה, ציוד של נכה ופריטי התוספת) <strong>לא חלים בחוב שנוצר מקניית אותו פריט.</strong> מנגד, הרשם רשאי לקבוע שגם חפץ אחר לא יעוקל, אם התמורה הצפויה ממכירתו לא מצדיקה את הפגיעה במשפחה (סעיף 22(ה)).</p>

  <h2 id="home-car">דירה ורכב</h2>
  <p><a href="/guides/ikul-rechev/">רכב</a> אינו מוגן אוטומטית, אלא אם הוא נחוץ לפרנסה (עד תקרת השווי) או שייך לנכה. גם <a href="/rights/bayit-muggan/">דירת המגורים היחידה</a> אינה חסינה ממימוש: סעיף 38 לחוק קובע תנאים של דיור או סידור חלוף, עם הסדר מיוחד במשכנתה.</p>

  <h2 id="release">איך משחררים כסף מוגן שעוקל בבנק</h2>
  <ol class="step-list">
    <li><span class="step-num">1</span><span><strong>בודקים מי הטיל את העיקול.</strong> בהוצאה לפועל — מספר התיק מופיע בהודעת הבנק או באזור האישי. <a href="/guides/bdika-tik/">איך בודקים</a>.</span></li>
    <li><span class="step-num">2</span><span><strong>מורידים פירוט תנועות</strong> של שלושת החודשים האחרונים, ומסמנים כל הפקדה מוגנת ואת התאריך שלה.</span></li>
    <li><span class="step-num">3</span><span><strong>מצרפים הוכחת מקור:</strong> אישור תשלום מביטוח לאומי, או תלוש שכר שמתאים להפקדה.</span></li>
    <li><span class="step-num">4</span><span><strong>מגישים בקשה לביטול עיקול חשבון עו"ש</strong> — בחינם, באזור האישי או בטופס 214 (סעיף ייעודי לעו"ש, קוד 988), עם פרטי הבנק והחשבון. <a href={CANCEL_BANK}>דף השירות הרשמי</a> · <a href="/guides/bitul-ikul/">מדריך ביטול עיקול</a>.</span></li>
    <li><span class="step-num">5</span><span><strong>פועלים מהר.</strong> ההגנה בבנק מוגבלת בזמן: 30 יום לקצבה וחודש לשכר. כתבו בבקשה במפורש מה הסכום המבוקש ולמה.</span></li>
  </ol>
  <p>עיקול שהטילה רשות אחרת, כמו רשות מקומית בגבייה מנהלית, מבקשים לבטל מול אותה רשות. טופס של ההוצאה לפועל לא יבטל אותו. <a href="/guides/ikul-heshbon/">עיקול חשבון בנק — המדריך המלא</a>.</p>

  <section id="faq">
    <h2>שאלות נפוצות על כספים מוגנים</h2>
    <div class="space-y-4 my-6">
      {faqs.map(faq => (
        <details class="border border-neutral-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">{faq.q}</summary>
          <p>{faq.a}</p>
          <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
        </details>
      ))}
    </div>
  </section>
</GuideLayout>
