---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "אפשר לפתוח תיק רק 30 ימים אחרי כל פסק דין?",
    "a": "לא כמשפט גורף. בודקים את מועד הביצוע שנקבע, ההמצאה, סוג החיוב והחריגים לפי הדין והנוהל.",
    "source": "https://www.gov.il/BlobFolder/policy/opening-monetary-verdict-file-regulation/he/Forms_opening-monetary-verdict-file1.pdf"
  },
  {
    "q": "מהי התקנה לביטול החלטה במעמד צד אחד?",
    "a": "בתקנות סדר הדין האזרחי החדשות זו תקנה 131; המועד הרגיל בה הוא 30 ימים מהמצאת ההחלטה. יש לבדוק תחולה, מסלול ואיחור במקרה המסוים.",
    "source": "https://www.gov.il/BlobFolder/legalinfo/case-summaries-30-03-2025-2/he/legal-decisions_case-summaries-30-03-2025-2.pdf"
  },
  {
    "q": "האם כל ערעור מוגש בתוך 45 ימים?",
    "a": "לא. בהליך האזרחי הרגיל לפי התקנות החדשות המועד הרגיל הוא 60 ימים מהמצאה. יש מסלולים מיוחדים עם מועדים אחרים.",
    "source": "https://www.gov.il/BlobFolder/guide/guide_to_civil_procedure_01012021/he/commonqa.pdf"
  },
  {
    "q": "האם ערעור עוצר גבייה?",
    "a": "לא מעצם הגשתו. יש לבדוק בקשה לעיכוב ביצוע וקבלת החלטה מתאימה, ולעקוב אחרי תנאיה.",
    "source": "https://www.gov.il/he/service/request_to_delay_execution_proceedings"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "רשות האכיפה — נוהל פתיחת תיק פסק דין כספי",
    "href": "https://www.gov.il/BlobFolder/policy/opening-monetary-verdict-file-regulation/he/Forms_opening-monetary-verdict-file1.pdf"
  },
  {
    "label": "הרשות השופטת — סדר הדין האזרחי",
    "href": "https://www.gov.il/BlobFolder/guide/guide_to_civil_procedure_01012021/he/commonqa.pdf"
  },
  {
    "label": "הרשות השופטת — ערעור או רשות ערעור",
    "href": "https://www.gov.il/he/service/appeal-or-requesting-leave-to-appeal-in-civil-proceedings"
  },
  {
    "label": "עיכוב ביצוע",
    "href": "https://www.gov.il/he/service/request_to_delay_execution_proceedings"
  }
];
---

<GuideLayout
  title="ביצוע פסק דין בהוצאה לפועל — פתיחת תיק, ביטול וערעור"
  description="מועד ביצוע פסק דין כספי, ההבדל בין ביטול החלטה לערעור, תקנות סדר הדין החדשות ועיכוב ביצוע שאינו אוטומטי."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "ביצוע פסק דין", href: "/guides/psak-din/" }]}
  publishDate="2026-03-31"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>פסק דין מבוצע לפי הוראותיו והדין; אין כלל אחיד של ״30 ימים ואז כל ההליכים מותרים״.</strong> יש להבחין בין מועד פתיחת תיק, המצאת אזהרה, ערעור ובקשת ביטול. ערעור אינו עיכוב ביצוע אוטומטי. <a href="https://www.gov.il/BlobFolder/policy/opening-monetary-verdict-file-regulation/he/Forms_opening-monetary-verdict-file1.pdf">נוהל פתיחת תיק פסק דין כספי</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>מתי ניתן לפתוח תיק?</h2>
  <p>בודקים אם פסק הדין קבע מועד לתשלום או לביצוע, את כללי ההמתנה וההמצאה ואת סוג פסק הדין. אם לא נקבע מועד, הדין כולל ככלל המתנה של 30 ימים, עם הוראות וחריגים. אין להחיל זאת באופן גורף על מזונות, פינוי וכל חיוב אחר. פתיחת תיק אינה זהה לאישור מיידי לכל עיקול או הגבלה. <a href="https://www.gov.il/BlobFolder/policy/opening-monetary-verdict-file-regulation/he/Forms_opening-monetary-verdict-file1.pdf">הנוהל הרשמי</a>; <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">סעיף 6 לחוק ההוצאה לפועל</a>.</p>
  <h2>פסק דין שניתן בהיעדר — בקשת ביטול</h2>
  <p>במסגרת תקנות סדר הדין האזרחי החדשות, תקנה 131 עוסקת בביטול החלטה לפי צד אחד. המועד הרגיל הנקוב בה הוא 30 ימים מהמצאת ההחלטה, ולא ניסוח גורף של ״מהיום שנודע לי״. תקנה 201 היא מן התקנות הישנות ואין להציג אותה כברירת המחדל הנוכחית. גם תחולת תקנות ישנות או מיוחדות דורשת בדיקה. <a href="https://www.gov.il/BlobFolder/legalinfo/case-summaries-30-03-2025-2/he/legal-decisions_case-summaries-30-03-2025-2.pdf">לקט פסיקה רשמי המצטט את תקנה 131</a>.</p>
  <p>הבקשה מופנית לבית המשפט שנתן את ההחלטה. נבחנים פגם בהמצאה או בהליך, הסיבה להיעדר וסיכויי הגנה, לפי המסלול והנסיבות. ידיעה בפועל, שיהוי והמצאה עשויים לעורר שאלות משפטיות — אין להסיק מכך שמותר להמתין ללא הגבלה. באיחור בודקים גם הארכת מועד.</p>
  <h2>ערעור על פסק דין</h2>
  <p>בהליך האזרחי הרגיל לפי התקנות החדשות, המועד הרגיל לערעור או בקשת רשות ערעור הוא 60 ימים מהמצאת ההחלטה, ולא 45 ימים לכל פסק דין. <strong>יש מסלולים מיוחדים ומועדים אחרים</strong>, למשל במשפחה ובתביעות קטנות. גם ההבחנה בין ערעור בזכות לרשות תלויה בערכאה ובסוג ההחלטה. <a href="https://www.gov.il/BlobFolder/guide/guide_to_civil_procedure_01012021/he/commonqa.pdf">שאלות ותשובות של הרשות השופטת</a>; <a href="https://www.gov.il/he/service/appeal-or-requesting-leave-to-appeal-in-civil-proceedings">שירות הגשת ערעור</a>.</p>
  <p>ערעור על פסק דין אינו <a href="/guides/irur-hotzaa/">ערעור על החלטת רשם הוצאה לפועל</a>. אין להשתמש במועד של האחד בשביל האחר.</p>
  <h2>עיכוב ביצוע בזמן בירור</h2>
  <p>עצם ערעור או בקשת ביטול אינם בסיס להניח שהגבייה נעצרה. כשנדרש עיכוב מגישים בקשה לגורם המוסמך לפי שלב ההליך, עם הנימוקים והמסמכים; ההחלטה עשויה לכלול תנאים או ערובה. <a href="https://www.gov.il/he/service/request_to_delay_execution_proceedings">שירות עיכוב ביצוע של הרשות השופטת</a>.</p>
  <h2>החוב שולם או שהיתרה שגויה</h2>
  <p>אם הטענה היא לקיום החיוב, ולא לשינוי פסק הדין עצמו, יש לבדוק <a href="https://www.gov.il/he/service/debt_repayment_argument">טענת ״פרעתי״</a>. תשלום, ריבית והוצאות נבדקים מול מסמך החיוב ופירוט התיק. פסק דין נגד חברה אינו מטיל אוטומטית את החוב על מנהליה או בעלי מניותיה; חיוב אישי מחייב בסיס מתאים.</p>
  <h2>פסק דין ישן</h2>
  <p>אין להסיק שכל פסק דין נמחק כעבור מספר קבוע של שנים. התיישנות, פעולות לביצועו, סוג הסעד וחריגים נבחנים בנפרד. <a href="/guides/hitiyashnoot-chov/">מדריך התיישנות חוב</a> מסביר מה צריך לאסוף לבדיקה.</p>
  <h2>רשימת בדיקה מעשית</h2>
  <ul><li>פסק הדין המלא, תאריך נתינתו ותיעוד המצאתו.</li><li>כל מועד או תנאי שנקבע בו.</li><li>מסמכי התביעה והחלטות מאוחרות.</li><li>תיק ההוצאה לפועל, האזהרה והליכים קרובים.</li><li>קבלות ופירוט יתרה; מסמכים התומכים בבקשה לביטול, ערעור או עיכוב.</li></ul>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
