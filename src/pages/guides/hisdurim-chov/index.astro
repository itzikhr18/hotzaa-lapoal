---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "כמה אחוזים מהחוב אפשר להפחית בהסדר?",
    "a": "אין שיעור מובטח או מחירון רשמי להסדר פרטי. כל הסכמה תלויה בצדדים ובתנאיה, וייתכן שלא תושג הפחתה."
  },
  {
    "q": "האם הסדר חייב תמיד להיות בכתב כדי להיות תקף?",
    "a": "אין כלל גורף כזה: הדין או ההסכמה עשויים לדרוש צורה מסוימת. תיעוד כתוב חשוב להוכחת ההסכמה ותנאיה, ויש לבדוק את המקרה לגופו."
  },
  {
    "q": "האם חתימה על הסדר סוגרת מיד את תיק ההוצאה לפועל?",
    "a": "אין להניח כך. יש לבדוק דיווח על ההסדר והתשלומים, עדכון יתרה והחלטות סגירה או ביטול הליכים. נושים ותיקים שאינם חלק מההסדר מצריכים בדיקה נפרדת."
  }
];
const sources = [
  {
    "label": "חוק ההוצאה לפועל — סעיפים 19א–19ב",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "label": "פסק דין רשמי — צורת חוזה והוכחת הסכמה",
    "href": "https://www.gov.il/BlobFolder/dynamiccollectorresultitem/decision35445-01-17/he/35445-01-17.pdf"
  },
  {
    "label": "חוק חדלות פירעון — תיקון מספר 9 (2026)",
    "href": "https://fs.knesset.gov.il/25/law/25_lsr_10981603.pdf"
  },
  {
    "label": "רשות האכיפה — בקשה לסגירת תיק",
