const faqs = [
  {
    "q": "האם ביטול בתיק אחד מסיר את כל ההגבלות?",
    "a": "לא. אם אותה הגבלה פעילה בתיקים נוספים צריך לטפל גם בהם; ייתכנו גם צווים ממקורות אחרים.",
    "source": "https://www.gov.il/he/service/request_for_cancellation_of_restrictions"
  },
  {
    "q": "מהו טופס ביטול הגבלות?",
    "a": "השירות הרשמי מפנה לטופס 214 ולקוד 311 באזור האישי. שם אין צורך לצרף טופס אך חובה לפרט נימוקים; בהגבלת יציאה נדרש תצהיר.",
    "source": "https://www.gov.il/he/service/request_for_cancellation_of_restrictions"
  },
  {
    "q": "האם הגבלת רישיון נהיגה עדיין קיימת?",
    "a": "לא ככלי גבייה בהוצאה לפועל. תיקון 69 ביטל את הסמכות; בעיות אחרות בתוקף הרישיון נבדקות בנפרד.",
    "source": "https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch"
  },
  {
    "q": "האם חייב מוגבל באמצעים משתמש באותה בקשה?",
    "a": "לא לפי הוראות השירות. מי שהוכרז במעמד זה מופנה למסלול ביטול ההכרזה, ולא לבקשה הרגילה לביטול הגבלות.",
    "source": "https://www.gov.il/he/service/request_for_cancellation_of_restrictions"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
