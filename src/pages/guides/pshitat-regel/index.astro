    "href": "https://www.gov.il/BlobFolder/policy/installments-111125/ar/061125.pdf"
  },
  {
    "label": "חוק חדלות פירעון — ספר החוקים",
    "href": "https://fs.knesset.gov.il/20/law/20_lsr_491934.pdf"
  },
