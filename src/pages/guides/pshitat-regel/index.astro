const faqs = [
  {
    "q": "האם פשיטת רגל וחדלות פירעון הם אותו דבר?",
    "a": "אלה מונחים קשורים, אך החוק החדש שינה מסלולים וכללים. לתיקים ישנים עשויות לחול הוראות אחרות; יש לבדוק את הדין שחל על התיק."
  },
  {
    "q": "האם ההליך נמשך שלוש שנים מהפתיחה?",
    "a": "לא זה הכלל. ברירת המחדל היא שלוש שנות תשלומים מצו השיקום הכלכלי, לאחר שלבים קודמים, וניתן לשנותה בהתאם לחוק."
  },
  {
    "q": "האם ההגשה עוצרת את העיקול?",
    "a": "לא אוטומטית. יש לבדוק צו או החלטת עיכוב והיקפם. עצם קבלת הבקשה במערכת אינה עוצרת מועדים והליכים."
  }
];
const sources = [
  {
    "label": "רשות האכיפה — מסלולי חדלות פירעון",
    "href": "https://www.gov.il/he/pages/insovlency-request-guide?chapterindex=4"
  },
  {
    "label": "המדריך הרשמי להגשת בקשה",
    "href": "https://www.gov.il/BlobFolder/policy/opening-insolvency-request-regulation/he/Forms_insolvency-guide.pdf"
  },
  {
