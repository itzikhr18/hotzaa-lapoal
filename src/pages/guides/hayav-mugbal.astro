---
import GuideLayout from '../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "אפשר לבקש היום הכרזה חדשה כחייב מוגבל באמצעים?",
    "a": "לא. לפי הוראות הרשות, האפשרות להכרזות חדשות בוטלה מ-15.9.2019.",
    "source": "https://www.gov.il/BlobFolder/service/cancel_debt_announcement/he/form222.pdf"
  },
  {
    "q": "האם מעמד ישן בוטל אוטומטית ב-2019?",
    "a": "לא. הרשות מבהירה שאין שינוי אוטומטי במעמד מי שכבר הוכרז. צריך לבדוק החלטה מתאימה.",
    "source": "https://www.gov.il/BlobFolder/service/cancel_debt_announcement/he/form222.pdf"
  },
  {
    "q": "האם משתמשים בבקשת ביטול הגבלות רגילה?",
    "a": "השירות הרגיל מחריג מעמד זה ומפנה לבקשת ביטול הכרזה; יש לבדוק את טופס 222 וההנחיות.",
    "source": "https://www.gov.il/he/service/request_for_cancellation_of_restrictions"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "רשות האכיפה — טופס 222 והנחיות",
    "href": "https://www.gov.il/BlobFolder/service/cancel_debt_announcement/he/form222.pdf"
  },
  {
    "label": "ביטול הגבלות — חריג חייב מוגבל",
    "href": "https://www.gov.il/he/service/request_for_cancellation_of_restrictions"
  },
  {
    "label": "חוק ההוצאה לפועל",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  }
];
---

<GuideLayout
  title="חייב מוגבל באמצעים — מעמד היסטורי וביטול ההכרזה"
  description="המסלול סגור להכרזות חדשות מ-15.9.2019. מה בודקים במעמד קיים, טופס 222 וההבחנה מביטול הגבלות רגיל."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "חייב מוגבל באמצעים", href: "/guides/hayav-mugbal/" }]}
  publishDate="2026-01-20"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>לא ניתן להכריז על חייבים מוגבלים באמצעים חדשים מאז 15.9.2019.</strong> עצם השינוי בחוק לא ביטל את מעמד מי שהוכרז לפני כן. צריך לבדוק את ההכרזה וההחלטות הקיימות. <a href="https://www.gov.il/BlobFolder/service/cancel_debt_announcement/he/form222.pdf">הבהרה רשמית בטופס 222</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>מה משמעות המעמד?</h2><p>זהו מעמד מן המסלול ההיסטורי שנגע ליכולת פירעון בפרקי הזמן שנקבעו אז, ולא שם נרדף לחייב בעל יכולת המשתמט מתשלום. עשויות להיות החלטות בדבר תשלומים, איחוד והגבלות; בודקים מה נקבע בתיק המסוים.</p>
  <h2>ביטול הכרזה או שינוי הגבלות</h2><p>השירות הרגיל לביטול הגבלות מחריג מי שהוכרז מוגבל באמצעים. הרשות מפנה למסלול ביטול ההכרזה, וטופס 222 כולל בקשת ביטול הכרזה או שינוי הגבלות. מצרפים נימוקים ומסמכים לפי ההוראות העדכניות. <a href="https://www.gov.il/he/service/request_for_cancellation_of_restrictions">החריג</a>; <a href="https://www.gov.il/BlobFolder/service/cancel_debt_announcement/he/form222.pdf">הנחיות טופס 222</a>.</p>
  <h2>תשלומים ודיווח</h2><p>יש לפעול לפי ההחלטות, למסור מידע מלא ולבקש שינוי כאשר היכולת משתנה. אין להפחית תשלום לבד או להניח שהגשת בקשה ביטלה את המעמד. שומרים אסמכתאות ובודקים החלטה וביצוע בפועל. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">חוק ההוצאה לפועל</a>.</p>
  <h2>רישיון נהיגה</h2><p>הגבלת רישיון נהיגה ככלי גבייה בוטלה בתיקון 69; אין להציג אותה כהגבלה נוכחית הנובעת מהמעמד. בעיות רישוי אחרות נבדקות בנפרד. <a href="https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch">החוק בכנסת</a>.</p>
  <h2 id="alternatives">אילו מסלולים בודקים כיום?</h2><p>לפי המצב ניתן לבדוק <a href="/guides/tzav-tashlumim/">צו תשלומים</a>, <a href="/guides/ichud-tikim/">איחוד תיקים</a> או <a href="/guides/pshitat-regel/">חדלות פירעון</a>. לכל מסלול תנאים והשלכות; אין הבטחה שהאחרון תמיד כדאי, מסתיים בארבע שנים או מוחק את כל החובות. ספים כספיים נבדקים במקור העדכני, לא בטבלה ישנה.</p>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
