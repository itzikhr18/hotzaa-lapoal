---
import GuideLayout from '../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "האם ניתן כיום להגביל רישיון נהיגה בהוצאה לפועל?",
    "a": "לא. תיקון 69 ביטל את סמכות הגבלת רישיון הנהיגה ככלי גבייה בהוצאה לפועל. לפי דוח הרשות לשנת 2022, גם ההגבלות שהיו במלאי בוטלו.",
    "source": "https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch"
  },
  {
    "q": "מתי בוטלה ההגבלה?",
    "a": "בפברואר 2022. דוח רשות האכיפה לשנת 2022 מציין שב-15.2.2022 בוטלו ההגבלות במלאי ולא ניתן עוד להגיש בקשה להטלת הגבלה מסוג זה.",
    "source": "https://www.gov.il/BlobFolder/news/eca-report-2022-news/he/eca-annual-report-2022.pdf"
  },
  {
    "q": "האם ביטול ההגבלה מוחק את החוב?",
    "a": "לא. בוטל כלי הגבייה הנוגע לרישיון, לא החוב או כלל ההליכים בתיק.",
    "source": "https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch"
  },
  {
    "q": "אפשר לנהוג אם מופיעה מניעה אחרת ברישיון?",
    "a": "אין להסיק זאת מביטול הגבלת ההוצאה לפועל. יש לברר מול רשות הרישוי את מקור המניעה ואת תוקף הרישיון; פסילות ודרישות רישוי אחרות הן עניין נפרד.",
    "source": "https://www.gov.il/he/departments/ministry_of_transport_and_road_safety"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "הכנסת — תיקון 69 לחוק ההוצאה לפועל",
    "href": "https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch"
  },
  {
    "label": "רשות האכיפה — דוח 2022, ביטול הגבלת רישיון",
    "href": "https://www.gov.il/BlobFolder/news/eca-report-2022-news/he/eca-annual-report-2022.pdf"
  },
  {
    "label": "מידע ושירותים של רשות האכיפה",
    "href": "https://www.gov.il/he/Departments/Topics/execution"
  }
];
---

<GuideLayout
  title="הגבלת רישיון נהיגה בהוצאה לפועל — בוטלה בפברואר 2022"
  description="תיקון 69 ביטל את הגבלת רישיון הנהיגה בהוצאה לפועל. מה נשאר בתוקף, מה בודקים אם מופיע רישום ישן ומדוע אין בכך היתר לנהוג בלי רישיון תקף."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "רישיון נהיגה", href: "/guides/rishayon-nehiga/" }]}
  publishDate="2026-02-05"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>הגבלת קבלת רישיון נהיגה, החזקתו או חידושו ככלי גבייה בהוצאה לפועל בוטלה.</strong> תיקון 69 ביטל את הסמכות, ורשות האכיפה דיווחה שב-15.2.2022 בוטלו ההגבלות שבמלאי ולא ניתן עוד לבקש הגבלה מסוג זה. <a href="https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch">החוק בכנסת</a>; <a href="https://www.gov.il/BlobFolder/news/eca-report-2022-news/he/eca-annual-report-2022.pdf">דוח הרשות לשנת 2022</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>מה השתנה ומה לא?</h2>
  <p>הביטול נוגע להגבלת רישיון הנהיגה במסגרת גביית חובות. הוא אינו מוחק את החוב, אינו סוגר את תיק ההוצאה לפועל ואינו מבטל עיקולים או הגבלות אחרות. אין צורך לבקש ״הקלה לנהג מקצועי״ כדי לבטל סמכות שכבר בוטלה. <a href="https://main.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2165615&t=lawsuggestionssearch">תיקון 69 — ביטול הסמכות</a>.</p>
  <p>בדוח הרשות נמסר שכל ההגבלות שהיו במלאי בוטלו, ואין אפשרות להגיש בקשה חדשה להטלת הגבלת רישיון. זהו ביטול רוחבי של כלי הגבייה, לא הטבה שתלויה בתשלום החוב. <a href="https://www.gov.il/BlobFolder/news/eca-report-2022-news/he/eca-annual-report-2022.pdf">הדיווח הרשמי</a>.</p>
  <h2>אם עדיין מופיע רישום שמונע חידוש</h2>
  <ol><li>בודקים מהו מקור המניעה ומי הגוף שהטיל אותה.</li><li>אם הרישום מתייחס להוצאה לפועל, פונים לרשות האכיפה עם פרטי הרישום ומבקשים בירור ותיעוד.</li><li>מבררים מול רשות הרישוי את מצב הרישיון ואת הדרישות לחידושו, על סמך המידע העדכני.</li><li>שומרים אישורי פנייה ותשובות. אין להניח שחידוש הושלם עד שנבדק שהרישיון תקף.</li></ol>
  <p>ניתן להגיע לערוצי הפנייה העדכניים דרך <a href="https://www.gov.il/he/Departments/Topics/execution">רשות האכיפה והגבייה</a>. אין טופס רשמי בשם ״טופס 214 לתיקון טעות״: טופס 214 משמש בקשות הנוגעות לביטול, עיכוב או חידוש הליכים והגבלות, לפי הבקשה המתאימה. אין לבחור אותו אוטומטית לפני בירור מקור הרישום.</p>
  <h2>ביטול הגבלה אינו היתר נהיגה</h2>
  <p>אין להסיק מעצם קיומו של חוב או מביטול הגבלת הגבייה שהרישיון בתוקף. פסילה תעבורתית, כשירות רפואית, תוקף רישיון ותנאי חידוש הם עניינים נפרדים, שאינם מתבטלים בשל תיקון ההוצאה לפועל. בודקים את המצב בערוצי <a href="https://www.gov.il/he/departments/ministry_of_transport_and_road_safety">משרד התחבורה והבטיחות בדרכים</a>. העמוד אינו קובע זכאות לנהוג במקרה אישי או פטור מאגרת חידוש.</p>
  <h2>אילו הליכים אחרים עשויים להישאר?</h2>
  <p>עיקול בנק, משכורת ונכסים והגבלות אחרות נבחנים לפי תנאי הדין וההחלטות בתיק; אינם מוטלים או מתבטלים רק משום שבוטלה הגבלת רישיון הנהיגה. דוח הרשות מפרט בנפרד הגבלות כגון דרכון, יציאה מהארץ, לקוח מוגבל מיוחד, כרטיסי חיוב ומעמד בתאגיד. <a href="https://www.gov.il/BlobFolder/news/eca-report-2022-news/he/eca-annual-report-2022.pdf">פרק ההגבלות בדוח הרשות</a>.</p>
  <ul><li><a href="/guides/ikul-maskoret/">עיקול משכורת</a> — אין כלל אוניברסלי של ״עד שליש מהשכר״.</li><li><a href="/guides/bitul-hagbalot/">ביטול הגבלות</a> — יש לזהות את ההגבלה והמקור.</li><li><a href="/guides/tzav-tashlumim/">צו תשלומים</a> — בקשה לפריסה אינה מבטלת אוטומטית את כלל ההליכים.</li><li><a href="/guides/bdika-tik/">בדיקת התיק והחלטותיו</a> — הצעד הראשון לבירור המצב בפועל.</li></ul>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
