---
import GuideLayout from '../../layouts/GuideLayout.astro';

const BTL_303 = 'https://www.btl.gov.il/Laws1/00_0001_000000.pdf';
const WAGE_LAW = 'https://www.btl.gov.il/Laws1/00_0106_000000.pdf';
const EXEC_LAW = 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf';
const SERVICE = 'https://www.gov.il/he/service/foreclosure_cancellation_request';

const faqs = [
  {
    q: 'מה זה אומר שהחשבון שלי מעוקל?',
    a: 'הבנק קיבל צו עיקול ומחזיק כספים בחשבון לטובת תיק החוב, עד גובה הצו. עיקול הוא עדיין לא העברת הכסף לזוכה: כדי שהכסף יעבור לתיק נדרש הליך נוסף. בתקופה הזו אפשר לבקש לבטל את העיקול או לעכב את המימוש.',
    source: SERVICE,
  },
  {
    q: 'האם קצבת ביטוח לאומי בחשבון מוגנת מעיקול?',
    a: 'לפי סעיף 303 לחוק הביטוח הלאומי, גמלת כסף מוגנת מעיקול גם אחרי שהופקדה בבנק, במשך 30 ימים מיום התשלום. יש חריג לחוב מזונות לפי פסק דין, והבנק רשאי לקזז מקדמה שנתן על חשבון אותה גמלה.',
    source: BTL_303,
  },
  {
    q: 'עיקלו חשבון משותף — מה עם הכסף של בן הזוג?',
    a: 'בפועל הבנק מקפיא בדרך כלל את החשבון כולו, אבל העיקול נועד לכספים של החייב בלבד. השותף שאינו חייב יכול לבקש מהרשם לשחרר את הכספים שלו, ולהוכיח במסמכים שהם שלו, למשל תלושי שכר והפקדות. איך מחלקים את הכסף בחשבון משותף נקבע לפי הנסיבות ולפי ההחלטה בתיק, ולכן במקרה כזה כדאי להתייעץ.',
  },
  {
    q: 'מה צריך לצרף לבקשה לביטול עיקול חשבון?',
    a: 'לפי רשות האכיפה והגבייה: טופס 214 (באזור האישי אין צורך בטופס, אבל חובה לפרט נימוקים), פירוט תנועות בעו"ש משלושת החודשים האחרונים, פרטי החשבון (בנק, סניף, כתובת הסניף ומספר חשבון), והחלטת בית משפט אם יש. השירות ניתן ללא עלות.',
    source: SERVICE,
  },
  {
    q: 'אפשר לעקל חשבון בנק בלי אזהרה?',
    a: 'ככלל, בתקופת האזהרה לא ננקטים הליכים. לפי מדריך הרשות יש מקרים מיוחדים שבהם הזוכה מקבל אישור לנקוט הליכים עוד לפני מתן האזהרה, למשל עיקול זמני. בנוסף, עיקול מנהלי של רשות מקומית או רשות המסים מתנהל במסלול אחר לגמרי.',
    source: 'https://www.gov.il/he/pages/execution_debtors_guide',
  },
  {
    q: 'אם אפתח חשבון חדש, הכסף בו יהיה מוגן?',
    a: 'פתיחת חשבון נוסף לא יוצרת הגנה חדשה. ההגנה תלויה במקור הכסף ובמועד ההפקדה — קצבה, שכר — ולא בחשבון שאליו הוא נכנס. לפעמים חשבון נפרד לקצבה מקל על ההוכחה, אבל הוא לא פוטר מעיקול.',
    source: BTL_303,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'רשות האכיפה והגבייה — בקשה לביטול עיקול חשבון עובר ושב', href: SERVICE },
  { label: 'רשות האכיפה והגבייה — עיכוב הליכים (קודים 61 ו-62)', href: 'https://www.gov.il/he/service/delay_processes' },
  { label: 'רשות האכיפה והגבייה — עיכוב הליכים בגין "חייב משלם"', href: 'https://www.gov.il/he/service/application-for-recognition-of-payable-debts-execution' },
  { label: 'חוק ההוצאה לפועל — עיקול אצל צד שלישי, סעיפים 43–50', href: EXEC_LAW },
  { label: 'חוק הביטוח הלאומי — סעיף 303', href: BTL_303 },
  { label: 'חוק הגנת השכר — סעיף 8', href: WAGE_LAW },
];

const relatedGuides = [
  { title: 'ביטול עיקול', href: '/guides/bitul-ikul/' },
  { title: 'כספים מוגנים מעיקול', href: '/rights/skhomim-mugganim/' },
  { title: 'עיקול משכורת', href: '/guides/ikul-maskoret/' },
  { title: 'עיקול זמני', href: '/guides/ikul-zman/' },
  { title: 'חוב ארנונה ועיקול מנהלי', href: '/guides/chov-arnona/' },
  { title: 'בדיקת תיק הוצאה לפועל', href: '/guides/bdika-tik/' },
];
---

<GuideLayout
  title="עיקול חשבון בנק בהוצאה לפועל: כספים מוגנים, חשבון משותף ואיך משחררים"
  description="עיקלו לכם את חשבון הבנק? מה זה אומר, אילו כספים מוגנים (קצבה — 30 ימים, משכורת — חודש), מה קורה בחשבון משותף, איך מגישים בקשה לביטול עיקול עו״ש חינם ומה מצרפים."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: 'עיקול חשבון בנק', href: '/guides/ikul-heshbon/' }]}
  publishDate="2026-03-24"
  updateDate="2026-10-05"
  readTime="8 דקות"
  sources={sources}
  relatedGuides={relatedGuides}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> עיקול חשבון אומר שהבנק מחזיק כסף בחשבון לטובת תיק החוב. הכסף עוד לא הועבר לזוכה. חלק מהכספים מוגנים: קצבת ביטוח לאומי למשך 30 ימים מההפקדה, וחלק מהמשכורת למשך חודש ימים.</p>
    <p class="mb-0">משחררים בבקשה לביטול עיקול עו"ש: באזור האישי, או בטופס 214 עם פירוט תנועות מ-3 החודשים האחרונים. ההגשה חינם. <a href={SERVICE}>דף השירות הרשמי</a>.</p>
  </div>

  <p>הודעה מהבנק על עיקול היא אחד הרגעים הכי מלחיצים: פתאום אי אפשר למשוך כסף, הוראות קבע נדחות, והקצבה או המשכורת כאילו נעלמו. החדשות הטובות הן שעיקול הוא עוד לא סוף פסוק. חלק מהכסף מוגן בחוק, ויש דרך מסודרת לבקש לשחרר אותו. נתחיל במה שעושים עוד היום.</p>

  <h2 id="first-steps">מה עושים היום — 4 צעדים ראשונים</h2>
  <ol class="step-list">
    <li><span class="step-num">1</span><span><strong>מבקשים מהבנק את פרטי הצו:</strong> מי הוציא אותו, מספר התיק, התאריך, הסכום וכמה כסף הוקפא. ייתכנו כמה צווים מגופים שונים.</span></li>
    <li><span class="step-num">2</span><span><strong>בודקים מאיפה העיקול.</strong> אם הוא מתיק הוצאה לפועל, תראו אותו <a href="/guides/bdika-tik/">באזור האישי</a>. אם הוא מעירייה או מרשות המסים, זה עיקול מנהלי, ומטפלים בו מול הגוף שהטיל אותו. <a href="/guides/chov-arnona/">עיקול בגלל חוב ארנונה</a>.</span></li>
    <li><span class="step-num">3</span><span><strong>מורידים פירוט תנועות</strong> מ-3 החודשים האחרונים, ומסמנים כל הפקדה מוגנת: קצבה, משכורת וכו', עם התאריך והסכום.</span></li>
    <li><span class="step-num">4</span><span><strong>מגישים בקשה לביטול או לעיכוב</strong> באזור האישי, ומצרפים אסמכתאות. אם הכסף נחוץ למחיה, כותבים במפורש שהבקשה דחופה. <a href="#cancel">הפירוט בהמשך</a>.</span></li>
  </ol>

  <h2 id="what-it-means">מה בעצם קורה כשהחשבון מעוקל?</h2>
  <p>עיקול בבנק הוא "עיקול אצל צד שלישי": הבנק מחזיק כסף שלכם, וההוצאה לפועל מורה לו לא להעביר אותו אליכם עד גובה הצו. המסגרת נמצאת ב<a href={EXEC_LAW}>פרק ד' לחוק ההוצאה לפועל, סעיפים 43–50</a>. חשוב להבחין בין שני שלבים:</p>
  <ul>
    <li><strong>עיקול:</strong> הכסף מוקפא, אבל עדיין בחשבון שלכם.</li>
    <li><strong>מימוש:</strong> הכסף מועבר בפועל לתיק ההוצאה לפועל.</li>
  </ul>
  <p>בין שני השלבים יש זמן לפעול. בקשת <strong>עיכוב</strong> (קוד 61) משאירה את העיקול, אבל מונעת את המימוש. בקשת <strong>ביטול</strong> (קוד 62) מבקשת להסיר את העיקול. לפי הרשות, עיכוב לא מחזיר את הפעילות הרגילה בחשבון. <a href="https://www.gov.il/he/service/delay_processes">מקור</a>.</p>

  <h2 id="protected-money">אילו כספים בחשבון מוגנים מעיקול?</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">סוג הכסף</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">כמה זמן מוגן אחרי ההפקדה</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">חריגים</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מקור</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">קצבת ביטוח לאומי (גמלת כסף)</td>
          <td class="border border-gray-300 px-4 py-2">30 ימים מיום התשלום</td>
          <td class="border border-gray-300 px-4 py-2">חוב מזונות לפי פסק דין. הבנק רשאי לקזז מקדמה שנתן על חשבון הגמלה</td>
          <td class="border border-gray-300 px-4 py-2"><a class="text-brand underline" href={BTL_303}>סעיף 303</a></td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">משכורת</td>
          <td class="border border-gray-300 px-4 py-2">חודש ימים מיום התשלום, ורק לגבי החלק המוגן של השכר</td>
          <td class="border border-gray-300 px-4 py-2">חוב מזונות (סעיף 8(ב))</td>
          <td class="border border-gray-300 px-4 py-2"><a class="text-brand underline" href={WAGE_LAW}>סעיף 8(ו)</a></td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">חסכונות שהצטברו בחשבון</td>
          <td class="border border-gray-300 px-4 py-2">ההגנות האלה לא חלות על כסף שנשאר בחשבון אחרי התקופה</td>
          <td class="border border-gray-300 px-4 py-2">—</td>
          <td class="border border-gray-300 px-4 py-2">—</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>שימו לב: 30 ימים בקצבה, וחודש ימים בשכר — אלה שני כללים נפרדים, מחוקים שונים. כדי שהבקשה תתקבל, צריך להראות בדיוק אילו הפקדות מוגנות ומתי נכנסו. מצרפים לבקשה אישור מביטוח לאומי או תלוש שכר. פנסיה ממעסיק או מקופה היא לא קצבת ביטוח לאומי, ויש לה כללים משלה. <a href="/guides/ikul-pensiya/">עיקול פנסיה</a> · <a href="/rights/skhomim-mugganim/">כל הכספים המוגנים</a>.</p>

  <h2 id="joint-account">עיקול חשבון בנק משותף</h2>
  <p>זו אחת השאלות הנפוצות ביותר: החוב הוא של אחד מבני הזוג, אבל החשבון משותף. מה קורה לכסף של מי שאינו חייב?</p>
  <ul>
    <li><strong>בפועל, הבנק מקפיא בדרך כלל את החשבון כולו</strong> כשמגיע צו על אחד מבעליו.</li>
    <li><strong>אבל העיקול נועד לכספים של החייב בלבד.</strong> כסף שהוא בבירור של השותף, למשל המשכורת שלו, אפשר לבקש לשחרר. איך מחלקים את שאר הכסף נקבע לפי הנסיבות ולפי החלטת הרשם.</li>
    <li><strong>מי שאינו חייב יכול לבקש לשחרר את הכסף שלו.</strong> מגישים בקשה לרשם בתיק, עם הוכחה שהכסף שלו: תלושי שכר שנכנסים לחשבון, הפקדות שלו, קצבה על שמו. ככל שההוכחה ברורה יותר, כך גדל הסיכוי שהכסף ישוחרר.</li>
  </ul>
  <div class="tip-box">
    <p class="font-semibold mb-1">לטווח הארוך</p>
    <p class="mb-0">כשיש לאחד מבני הזוג חובות בהוצאה לפועל, ההפרדה בין הכנסות היא בעיקר שאלה של הוכחה. משכורת או קצבה של בן הזוג שאינו חייב שנכנסת לחשבון נפרד על שמו קל יותר להוכיח כשלו. זו לא עצה להסתיר כספים. הברחת נכסים מנושים אסורה. מדובר בסדר בין כספים שבאמת שייכים לאנשים שונים.</p>
  </div>
  <p>במצבים של חשבון משותף עם סכומים משמעותיים, כדאי להתייעץ עם עורך דין או לבדוק <a href="https://www.gov.il/he/service/legal_aid_application">זכאות לסיוע משפטי</a>.</p>

  <h2 id="cancel">איך מבקשים לבטל עיקול חשבון — מה מצרפים</h2>
  <p>לפי <a href={SERVICE}>דף השירות של רשות האכיפה והגבייה</a>:</p>
  <ul>
    <li><strong>הבקשה:</strong> טופס 214, "בקשה לביטול / עיכוב / חידוש הליכים והגבלות". בטופס יש סעיף ייעודי, "בקשה לביטול עיקול חשבון עו"ש" (קוד 988), שבו ממלאים את שם הבנק, הסניף ומספר החשבון. באזור האישי לא צריך לצרף את הטופס, אבל חובה לכתוב את הנימוקים בשדה הייעודי.</li>
    <li><strong>פירוט תנועות בחשבון העו"ש</strong> משלושת החודשים האחרונים.</li>
    <li><strong>פרטי החשבון:</strong> שם הבנק ומספרו, שם הסניף ומספרו, כתובת הסניף ומספר החשבון.</li>
    <li><strong>החלטת בית משפט</strong> שמורה לבטל את העיקול, אם יש.</li>
  </ul>
  <p>מומלץ להוסיף אסמכתאות למקור הכסף: אישור ביטוח לאומי, תלוש שכר. כתבו גם במדויק כמה כסף מבקשים לשחרר ולמה. מגישים באזור האישי, בדוא"ל, בפקס, בדואר או בלשכה בזימון תור. <strong>השירות ניתן ללא עלות.</strong> ההחלטה מתקבלת אצל הרשם המטפל בתיק. <a href="/guides/bitul-ikul/">המדריך המלא לביטול עיקול</a>.</p>

  <h2 id="other-ways">דרכים נוספות לשחרר את החשבון</h2>
  <ul>
    <li><strong>תשלום מלא של החוב בתיק:</strong> לפי הרשות, בתיקי פסק דין כספי, שטרות, תביעה על סכום קצוב וכביש אגרה, אחרי תשלום מלוא החוב בתיק ההוצאה לפועל העיקול מבוטל מיד, בלי בקשה. בדקו באזור האישי שהתשלום נקלט, במיוחד אם שילמתם ישירות לזוכה.</li>
    <li><strong>הסדר עם הזוכה:</strong> אחרי ההסדר, הזוכה מגיש את הבקשה לביטול ההליכים. <a href="/guides/hisdurim-chov/">הסדר חוב</a>.</li>
    <li><strong>"חייב משלם":</strong> מי ששילם 3 תשלומים רצופים לפי צו תשלומים, או תשלום אחד לפי "טבלת המנהל" בחובות עד 50,000 ₪, יכול לבקש הכרה כ"חייב משלם". אם הבקשה מתקבלת, ההליכים בעיקול העו"ש מעוכבים. זה לא אוטומטי: הזוכה מקבל 30 יום להגיב, וההחלטה ניתנת תוך 45 יום. ועיכוב אינו ביטול — העיקול נשאר רשום, אבל אי אפשר לממש אותו. <a href="https://www.gov.il/he/service/application-for-recognition-of-payable-debts-execution">פרטים</a>.</li>
    <li><strong>צו תשלומים או איחוד תיקים:</strong> הם לא משחררים את העיקול אוטומטית, אבל פותחים את הדרך לבקשת עיכוב ולהכרה כחייב משלם. <a href="/guides/tzav-tashlumim/">צו תשלומים</a> · <a href="/guides/ichud-tikim/">איחוד תיקים</a>.</li>
  </ul>

  <h2 id="not-the-same">עיקול, חשבון מוגבל והגבלת צ'קים — לא אותו דבר</h2>
  <ul>
    <li><strong>עיקול חשבון:</strong> כסף שמוחזק לטובת תיק חוב מסוים.</li>
    <li><strong>הגבלה בהוצאה לפועל על קבלת צ'קים וכרטיסי אשראי:</strong> הגבלה שהזוכה ביקש בתיק. מבטלים אותה בבקשה לביטול הגבלות, בכל תיק בנפרד. <a href="/guides/bitul-hagbalot/">ביטול הגבלות</a>.</li>
    <li><strong>"חשבון מוגבל"</strong> בגלל צ'קים שחזרו: הגבלה לפי חוק שיקים ללא כיסוי, שמנוהלת מול הבנק ובנק ישראל. זה מסלול אחר.</li>
  </ul>

