---
import GuideLayout from '../../layouts/GuideLayout.astro';

const faqs = [
  {
    q: 'איך מבטלים עיקול בהוצאה לפועל?',
    a: 'מגישים לרשם ההוצאה לפועל בקשה לביטול העיקול: באזור האישי (בלי לצרף טופס, אבל עם נימוקים בשדה הייעודי) או בטופס 214 בקוד בקשה 62. מצרפים אסמכתאות לפי סוג העיקול — למשל פירוט תנועות בעו"ש משלושת החודשים האחרונים — ועוקבים אחרי החלטת הרשם באזור האישי.',
    source: 'https://www.gov.il/he/service/foreclosure_cancellation_request',
  },
  {
    q: 'כמה עולה להגיש בקשה לביטול עיקול?',
    a: 'לפי דפי השירות של רשות האכיפה והגבייה, בקשה לביטול עיקול חשבון, משכורת או רכב ניתנת ללא עלות. בבקשה לעיכוב הליכים בלי החלטת בית משפט נדרש תצהיר, והחתימה עליו כרוכה באגרה לפי טבלת האגרות.',
    source: 'https://www.gov.il/he/service/delay_processes',
  },
  {
    q: 'מה ההבדל בין קוד 61 לקוד 62 בטופס 214?',
    a: 'קוד 61 הוא בקשה לעיכוב הליכים: העיקול נשאר רשום, אבל אי אפשר להתקדם ממנו — למשל לממש את הכסף בחשבון או לתפוס את הרכב. קוד 62 הוא בקשה לביטול הליכים והגבלות, כלומר להסיר את העיקול עצמו.',
    source: 'https://www.gov.il/he/service/delay_processes',
  },
  {
    q: 'שילמתי את כל החוב — העיקול יורד לבד?',
    a: 'בתיקים מסוג פסק דין כספי, שטרות, תביעה על סכום קצוב וכביש אגרה — כן. לפי הרשות, לאחר תשלום מלוא החוב העיקול מבוטל ללא צורך בבקשה, והתיק נסגר אוטומטית 30 יום מיום התשלום. בסוגי תיקים אחרים, או כשהתשלום עבר ישירות לזוכה, כדאי לוודא באזור האישי ולהגיש בקשה אם העיקול נשאר.',
    source: 'https://www.gov.il/he/service/file_closure_request-5',
  },
  {
    q: 'האם צו תשלומים או תשלום חלקי מבטלים את העיקול?',
    a: 'לא אוטומטית. הרשות מציינת שתשלום חלקי אינו עוצר הליכי גבייה, ושכדי לעכב או לבטל הליכים צריך להגיש בקשה נפרדת. מי ששילם 3 תשלומים רצופים לפי צו תשלומים יכול לבקש הכרה כ"חייב משלם", שמעכבת עיקולי משכורת, עו"ש ומיטלטלין ומימוש עיקול רכב.',
    source: 'https://www.gov.il/he/service/request-change-payment-arrangement-222',
  },
  {
    q: 'כמה זמן לוקח לבטל עיקול?',
    a: 'אין זמן מובטח לבקשת ביטול עיקול. בשירותים אחרים של הרשות, כמו ביטול הגבלות או טענת פרעתי, מצוין שההחלטה ניתנת תוך 45 יום מההגשה באזור האישי, ובקשה שנשלחת בדואר, בדוא"ל או בפקס נקלטת בתיק תוך 7 ימי עסקים. אם יש דחיפות אמיתית, כותבים אותה במפורש ומצרפים ראיות.',
    source: 'https://www.gov.il/he/service/request_for_cancellation_of_restrictions',
  },
  {
    q: 'איך מוכיחים לבנק או למעסיק שהעיקול בוטל?',
    a: 'החלטת הרשם מופיעה באזור האישי של ההוצאה לפועל, ואפשר להירשם לקבלת החלטות בהודעת SMS או בדוא"ל. אם הבנק או המעסיק עדיין מסמנים את העיקול אחרי ההחלטה, מציגים להם את ההחלטה ובודקים מול מוקד הרשות שההודעה נשלחה.',
    source: 'https://www.gov.il/he/pages/qf_personal_information',
  },
  {
    q: 'אפשר להגיש בקשה לביטול עיקול בלי עורך דין?',
    a: 'כן. חייבים שאינם מיוצגים יכולים להגיש באזור האישי, בדוא"ל, בפקס, בדואר או בלשכה בזימון תור מראש. עורך דין לא חובה, אבל במקרים מורכבים — מחלוקת על החוב, פגם בהמצאה או נכס של צד שלישי — כדאי לבדוק זכאות לסיוע משפטי.',
    source: 'https://www.gov.il/he/service/foreclosure_cancellation_request',
  },
];

