const faqs = [
  {
    "q": "האם רשם יכול לפרוס חוב מזונות עבר?",
    "a": "כן, לפי התנאים והסמכות שבדין. זו אינה הפחתה אוטומטית של המזונות השוטפים שנפסקו.",
    "source": "https://m.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2015883&t=lawreshumot"
  },
  {
    "q": "האם מזונות ביטוח לאומי נכללים באיחוד?",
    "a": "לא. השירות הרשמי לאיחוד מחריג את כל סוגי תיקי המזונות, לרבות מזונות ביטוח לאומי.",
    "source": "https://www.gov.il/he/service/request_for_consolidation_portfolio"
  },
  {
    "q": "האם עיכוב יציאה מוטל אוטומטית?",
    "a": "אין להסיק כך מעצם החוב. יש לבדוק את המסלול, תנאי הדין וההחלטות בתיק.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "q": "האם פנייה לשינוי מזונות עוצרת את החיוב?",
    "a": "הגשת בקשה אינה החלטה שמשנה את פסק הדין. יש לבדוק מה תקף ולפעול לפי החלטה מתאימה.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "מדריך גביית מזונות — רשות האכיפה",
    "href": "https://www.gov.il/he/pages/alimony?chapterIndex=4"
  },
  {
    "label": "תיקון 55 — סמכות לפריסת חוב עבר",
    "href": "https://m.knesset.gov.il/activity/legislation/laws/pages/lawbill.aspx?lawitemid=2015883&t=lawreshumot"
  },
  {
    "label": "חוק ההוצאה לפועל",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "label": "בקשת איחוד — תיקים מוחרגים",
    "href": "https://www.gov.il/he/service/request_for_consolidation_portfolio"
