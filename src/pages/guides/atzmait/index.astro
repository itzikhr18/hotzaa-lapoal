---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "האם חשבון עסקי של עצמאי מוגן מעיקול?",
    "a": "לא מעצם היותו עסקי. בודקים בעלות בכסף, מקורו, הצו והגנות רלוונטיות.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "q": "האם נושה יכול להורות ללקוחות לשלם לו ישירות?",
    "a": "לא מעצם דרישה פרטית. עיקול אצל צד שלישי ומימושו נעשים במסגרת ההליך והצווים המתאימים.",
    "source": "https://www.gov.il/he/pages/execution_entitled_guide?chapterIndex=6"
  },
  {
    "q": "איך מוכיחים הכנסה משתנה?",
    "a": "מציגים דוחות ומסמכים לפי דרישת הבקשה או ההחלטה ומסבירים עונתיות. אין נוסחת ממוצע אחידה לכל עצמאי.",
    "source": "https://www.gov.il/he/service/request-change-payment-arrangement-222"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "חוק ההוצאה לפועל",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "label": "רשות האכיפה — עיקול אצל צד שלישי",
    "href": "https://www.gov.il/he/pages/execution_entitled_guide?chapterIndex=6"
  },
  {
    "label": "בקשה לצו תשלומים",
    "href": "https://www.gov.il/he/service/request-change-payment-arrangement-222"
  }
];
---

<GuideLayout
  title="הוצאה לפועל לעצמאים — הכנסות העסק, ציוד ובירור יכולת"
  description="איך בודקים עיקול אצל לקוחות, הפרדה בין יחיד לחברה, הגנת ציוד ותיעוד הכנסה משתנה בלי להניח הגנת שכר אוטומטית."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "הוצאה לפועל לעצמאים", href: "/guides/atzmait/" }]}
  publishDate="2026-03-26"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>הכנסה מעסק אינה זהה לשכר שכיר לצורך כל הגנה מעיקול.</strong> בודקים מי החייב, למי שייך הנכס ומה מקור הכסף. יש לתעד הכנסות משתנות והוצאות, ולא להניח שכל חשבון עסקי או כלי עבודה חסינים. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">המסגרת בחוק ההוצאה לפועל</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2 id="income">עיקול כסף אצל לקוחות</h2><p>כסף של החייב המוחזק אצל אחר עשוי להיכלל בעיקול צד שלישי. זהו צו במסגרת הליך, ולא זכות של נושה לשלוח ללקוח דרישה פרטית ולחייבו לשלם ישירות לו. רישום עיקול ומימוש כספים הם שלבים נפרדים. <a href="https://www.gov.il/he/pages/execution_entitled_guide?chapterIndex=6">ההבחנה בשירותי הרשות</a>.</p>
  <h2 id="ikul-tziyud">ציוד ונכסי עסק</h2><p>החוק מגן על נכסים מסוימים בתנאים, מגבלות סכום וחריגים. נחיצות לפרנסה היא נתון לבדיקה, לא חסינות אוטומטית לכל רכב, מכונה או מחשב. יש להציג בעלות, שימוש ושווי ולבדוק אם קיימת בטוחה או זכות של אדם אחר. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">סעיף 22</a>; <a href="/guides/bitul-ikul/">בקשת ביטול עיקול</a>.</p>
  <h2 id="hakira">תיעוד הכנסה לא קבועה</h2><p>מכינים דוחות הכנסות והוצאות, דפי חשבון, דיווחים לרשויות ואסמכתאות להתחייבויות לפי הנדרש. אין כלל קבוע שהרשם מחשב תמיד ממוצע של 6–12 חודשים. מסבירים עונתיות ושינוי ביכולת במסמכים ולא בהצהרה כללית. <a href="https://www.gov.il/he/service/request-change-payment-arrangement-222">הנחיות בקשת תשלומים</a>.</p>
  <h2>יחיד וחברה</h2><p>עוסק פטור או מורשה אינו בשל הכותרת הזו אישיות נפרדת מהאדם. בחברה צריך לבדוק מי החייב לפי המסמך והצו, בעלות בנכס וערבות או בסיס אחר לחיוב אישי; אין להסיק שכל חוב חברה הוא חוב בעליה, או שערבות היא הבסיס האפשרי היחיד לחיוב אישי.</p>
  <h2>הגנות ופעילות שוטפת</h2><p>אין להעביר נכסים או לנתב תקבולים כדי להתחמק מצו. אם ההליך פוגע בפעילות חיונית, אפשר לבדוק בקשה מנומקת לעיכוב או שינוי ולצרף נתוני תזרים, אך אין הבטחה להשארת ״חלק משמעותי״ מהחשבון. <a href="https://www.gov.il/he/service/delay_processes">עיכוב הליכים</a>.</p>
  <h2>אם אין יכולת לפרוע</h2><p>אפשר לבדוק צו תשלומים או מסגרת <a href="/guides/pshitat-regel/">חדלות פירעון</a> לפי התנאים העדכניים. אין בעמוד סכום סף לא מאומת או הבטחה להפטר ולשמירת העסק. שינוי צו או ערעור נבחנים במסלול ובמועד המתאימים.</p>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
