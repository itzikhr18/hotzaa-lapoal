const faqs = [
  {
    q: 'מתי אפשר להגיש בקשה לצו תשלומים?',
    a: 'לפי רשות האכיפה והגבייה, רק אחרי שקיבלתם את האזהרה (ההודעה על פתיחת התיק) ואחרי שעברה תקופת האזהרה. אם התקופה עוד לא עברה, אפשר להתייצב לחקירת יכולת אצל רשם, ושם ייקבע סכום חודשי.',
    source: SERVICE,
  },
  {
    q: 'מה הסכום המינימלי לתשלום חודשי?',
    a: 'לפי דף השירות, סכום המינימום החודשי בבקשה לצו תשלומים הוא 150 ₪. מומלץ לשלם כבר את התשלום הראשון בסכום שאתם מציעים, ולא פחות מ-150 ₪, ולצרף את הקבלה לבקשה.',
    source: SERVICE,
  },
  {
    q: 'לכמה זמן אפשר לפרוס את החוב?',
    a: 'חוב של פחות מ-100,000 ₪ אפשר לפרוס עד 3 שנים, וחוב גבוה מזה עד 4 שנים. הרשם מוסמך להאריך בעוד עד 3 שנים, כלומר עד 6 או 7 שנים. בתום התקופה הוא בוחן שוב את היכולת לשלם.',
    source: SERVICE,
  },
  {
    q: 'האם צו תשלומים מבטל את העיקולים?',
