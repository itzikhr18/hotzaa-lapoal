---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "האם עיקול זמני מוכיח שהחוב נכון?",
    "a": "לא. מדובר בסעד ביניים לפי התנאים הדיוניים, ולא בפסק דין סופי בתביעה.",
    "source": "https://www.gov.il/BlobFolder/legalinfo/case-summaries-11-01-2026/he/case-summaries-11-01-2026-1.pdf"
  },
  {
    "q": "האם כל עיקול זמני מתבטל אחרי 30 ימים?",
    "a": "לא. התוקף והפקיעה תלויים בדין ובתנאי הצו והחלטות ההמשך.",
    "source": "https://www.gov.il/BlobFolder/legalinfo/case-summaries-11-01-2026/he/case-summaries-11-01-2026-1.pdf"
  },
  {
    "q": "האם מבקשים תמיד ביטול ברשם ההוצאה לפועל?",
    "a": "לא. צריך לזהות מי נתן את הצו; סעד זמני בתביעה בבית משפט והליך בתיק הוצאה לפועל הם מסלולים שונים.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "רשות האכיפה — פסיקה על תקנה 103",
    "href": "https://www.gov.il/BlobFolder/legalinfo/case-summaries-11-01-2026/he/case-summaries-11-01-2026-1.pdf"
  },
  {
    "label": "חוק ההוצאה לפועל",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  }
];
---

<GuideLayout
  title="עיקול זמני — סעד בבית משפט לעומת הליך בהוצאה לפועל"
  description="מה מטרת עיקול זמני, מה נדרש למתן הצו, כיצד בודקים ביטול או שינוי ומדוע אין תקופה אחידה לכל עיקול."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "עיקול זמני", href: "/guides/ikul-zman/" }]}
  publishDate="2026-03-31"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>עיקול זמני בבית משפט נועד להבטיח אפשרות ביצוע, לא להכריע שהחוב מוצדק.</strong> הוא שונה מהליך גבייה בתיק הוצאה לפועל. תחילה מזהים מי נתן את הצו ובאיזה הליך. <a href="https://www.gov.il/BlobFolder/legalinfo/case-summaries-11-01-2026/he/case-summaries-11-01-2026-1.pdf">לקט פסיקה רשמי על עיקול זמני</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>מה נבחן בבקשה?</h2><p>תקנה 103 וכללי הסעד הזמני דורשים בחינה של עילת התביעה, מאזן הנזק ותנאים נוספים. בעיקול נדרש חשש סביר שאי־מתן הצו יכביד באופן ממשי על ביצוע פסק הדין. עצם קיום תביעה או חוב נטען אינו מספיק לכל עיקול. <a href="https://www.gov.il/BlobFolder/legalinfo/case-summaries-11-01-2026/he/case-summaries-11-01-2026-1.pdf">הסבר בפסיקה הרשמית</a>.</p>
  <h2>אם הצו ניתן בלי שנשמעתם</h2><p>בודקים את הצו, הבקשה, ההמצאה והמועד למסלול הביטול המתאים. טענת הגנה, נכס שאינו של המשיב, היעדר התנאים או חלופה מידתית עשויים להיות רלוונטיים, אך אינם יוצרים ביטול בלי הליך והחלטה. בקשת ביטול אינה התעלמות מהצו.</p>
  <h2>כמה זמן הצו תקף?</h2><p>קוראים את תנאי הצו ואת כללי פקיעתו. אין כלל שכל עיקול זמני תקף 20 או 30 ימים, ואין להניח שזכייה או דחיית תביעה שחררו בפועל כל רישום בלי לבדוק החלטות, הוראות המשך ועדכון המחזיק. <a href="https://www.gov.il/BlobFolder/legalinfo/case-summaries-11-01-2026/he/case-summaries-11-01-2026-1.pdf">פסיקה והמסגרת הדיונית</a>.</p>
  <h2>עיקול לפני אזהרה בהוצאה לפועל</h2><p>גם בהוצאה לפועל עשויים להינקט במקרים המתאימים הליכים לפני המצאת אזהרה באישור ובתנאים שבחוק. זה אינו אותו מסלול של סעד זמני בבית משפט. אין להפנות כל בקשת ביטול לרשם בלי לזהות את מקור הצו. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">סעיף 7 לחוק ההוצאה לפועל</a>.</p>
  <h2>ביטול, שינוי או ערובה חלופית</h2><p>אפשר לבדוק בקשה מתאימה לשינוי הסעד או להמרתו בערובה, לפי הדין והנסיבות. אין סכום ערובה אחיד ואין הבטחה להסכמה. אם מדובר בהוצאה לפועל ראו <a href="/guides/bitul-ikul/">ביטול עיקול</a>; אם מדובר בבית משפט, פונים במסלול התיק השיפוטי.</p>
  <h2>מה לשמור?</h2><p>הצו והבקשה, תאריך המצאה, פרטי הנכס והמחזיק, מסמכי בעלות וראיות לנזק או לטענות ההגנה. אם יש מועד קרוב, בודקים בדחיפות את ההליך הנדרש ולא מסתמכים על משך טיפול משוער באתר מידע.</p>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
