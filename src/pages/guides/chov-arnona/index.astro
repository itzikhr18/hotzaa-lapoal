import GuideLayout from '../../../layouts/GuideLayout.astro';

const CIRCULAR = 'https://www.gov.il/BlobFolder/dynamiccollectorresultitem/mancal-4-3-5/he/home_main_ceo-regulations_mancal_4-3-5.pdf';
const APPEALS = 'https://www.gov.il/BlobFolder/guide/guides-for-selected1/he/home_main_local-government_Information-guides_commity-guides-2.pdf';

const faqs = [
  {
    q: 'אפשר למחוק חוב ארנונה?',
    a: 'כן, אבל רק בתנאים של נוהל מחיקת חובות של משרד הפנים, והמחיקה נעשית על ידי הרשות המקומית ולא אוטומטית. חוב ארנונה של יחיד אפשר למחוק בעיקר כשהוא "חוב אבוד" (אין נכסים, פיגור של לפחות שלוש שנים ומיצוי הליכי גבייה), או כשהחייב היה זכאי להנחה בארנונה ולא מימש אותה בגלל נסיבות מיוחדות, או זכאי לה עכשיו. במקרה האחרון המחיקה מותנית בהסדר לתשלום יתרת החוב.',
    source: CIRCULAR,
  },
  {
    q: 'למי פונים כדי לבקש מחיקה או הפחתה של חוב ארנונה?',
    a: 'לרשות המקומית — מחלקת הגבייה או ועדת ההנחות. לפי הנוהל, בעירייה הבקשה למחיקה עוברת לאישור הממונה על המחוז במשרד הפנים, עם הצהרה של ראש הרשות, הגזבר והיועץ המשפטי שתנאי הנוהל מתקיימים.',
    source: CIRCULAR,
  },
  {
    q: 'קשה לי לשלם. זו עילה לפשרה עם העירייה?',
    a: 'לפי נוהל משרד הפנים, פשרה שבה נמחק חלק מהחוב מחייבת מחלוקת של ממש, עובדתית או משפטית, על החוב עצמו: חוקיות, תחולה עליכם, גובה. ככלל, קשיי גבייה כשלעצמם אינם עילה לפשרה. לקושי כלכלי שלכם המסלולים הם הנחה בארנונה, הסדר תשלומים, או מחיקה בתנאי הנוהל.',
    source: CIRCULAR,
  },
  {
    q: 'מתי מגישים השגה על ארנונה?',
    a: 'על העילות שבחוק — בתוך 90 ימים מקבלת הודעת התשלום, למנהל הארנונה. יש לבדוק שהטענה נמצאת בסמכותו.',
    source: APPEALS,
  },
  {
    q: 'אין תשובה להשגה אחרי 60 ימים — היא התקבלה?',
    a: 'החוק כולל כלל של קבלה כשאין תשובה, אבל גם אפשרות להארכה מנומקת של עד 30 ימים, שוועדת הערר נותנת בתוך התקופה. לכן בודקים אם ניתנה הארכה.',
    source: APPEALS,
  },
  {
    q: 'מה המועד לערר על תשובת מנהל הארנונה?',
    a: '30 ימים ממסירת התשובה. ערעור לבית משפט הוא מסלול נפרד, ויש לבדוק את הוראותיו העדכניות.',
    source: APPEALS,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'משרד הפנים — חוזר מנכ"ל 5/2012: נוהל מחיקת חובות רשות מקומית', href: CIRCULAR },
  { label: 'משרד הפנים — מדריך ועדת ערר לארנונה', href: APPEALS },
  { label: 'רשות האכיפה והגבייה — תיקים שלא נכללים באיחוד', href: 'https://www.gov.il/he/service/request_for_consolidation_portfolio' },
