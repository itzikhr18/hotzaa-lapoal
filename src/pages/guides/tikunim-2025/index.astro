---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "מתי נכנס תיקון 9 לתוקף?",
    "a": "תחילת הרפורמה היא 1 בינואר 2025, בכפוף להוראות התחילה והמעבר שבחקיקה.",
    "source": "https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot"
  },
  {
    "q": "האם הרפורמה מוחקת חובות ישנים?",
    "a": "לא. שינוי מנגנון החישוב אינו מחיקת קרן או הבטחה לביטול כל ריבית עבר. צריך לבדוק את מקור הריבית, התקופות והוראות המעבר.",
    "source": "https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot"
  },
  {
    "q": "האם כל תשלום מפסיק דמי פיגורים?",
    "a": "לא ניתן להסיק כך. קיימים תנאים בדין הנוגעים למסלול ולתשלומים; אין להניח שתשלום בודד או הסדר פרטי מבטלים את כל הרכיבים.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "q": "האם יש אחוז חיסכון קבוע?",
    "a": "לא. השפעת התיקון תלויה בנתוני החוב והתקופות, ואין בעמוד הבטחה לאחוז הפחתה בתיק אישי.",
    "source": "https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "הכנסת — תיקון 9 ותחילתו",
    "href": "https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot"
  },
  {
    "label": "נוסח החוק שפורסם ברשומות",
    "href": "https://fs.knesset.gov.il/25/law/25_lsr_3568695.pdf"
  },
  {
    "label": "חוק ההוצאה לפועל",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  }
];
---

<GuideLayout
  title="תיקון 9 לחוק פסיקת ריבית והצמדה — מה השתנה מ-2025"
  description="ריבית שקלית ודמי פיגורים, תחולה על חובות קיימים לפי הוראות המעבר, משמעות תשלומים ומה צריך לבדוק בפירוט היתרה."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "תיקון 9 — ריבית ודמי פיגורים", href: "/guides/tikunim-2025/" }]}
  publishDate="2025-06-01"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>הרפורמה שנכנסה לתוקף ב-1.1.2025 הפרידה בין ריבית לבין דמי פיגורים.</strong> היא אינה מחיקת חוב, אינה הבטחה לחיסכון אחיד ואינה הופכת כל חוב חוזי לחוב בריבית אחת. <a href="https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot">תיקון 9 במאגר החקיקה הלאומי</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>מהם שני הרכיבים?</h2>
  <p>הריבית נועדה לשקף את חלוף הזמן על הכסף. דמי הפיגורים נועדו לתמרץ תשלום ומתווספים במנגנון תקופתי של שלושה חודשים לפי החוק. התיקון קבע ריבית שקלית כברירת מחדל ושינה את מנגנון דמי הפיגורים, לרבות ביטול ריבית דריבית על רכיב זה. אין להסיק שבוטלה כל ריבית דריבית בכל רכיב חוב. <a href="https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot">הסבר הכנסת לתיקון</a>.</p>
  <h2>מתי מתחילים לחשב דמי פיגורים?</h2>
  <p>המועד תלוי בסוג החיוב ובכללים החלים עליו, לרבות הוראות לגבי מועד פתיחת תיק והמצאה. לכן ״כל שלושה חודשים״ אינו בהכרח סוף רבעון קלנדרי, ואינו הוראה לחשב מהיום שבו נלקחה הלוואה. <a href="https://fs.knesset.gov.il/25/law/25_lsr_3568695.pdf">נוסח התיקון וההוראות הנוגעות להוצאה לפועל</a>.</p>
  <h2>האם השינוי חל על תיק ישן?</h2>
  <p>לרפורמה הוראות תחילה ומעבר. יש להבחין בין סכומים שנצברו לפני 1.1.2025 לבין חישוב לאחריו, ובין ריבית לפי חוק פסיקת ריבית לבין ריבית חוזית או דין מיוחד. אין הבטחה שכל התוספות בתיק ישן נמחקות, שהקרן משתנה או שהיתרה בהכרח קטנה. <a href="https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot">תחילה והוראות המעבר בחקיקה</a>.</p>
  <h2>מה הקשר לתשלום סדיר?</h2>
  <p>התיקונים כוללים הסדרים הנוגעים לדמי פיגורים ולהפחתות לחייבים המשלמים לפי התנאים שבדין. יש לבדוק את סוג ההוראה, רצף התשלומים, דיווחם וההכרה הנדרשת. אין להניח שכל תשלום פרטי, הסדר או בקשה לצו מפסיקים את כל רכיבי הריבית. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">הוראות חוק ההוצאה לפועל</a>.</p>
  <h2>איך בודקים את ההשפעה בפועל?</h2>
  <ol><li>פותחים את פירוט היתרה הרשמי, לא רק את שורת הסכום הכולל.</li><li>מפרידים בין קרן, ריבית, דמי פיגורים, הצמדה, הוצאות ושכר טרחה.</li><li>בודקים תאריכים ותשלומים שנקלטו, ואת בסיס הריבית בתיק.</li><li>אם יש פער, מבקשים פירוט ובודקים מסלול תיקון או הפחתה מתאים.</li></ol>
  <p><a href="/guides/ribit-hotzaa/">המדריך לבדיקת רכיבי הריבית</a> מסביר את ההבחנות. אין כאן שיעור קבוע או מחשבון חלופי ליתרה הרשמית.</p>
  <h2>הפחתת ריבית אינה אוטומטית</h2>
  <p>החקיקה הרחיבה את שיקול הדעת ביחס לדמי פיגורים. בקשת הפחתה נבחנת לפי הסמכות, הרכיב והנסיבות; היא אינה מחייבת ויתור על הקרן ואינה מבטיחה ביטול ריבית שכבר נצברה. אין לבלבל תיקון חישוב שגוי עם הפחתה שבשיקול דעת. <a href="https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot">הסבר התיקון</a>.</p>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
