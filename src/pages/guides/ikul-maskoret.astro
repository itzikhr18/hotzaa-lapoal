import GuideLayout from '../../layouts/GuideLayout.astro';
import { WAGE_RULE_TEXT, WAGE_LAW_URL, WAGE_SOURCE_URL, WAGE_INCOME_LAW_URL } from '../../data/protected-amounts';
const sources = [{ label: 'חוק הגנת השכר — סעיף 8', href: WAGE_LAW_URL }, { label: 'חוק הבטחת הכנסה — התוספת השנייה', href: WAGE_INCOME_LAW_URL }, { label: 'ביטוח לאומי — סכומי הבטחת הכנסה 2026', href: WAGE_SOURCE_URL }, { label: 'רשות האכיפה והגבייה — ביטול עיקול משכורת', href: 'https://www.gov.il/he/service/cancel_salary_foreclosure' }];
---
<GuideLayout title="עיקול משכורת: הסכום המוגן, כלל 80% ובקשת ביטול" description="מהו החלק המוגן בשכר חודשי, למה 20% אינם תקרה כללית, מה החריג למזונות ואילו מסמכים להכין לבירור או לבקשת ביטול עיקול משכורת." breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: 'עיקול משכורת', href: '/guides/ikul-maskoret/' }]} publishDate="2025-01-20" updateDate="2026-09-13" sources={sources}>
  <p class="text-lg">{WAGE_RULE_TEXT}</p>
  <h2 id="law">מה הבסיס המשפטי?</h2>
  <p>סעיף 8(א) לחוק הגנת השכר משאיר חלק משכר העבודה החודשי מחוץ לעיקול. מתחילים מסכום הגמלה שבטור ג׳ בתוספת השנייה לחוק הבטחת הכנסה, לפי הרכב המשפחה, בחודש שקדם לתשלום השכר. אם הסכום הזה עולה על 80% מהשכר, ההגנה מצטמצמת ל-80%. השכר לצורך ההשוואה הוא לאחר ניכויים שהמעסיק חייב לנכות על פי חיקוק — לא כל ניכוי רצוני שמופיע בתלוש.</p>
  <p>מקור צמוד: <a href={WAGE_LAW_URL}>סעיף 8 לחוק הגנת השכר</a>, ו<a href={WAGE_INCOME_LAW_URL}>התוספת השנייה לחוק הבטחת הכנסה</a>. החישוב מתייחס להגנה שבסעיף זה, לא להחלטה על סכום הניכוי בפועל.</p>
  <h2 id="amounts">כיצד בודקים את הסכום?</h2>
  <ol><li>מזהים את חודש תשלום השכר ואת הרכב המשפחה לפי הגדרות הדין, כולל הגדרת ילד והורה עצמאי.</li><li>מאמתים את סכום הבסיס בחודש הקודם, לא רק את השנה שמופיעה בכותרת.</li><li>משווים את הבסיס ל-80% מהשכר לאחר ניכויי חובה בחוק: הנמוך הוא החלק המוגן מכוח סעיף 8.</li><li>משווים לצו ולניכוי בפועל; אין להסיק שכל יתרה חייבת להיגבות.</li></ol>
  <p><a href={WAGE_SOURCE_URL}>טבלת ביטוח לאומי מ-01.01.2026</a> מציגה את סכומי הבסיס הרלוונטיים בטבלת גיל 55 עד גיל הפרישה. השימוש בטור ג׳ הוא מכוח הפניית החוק, ואינו תנאי גיל לעובד. <a href="/tools/ikul-maskoret/">במחשבון יש טבלה והדגמה מוגבלת לשכר המשולם בספטמבר 2026</a>.</p>
  <h2 id="exceptions">מזונות, שכר יומי ופנסיה</h2>
  <p>הגנת סעיף 8(א) אינה חלה על עיקול לשם תשלום מזונות — סעיף 8(ב). בשכר על בסיס יומי קובע סעיף 8(א1) חלק של 1/25 מהסכום החודשי; אין להשתמש במחשבון החודשי כאילו הוא חישוב יומי. קצבה ממעסיק או מקופת גמל נחשבת כשכר לעניין סעיף זה, בלי לגרוע מהגנה אחרת שבחוק; אין לערבב אותה עם גמלת ביטוח לאומי או עם חיסכון שטרם שולם.</p>
  <p>עבודה אצל כמה מעסיקים, תשלומים חריגים, שינוי משפחתי או הכנסה ממקורות שונים מחייבים בירור פרטני. המחשבון אינו מחבר הכנסות ואינו קובע זכאות.</p>
  <h2 id="bank">המשכורת כבר הופקדה בבנק</h2>
  <p>לפי סעיף 8(ו), ההגבלות ממשיכות לחול על השכר ששולם באמצעות הגופים המנויים בחוק במשך חודש ימים ממועד התשלום. זו אינה הגנה קבועה על יתרת החשבון, ולא פטור לכל הכספים המעורבים בו. שמרו תלוש ותדפיס שמזהים את ההפקדה. לגבי גמלת ביטוח לאומי קיים כלל נפרד של 30 ימים — <a href="/guides/ikul-heshbon/">ראו מדריך עיקול חשבון</a>.</p>
  <h2 id="action">מה עושים אם נוכה סכום שנראה שגוי?</h2>
  <ul><li>בקשו את העתק הצו ופירוט חישוב הניכוי מהמעסיק.</li><li>אספו תלוש, פירוט ניכויי חובה, מסמכי הרכב משפחה ותדפיס בנק אם הכסף כבר הופקד.</li><li>בדקו בתיק את סוג החוב, ההחלטה האחרונה והבקשות שכבר הוגשו.</li><li>פעלו לפי <a href="https://www.gov.il/he/service/cancel_salary_foreclosure">שירות ביטול עיקול משכורת הרשמי</a>. ציינו במפורש מה מבוקש ולמה, וצרפו אסמכתאות.</li><li>אם נדרש לעצור ניכוי קרוב, בקשו גם סעד זמני מתאים ועקבו אחר החלטה. אל תניחו שעצם הגשת הבקשה עצרה את ההליך.</li></ul>
  <p>צו תשלומים או תשלום חלקי אינם מחליפים אוטומטית את העיקול. כאשר ניתנת החלטת ביטול או שינוי, יש לוודא מה נדרש להמצאתה ויישומה אצל המעסיק. במקרה דחוף או מורכב אפשר לבדוק <a href="https://www.gov.il/he/service/legal_aid_application">זכאות לסיוע משפטי</a>; הזכאות אינה אוטומטית.</p>
  <h2 id="faq">האם שכר מינימום או שכר נמוך פטורים מעיקול?</h2>
  <p>לא באופן אוטומטי מכוח סעיף 8. המבחן אינו הכותרת ״שכר מינימום״, אלא נוסחת ההגנה ותנאי הדין. גם כשסכום הבסיס גבוה מהשכר, ההגנה שבסעיף עשויה להיות 80% מהשכר ולא כולו.</p>
</GuideLayout>
