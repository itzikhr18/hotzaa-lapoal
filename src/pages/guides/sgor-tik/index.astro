---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const SERVICE = 'https://www.gov.il/he/service/file_closure_request-5';
const FORM_406 = 'https://www.gov.il/BlobFolder/generalpage/tfasim_9/he/%D7%98%D7%95%D7%A4%D7%A1%20406-%D7%91%D7%A7%D7%A9%D7%94%20%D7%9C%D7%A1%D7%92%D7%99%D7%A8%D7%AA%20%D7%AA%D7%99%D7%A7.pdf';

const faqs = [
  {
    q: 'איך סוגרים תיק בהוצאה לפועל?',
    a: 'בתיקים מסוג פסק דין כספי, שטרות, תביעה על סכום קצוב וכביש אגרה, תשלום מלא של החוב מבטל את ההליכים, והתיק נסגר אוטומטית 30 יום מיום התשלום. בשאר המקרים מגישים בקשה לסגירת תיק בטופס 406, בקשה מספר 71, או באזור האישי, עם סיבת הסגירה ואסמכתאות.',
    source: SERVICE,
  },
  {
    q: 'איזה טופס משמש לסגירת תיק?',
    a: 'טופס 406 — "בקשה לסגירת תיק הוצאה לפועל", בקשה מספר 71. באזור האישי לא צריך לצרף את הטופס, אבל חובה לפרט את הסיבות בשדה הייעודי. הטופס משמש גם להסרת חייב אחד מתיק שיש בו כמה חייבים.',
    source: FORM_406,
  },
  {
    q: 'הגעתי להסדר עם הזוכה — מי מגיש את בקשת הסגירה?',
    a: 'גם זוכה וגם חייב יכולים להגיש בקשה לסגירת תיק. כשההסדר הושג מול עורך הדין של הזוכה, הכי פשוט שהזוכה יגיש את בקשת הסגירה או את הבקשה לביטול ההליכים. בקשו זאת במפורש בהסכם, ובדקו באזור האישי שהבקשה הוגשה.',
    source: SERVICE,
  },
  {
    q: 'שילמתי ישירות לזוכה והתיק עדיין פתוח — מה עושים?',
    a: 'אם הזוכה לא דיווח על התשלום, מגישים טענת "פרעתי": טופס 236, קוד בקשה 119, עם בקשה מנומקת, תצהיר חתום בפני גורם מוסמך (בתשלום אגרה) והקבלות. ההחלטה ניתנת בדרך כלל תוך 45 יום מההגשה באזור האישי.',
    source: 'https://www.gov.il/he/service/debt_repayment_argument',
  },
  {
    q: 'כמה עולה להגיש בקשה לסגירת תיק?',
    a: 'לפי דף השירות של רשות האכיפה והגבייה, בקשה לסגירת תיק או להסרת חייב מתיק ניתנת ללא עלות.',
    source: SERVICE,
  },
  {
    q: 'האם תיק שלא קרה בו כלום שנים נסגר לבד?',
    a: 'לא אוטומטית. תקנה 126 לתקנות ההוצאה לפועל קובעת מנגנון של סגירה מחוסר מעש, בתנאים ובהחלטה. גם סגירה כזו לא בהכרח מוחקת את החוב.',
    source: 'https://www.btl.gov.il/Laws1/002_0063_100000.pdf',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'רשות האכיפה והגבייה — בקשה לסגירת תיק או הסרת חייב מתיק', href: SERVICE },
  { label: 'רשות האכיפה — טופס 406 לסגירת תיק', href: FORM_406 },
  { label: 'רשות האכיפה והגבייה — טענת "פרעתי"', href: 'https://www.gov.il/he/service/debt_repayment_argument' },
  { label: 'תקנות ההוצאה לפועל (תקנה 126)', href: 'https://www.btl.gov.il/Laws1/002_0063_100000.pdf' },
  { label: 'חוק ההוצאה לפועל', href: 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf' },
];

const relatedGuides = [
  { title: 'בדיקת תיק ורשימת תיקים', href: '/guides/bdika-tik/' },
  { title: 'ביטול עיקול', href: '/guides/bitul-ikul/' },
  { title: 'הסדר חוב עם נושים', href: '/guides/hisdurim-chov/' },
  { title: 'ביטול הגבלות', href: '/guides/bitul-hagbalot/' },
  { title: 'התיישנות חוב', href: '/guides/hitiyashnoot-chov/' },
  { title: 'טפסים ונוסחים', href: '/forms/' },
];
---

<GuideLayout
  title="סגירת תיק הוצאה לפועל: טופס 406, סגירה אוטומטית אחרי תשלום ובקשת זוכה"
  description="איך סוגרים תיק בהוצאה לפועל: מתי התיק נסגר לבד 30 יום אחרי תשלום מלא, טופס 406 (בקשה 71), בקשת זוכה לסגירת תיק אחרי הסדר, טענת פרעתי כשהתשלום לא נקלט, סגירה מחוסר מעש ומה בודקים אחרי הסגירה."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: 'סגירת תיק', href: '/guides/sgor-tik/' }]}
  publishDate="2026-03-28"
  updateDate="2026-10-05"
  readTime="7 דקות"
  sources={sources}
  relatedGuides={relatedGuides}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> בתיקים מסוג פסק דין כספי, שטרות, תביעה על סכום קצוב וכביש אגרה, אחרי תשלום מלוא החוב כל ההליכים מבוטלים, והתיק <strong>נסגר אוטומטית 30 יום מיום התשלום</strong>.</p>
    <p class="mb-0">בכל מצב אחר — הסדר, ויתור, או תשלום שלא נקלט — מגישים בקשה לסגירת תיק: <strong>טופס 406, בקשה מספר 71</strong>, או באזור האישי. ההגשה חינם. <a href={SERVICE}>דף השירות הרשמי</a>.</p>
  </div>

  <p>להגיע לסגירת התיק זה רגע של הקלה. אבל כדי שהתיק ייסגר באמת, וכל העיקולים וההגבלות ירדו, צריך לוודא שהמערכת יודעת שהחוב סולק. כאן תמצאו את כל הדרכים לסגור תיק, לפי המצב שלכם, ומה בודקים אחרי הסגירה.</p>

  <h2 id="paths">איך נסגר התיק — לפי המצב שלכם</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">המצב</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מה קורה / מה עושים</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">שילמתם את כל החוב דרך מערכת ההוצאה לפועל, בתיק פסק דין כספי, שטרות, סכום קצוב או כביש אגרה</td>
          <td class="border border-gray-300 px-4 py-2">ההליכים מבוטלים והתיק נסגר <strong>אוטומטית</strong> 30 יום מיום התשלום. לא צריך להגיש בקשה. בדקו באזור האישי שזה קרה</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2">הגעתם להסדר או לפשרה עם הזוכה</td>
          <td class="border border-gray-300 px-4 py-2">הזוכה מגיש בקשה לסגירת התיק או לביטול ההליכים. כדאי לכתוב זאת בהסכם. אפשר גם להגיש בעצמכם, טופס 406 עם ההסכם</td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">שילמתם ישירות לזוכה, והתשלום לא נקלט בתיק</td>
          <td class="border border-gray-300 px-4 py-2">מבקשים מהזוכה לדווח. אם הוא לא מדווח, מגישים <a class="text-brand underline" href="https://www.gov.il/he/service/debt_repayment_argument">טענת "פרעתי"</a>: טופס 236, קוד 119, עם תצהיר וקבלות</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2">יש כמה חייבים בתיק, ואתם רוצים להסיר את עצמכם</td>
          <td class="border border-gray-300 px-4 py-2">טופס 406, עם שם ומספר זהות של החייב שמבקש להסיר את עצמו, ונימוקים</td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">התיק הוא חלק מתיק איחוד</td>
          <td class="border border-gray-300 px-4 py-2">מפרטים בבקשה את סיבת הסגירה של התיק הספציפי. תיק איחוד עצמו נסגר רק בהחלטת רשם</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2">לא נעשתה פעולה בתיק זמן רב</td>
          <td class="border border-gray-300 px-4 py-2">אין סגירה אוטומטית בגלל זמן. יש מנגנון של סגירה מחוסר מעש לפי <a class="text-brand underline" href="https://www.btl.gov.il/Laws1/002_0063_100000.pdf">תקנה 126</a>, בתנאים ובהחלטה</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="text-sm">מקור: <a href={SERVICE}>רשות האכיפה והגבייה — בקשה לסגירת תיק או הסרת חייב מתיק</a>.</p>

  <h2 id="form-406">טופס 406 — איך ממלאים ומגישים</h2>
  <ol class="step-list">
    <li><span class="step-num">1</span><span><strong>מורידים את <a href={FORM_406}>טופס 406 — בקשה לסגירת תיק הוצאה לפועל</a></strong> (בקשה מספר 71). אם מגישים באזור האישי, לא צריך את הטופס עצמו.</span></li>
    <li><span class="step-num">2</span><span><strong>מציינים את סיבת הסגירה:</strong> פירעון מלא, הסדר עם הזוכה, החלטה שיפוטית או סיבה אחרת. מסבירים בכמה משפטים.</span></li>
    <li><span class="step-num">3</span><span><strong>מצרפים אסמכתאות:</strong> קבלות, אישור תשלום, ההסכם עם הזוכה או ההחלטה.</span></li>
    <li><span class="step-num">4</span><span><strong>מגישים</strong> באזור האישי, בדוא"ל או בפקס ללשכה, בדואר, או בלשכה בזימון תור. ההגשה חינם.</span></li>
    <li><span class="step-num">5</span><span><strong>עוקבים אחרי ההחלטה</strong> באזור האישי. מומלץ להירשם לעדכונים ב-SMS או בדוא"ל.</span></li>
  </ol>

  <h2 id="creditor">בקשת זוכה לסגירת תיק</h2>
  <p>הזוכה רשאי לבקש לסגור את התיק. בדרך כלל זה קורה אחרי שהחוב שולם או אחרי שהגעתם להסכם. כשמגיעים להסדר עם עורך הדין של הזוכה, כדאי לכלול בהסכם התחייבות שלו להגיש בקשה לסגירת התיק ולביטול כל ההליכים וההגבלות, ובתוך כמה ימים. אחרי כן בודקים באזור האישי שהבקשה הוגשה ושניתנה החלטה. <a href="/guides/hisdurim-chov/">איך מנהלים משא ומתן על הסדר חוב</a>.</p>

  <h2 id="check-balance">לפני שמשלמים "את הכול": בדקו את היתרה המדויקת</h2>
  <p>היתרה בתיק כוללת קרן, ריבית והוצאות, ולכן היא כמעט תמיד גבוהה מהסכום המקורי. לפני תשלום הסגירה, הורידו דף חשבון עדכני מהאזור האישי, או בררו את היתרה בצ'אט האוטומטי או במוקד ‎*35592. תשלום של הקרן בלבד לא יסגור את התיק. <a href="/guides/ribit-hotzaa/">ריבית בהוצאה לפועל</a> · <a href="https://www.gov.il/he/service/duty-payments-and-execution-expenses">דרכי תשלום רשמיות</a>.</p>

  <h2 id="after">אחרי הסגירה: מה לבדוק</h2>
  <ul>
    <li><strong>החלטת הסגירה:</strong> הורידו ושמרו אותה מהאזור האישי.</li>
    <li><strong>עיקולים:</strong> ודאו שהבנק או המעסיק הסירו את העיקול. אם לא, הציגו להם את ההחלטה ובדקו מול מוקד הרשות שההודעה נשלחה.</li>
    <li><strong>הגבלות:</strong> הגבלות כמו עיכוב יציאה או הגבלת דרכון מוטלות ברמת התיק. אם אותה הגבלה קיימת בתיק אחר שעדיין פתוח, היא תמשיך לחול. <a href="/guides/bitul-hagbalot/">ביטול הגבלות</a>.</li>
    <li><strong>תיקים נוספים:</strong> הפיקו רשימת תיקים כדי לוודא שלא נשאר תיק פתוח אחר. <a href="/guides/bdika-tik/#case-report">רשימת תיקים</a>.</li>
    <li><strong>נתוני אשראי:</strong> סגירת התיק לא מוחקת מיד את היסטוריית האשראי. בירור או תיקון מידע נעשים בערוצי מערכת נתוני האשראי של בנק ישראל.</li>
  </ul>
  <p>צריכים להראות לגורם כלשהו שאין נגדכם תיקים פתוחים? רשימת התיקים באזור האישי מציגה את כל התיקים הפתוחים נגדכם. אם מבקשים מכם "אישור העדר תיקים" בנוסח מסוים, בררו מול הגורם המבקש ומול מוקד הרשות איזה מסמך מתאים.</p>

  <h2 id="rejected">הבקשה לסגירה נדחתה?</h2>
  <p>קראו את הנימוקים. לרוב חסרה אסמכתה, או שהזוכה טוען שנשארה יתרה. אפשר להשלים מסמכים, להגיש טענת "פרעתי" עם תצהיר, ובמקרה הצורך לבדוק <a href="/guides/irur-hotzaa/">ערעור על החלטת רשם</a> במועד. עד שהתיק נסגר, אל תניחו שהגבייה נעצרה. אם יש פעולה קרובה, בקשו עיכוב.</p>

  <h2 id="faq">שאלות נפוצות על סגירת תיק</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
