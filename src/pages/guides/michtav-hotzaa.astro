const faqs = [
  {
    "q": "האם חייבים להגיב בתוך 20 ימים לכל מכתב?",
    "a": "לא. המועד תלוי במסמך ובסוג ההליך. בהתנגדות לשטר או לתביעה על סכום קצוב המועד הרגיל הוא 30 ימים מהמצאת האזהרה. יש לבדוק את ההוראות הספציפיות מיד.",
    "source": "https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf"
  },
  {
    "q": "שילמתי את החוב — אפשר להתעלם?",
    "a": "לא כדאי להניח שהתשלום עודכן. יש לבדוק את היתרה והמסמכים, להגיש אסמכתאות ובמידת הצורך לבדוק טענת פרעתי או בקשה לסגירה.",
    "source": "https://www.gov.il/he/service/debt_repayment_argument"
  },
  {
    "q": "האם בקשת תשלומים עוצרת גבייה?",
    "a": "אין הבטחה לעיכוב גורף מעצם הגשת הבקשה. צריך לבדוק החלטות ועיכוב או ביטול של ההליך הרלוונטי בנפרד.",
    "source": "https://www.gov.il/he/service/delay_processes"
  },
  {
    "q": "איפה בודקים אם המכתב אמיתי?",
    "a": "נכנסים עצמאית לאתר רשות האכיפה והגבייה ומשם לאזור האישי, או פונים למוקד הרשמי. אין למסור נתונים או לשלם בקישור לא מוכר.",
    "source": "https://www.gov.il/he/Departments/Topics/execution"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
