  },
  {
    "label": "הנחיות התנגדות — טופס 218",
    "href": "https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf"
  },
  {
    "label": "טענת פרעתי",
    "href": "https://www.gov.il/he/service/debt_repayment_argument"
