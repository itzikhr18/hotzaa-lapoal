---
import GuideLayout from '../../layouts/GuideLayout.astro';

const SERVICE = 'https://www.gov.il/he/service/request_for_consolidation_portfolio';

const faqs = [
  {
    q: 'מה זה איחוד תיקים בהוצאה לפועל?',
    a: 'בקשה של חייב שיש נגדו כמה תיקים לאחד אותם לתיק אחד, עם תשלום חודשי אחד שקובע הרשם. הסכום מתחלק בין הזוכים לפי גובה החוב בכל תיק, וכל הבקשות וההליכים בתיקים שנכללו מתנהלים מאז בתיק האיחוד.',
    source: SERVICE,
  },
  {
    q: 'כמה משלמים בתיק איחוד?',
    a: 'את הסכום קובע הרשם. לפי רשות האכיפה והגבייה, התשלום החודשי בתיק איחוד הוא לפחות 3% מהסכום הכולל של כל החובות. לכן, למשל, בחוב כולל של 60,000 ₪ התשלום יהיה לפחות 1,800 ₪ בחודש.',
    source: 'https://www.gov.il/he/service/request-change-payment-arrangement-222',
  },
  {
    q: 'לכמה זמן פורסים חוב באיחוד תיקים?',
    a: 'חוב של עד 100,000 ₪ — 3 שנים. חוב גבוה מזה — 4 שנים. הרשם רשאי להאריך בעד 3 שנים נוספות, עד 6 שנים (72 תשלומים) או 7 שנים (84 תשלומים).',
    source: SERVICE,
  },
  {
    q: 'אילו תיקים לא נכנסים לאיחוד?',
    a: 'תיקי מזונות (כולל מזונות ביטוח לאומי), כל סוגי תיקי המשכון והמשכנתה, שטרות ותביעות על סכום קצוב שהוגשה בהם התנגדות, פינוי והשבת מיטלטלין, תיקים לפי פקודת המסים (גבייה), מימוש נכסים בהוראת משקם ותיקי ביצוע הליך. התיקים האלה ממשיכים להתנהל כרגיל.',
    source: SERVICE,
  },
  {
    q: 'האם אפשר לבטל איחוד תיקים או לצרף תיק חדש?',
    a: 'כן. בקשה לצירוף תיק פרטני לתיק איחוד או לביטול האיחוד מגישים בטופס 235. תיק איחוד נסגר רק בהחלטת הרשם. כדי לפתוח מחדש תיק איחוד שנסגר מגישים טופס בקשה כללית בלשכה שבה מתנהלים רוב התיקים.',
    source: SERVICE,
  },
  {
    q: 'האם צריך לשלם כדי שהבקשה תטופל?',
    a: 'כן. לפי דף השירות, מיד אחרי הגשת הבקשה הלשכה מפיקה שובר לתשלום, והתשלום הוא תנאי לטיפול. רק אחרי התשלום הראשון הבקשה עוברת לגורם השיפוטי שקובע את הסכום החודשי. בנוסף, טופס 7 צריך להיחתם בפני עורך דין או עובד לשכה מוסמך, וזה כרוך באגרה.',
    source: SERVICE,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'רשות האכיפה והגבייה — בקשה לאיחוד יזום של תיקים', href: SERVICE },
  { label: 'רשות האכיפה והגבייה — בקשה לצירוף תיק פרטני לתיק איחוד', href: 'https://www.gov.il/he/service/consolidate_files_request' },
  { label: 'רשות האכיפה והגבייה — הסדר תשלומים (כולל כלל 3% בתיק איחוד)', href: 'https://www.gov.il/he/service/request-change-payment-arrangement-222' },
  { label: 'רשות האכיפה והגבייה — מידע לחייבים (קוד 73 באזור האישי)', href: 'https://www.gov.il/he/pages/execution_debtors_guide' },
  { label: 'חוק ההוצאה לפועל', href: 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf' },
];

const relatedGuides = [
  { title: 'צו תשלומים', href: '/guides/tzav-tashlumim/' },
  { title: 'חקירת יכולת', href: '/guides/hakirat-yecholet/' },
  { title: 'בדיקת תיק ורשימת תיקים', href: '/guides/bdika-tik/' },
  { title: 'חייב מוגבל באמצעים', href: '/guides/hayav-mugbal/' },
  { title: 'חדלות פירעון', href: '/insolvency/' },
  { title: 'ביטול עיקול', href: '/guides/bitul-ikul/' },
];
---

<GuideLayout
  title="איחוד תיקים בהוצאה לפועל: תנאים, תשלום של 3% ותקופת פריסה"
  description="מה זה איחוד תיקים יזום בהוצאה לפועל: כמה משלמים (לפחות 3% מסך החובות), פריסה ל-3–7 שנים, אילו תיקים לא נכללים, טופס 7 ושאלון 529, הגשה באזור האישי (קוד 73), ביטול איחוד וצירוף תיק חדש."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: 'איחוד תיקים', href: '/guides/ichud-tikim/' }]}
  publishDate="2025-02-10"
  updateDate="2026-10-05"
  readTime="8 דקות"
  sources={sources}
  relatedGuides={relatedGuides}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> איחוד תיקים מאחד את רוב תיקי ההוצאה לפועל שלכם לתיק אחד, עם תשלום חודשי אחד שקובע הרשם. התשלום הוא לפחות 3% מסך כל החובות, והוא מתחלק בין הזוכים.</p>
    <p class="mb-0">פורסים את החוב ל-3 שנים (או 4 בחוב מעל 100,000 ₪), עם אפשרות להארכה עד 6–7 שנים. מגישים בטופס 7 עם שאלון 529, או באזור האישי בקוד 73. <a href={SERVICE}>דף השירות הרשמי</a>.</p>
  </div>

  <p>כשיש נגדכם כמה תיקים, כל זוכה רודף אחרי הכסף שלו בנפרד: עיקול כאן, בקשה שם, ריבית שרצה בכל תיק. איחוד תיקים מכניס את כולם תחת קורת גג אחת. יש תיק אחד, תשלום אחד, ורשם אחד שמחליט. אבל זה לא מתאים לכל אחד, וחשוב להבין מה נכנס, כמה זה עולה ומה קורה אם לא עומדים בתשלומים.</p>

  <h2 id="what">איך עובד איחוד תיקים?</h2>
  <ul>
    <li><strong>מגישים בקשה אחת</strong> ומציעים סכום חודשי.</li>
    <li><strong>הרשם קובע את התשלום החודשי.</strong> לפי הרשות הוא לפחות 3% מסך כל החובות הכלולים.</li>
    <li><strong>הכסף מתחלק בין הזוכים</strong> באופן יחסי לגובה החוב בכל תיק.</li>
    <li><strong>כל הבקשות וההליכים</strong> בתיקים שנכללו מתנהלים מאז בתיק האיחוד, גם בקשות של הזוכים.</li>
    <li><strong>בתום התקופה שקבע הרשם</strong> בוחנים שוב אם אתם עומדים בתוכנית הפירעון.</li>
  </ul>

  <h2 id="payment">כמה משלמים — וכמה זמן?</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">סך החובות בתיקים</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">פריסה רגילה</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">עם הארכה של הרשם</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">עד 100,000 ₪</td>
          <td class="border border-gray-300 px-4 py-2">3 שנים (36 תשלומים)</td>
          <td class="border border-gray-300 px-4 py-2">עד 6 שנים (72 תשלומים)</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2">מעל 100,000 ₪</td>
          <td class="border border-gray-300 px-4 py-2">4 שנים (48 תשלומים)</td>
          <td class="border border-gray-300 px-4 py-2">עד 7 שנים (84 תשלומים)</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p><strong>הכלל של 3%:</strong> לפי רשות האכיפה והגבייה, התשלום החודשי בתיק איחוד הוא לפחות 3% מהסכום הכולל של כל החובות. בחוב כולל של 60,000 ₪ זה לפחות 1,800 ₪ בחודש. בחוב של 150,000 ₪ — לפחות 4,500 ₪. מקור: <a href="https://www.gov.il/he/service/request-change-payment-arrangement-222">דף השירות להסדר תשלומים</a>.</p>
  <p>אם הסכום הזה גבוה ממה שאתם יכולים לשלם, איחוד כנראה לא הפתרון. הרשות עצמה מציינת שאם אי אפשר לשלם בתקופות האלה, ייתכן שכדאי לשקול <a href="/insolvency/">חדלות פירעון</a>. אפשרות נוספת היא <a href="/guides/tzav-tashlumim/">צו תשלומים</a> נפרד בכל תיק.</p>

  <h2 id="excluded">אילו תיקים לא נכנסים לאיחוד?</h2>
  <p>לפי דף השירות, התיקים הבאים <strong>לא יצורפו</strong> לתיק האיחוד וימשיכו להתנהל כרגיל:</p>
  <ul>
    <li>כל סוגי תיקי המזונות: פסק דין כספי מסוג מזונות ותיק מזונות של ביטוח לאומי.</li>
    <li>כל סוגי תיקי המשכון: משכון רכב, משכון או משכנתה על דירת מגורים, משכון מקרקעין ומשכון אחר.</li>
    <li>תיקי שטרות ותביעות על סכום קצוב שהוגשה בהם התנגדות.</li>
    <li>פסק דין לפינוי או להשבת מיטלטלין.</li>
    <li>תיקים לפי פקודת המסים (גבייה).</li>
    <li>מימוש נכסים בהוראת משקם, ותיקי ביצוע הליך.</li>
  </ul>
  <p>לכן, לפני שמגישים, כדאי להפיק רשימת תיקים ולסמן אילו מהם ייכנסו. <a href="/guides/bdika-tik/#case-report">איך מפיקים רשימת תיקים, ומה חשוב לדעת לפני</a>.</p>

  <h2 id="how">איך מגישים בקשה לאיחוד תיקים</h2>
  <ol class="step-list">
    <li><span class="step-num">1</span><span><strong>מפיקים רשימת תיקים עדכנית</strong> מהאזור האישי. צריך לצרף אותה לבקשה.</span></li>
    <li><span class="step-num">2</span><span><strong>ממלאים טופס 7 — "בקשת חייב לאיחוד תיקים"</strong>, ומציעים סכום חודשי. את הטופס חותמים בפני עורך דין או בפני עובד לשכת הוצאה לפועל שהוסמך לכך. החתימה על התצהיר כרוכה באגרה לפי טבלת האגרות.</span></li>
    <li><span class="step-num">3</span><span><strong>ממלאים טופס 529 — שאלון וכתב ויתור על סודיות</strong>, ומצרפים את המסמכים על המצב הכלכלי שהשאלון מבקש. אם חסר מסמך, כותבים למה.</span></li>
    <li><span class="step-num">4</span><span><strong>מצרפים צילום תעודת זהות עם ספח.</strong> בתעודה ביומטרית — שני הצדדים.</span></li>
    <li><span class="step-num">5</span><span><strong>מגישים.</strong> באזור האישי מגישים בקוד בקשה 73 בלי לצרף את הטופס עצמו, אבל עם נימוקים ומסמכים. חייבים שאינם מיוצגים יכולים להגיש גם בדוא"ל, בפקס או בדואר. שולחים ללשכה שבה מתנהלים רוב התיקים, ובתוכה — לתיק שבו החוב הגבוה ביותר. אפשר גם בלשכה, בזימון תור מראש.</span></li>
    <li><span class="step-num">6</span><span><strong>משלמים את השובר.</strong> אחרי ההגשה הלשכה מפיקה שובר. התשלום הוא תנאי לטיפול, ורק אחרי התשלום הראשון הבקשה עוברת לגורם השיפוטי שקובע את הסכום החודשי.</span></li>
  </ol>
  <p class="text-sm">לפי דף השירות, בקשה שנשלחה בדוא"ל, בפקס או בדואר מתעדכנת בתיק תוך 7 ימי עסקים, ונקבע לה יעד טיפול של 45 ימי עסקים. מקור: <a href={SERVICE}>בקשה לאיחוד יזום של תיקים</a>.</p>

  <h2 id="after">מה קורה אחרי שהאיחוד אושר?</h2>
  <ul>
    <li><strong>משלמים תשלום חודשי אחד לתיק האיחוד</strong>, בתאריך שנקבע בהחלטה.</li>
    <li><strong>נפתח תיק חדש נגדכם?</strong> מגישים בקשה לצירוף תיק פרטני לתיק האיחוד, בטופס 235. אם הבקשה מאושרת, הרשם רשאי לשנות את הסכום החודשי. <a href="https://www.gov.il/he/service/consolidate_files_request">דף השירות לצירוף תיק</a>.</li>
    <li><strong>עיקולים קיימים</strong> לא נמחקים אוטומטית עם הגשת הבקשה. כשמשלמים בקביעות, אפשר לבקש הכרה כ"חייב משלם" גם בתיק איחוד. <a href="/guides/bitul-ikul/">ביטול ועיכוב עיקולים</a>.</li>
    <li><strong>רוצים לצאת מהאיחוד?</strong> ביטול איחוד מגישים בטופס 235. תיק איחוד נסגר רק בהחלטת הרשם.</li>
  </ul>

  <h2 id="fit">למי איחוד תיקים מתאים — ולמי פחות?</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מתאים כש...</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">פחות מתאים כש...</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">יש כמה תיקים שנכללים באיחוד, ועיקולים מכמה כיוונים</td>
          <td class="border border-gray-300 px-4 py-2">רוב החוב בתיקי מזונות, משכנתה או מסים, שלא נכללים באיחוד</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2">אפשר לעמוד בתשלום של לפחות 3% מסך החובות</td>
          <td class="border border-gray-300 px-4 py-2">גם 3% גבוה מדי. אז כדאי לבדוק חדלות פירעון</td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">רוצים תשלום אחד ותיק אחד במקום ניהול של הרבה תיקים</td>
          <td class="border border-gray-300 px-4 py-2">יש תיק אחד בלבד. אז צו תשלומים פשוט יותר</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="faq">שאלות נפוצות על איחוד תיקים</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
