---
import GuideLayout from '../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "האם איחוד תיקים מוחק חובות?",
    "a": "לא. הוא מסדיר תשלום וניהול של התיקים הכלולים. החובות אינם נמחקים מעצם האיחוד.",
    "source": "https://www.gov.il/he/service/request_for_consolidation_portfolio"
  },
  {
    "q": "האם אפשר לכלול מזונות ביטוח לאומי?",
    "a": "לא. השירות הרשמי מחריג את כל סוגי תיקי המזונות, לרבות מזונות ביטוח לאומי.",
    "source": "https://www.gov.il/he/service/request_for_consolidation_portfolio"
  },
  {
    "q": "האם האיחוד עוצר כל עיקול?",
    "a": "הגשת בקשת איחוד אינה מפסיקה הליכים מעצמה. גם לאחר צו יש לבדוק את היקפו; תיקים מוחרגים ממשיכים בנפרד ולא כל רישום מתבטל.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "q": "האם תמיד ניתן לפרוס לשבע שנים?",
    "a": "לא. תקופות הבסיס הן 3 או 4 שנים לפי סכום החוב; הארכה בעד 3 שנים נוספות נתונה להחלטת הרשם ולתנאים, ולא ניתנת אוטומטית.",
    "source": "https://www.gov.il/he/service/request_for_consolidation_portfolio"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "בקשה לאיחוד יזום — רשות האכיפה",
    "href": "https://www.gov.il/he/service/request_for_consolidation_portfolio"
  },
  {
    "label": "חוק ההוצאה לפועל — איחוד תיקים",
    "href": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "label": "עיכוב הליכים",
    "href": "https://www.gov.il/he/service/delay_processes"
  }
];
---

<GuideLayout
  title="איחוד תיקים בהוצאה לפועל — תנאים, מסמכים ותקופות פירעון"
  description="מה נכלל באיחוד יזום, אילו תיקים מוחרגים, תקופות 3–4 שנים והארכה לפי החלטה, טופס 7 ושאלון 529 ומה קורה להליכים."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "איחוד תיקים", href: "/guides/ichud-tikim/" }]}
  publishDate="2025-02-10"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>איחוד תיקים מרכז תיקים שניתן לכלול בו לתשלום חודשי אחד; הוא לא מוחק חוב ולא כולל כל תיק.</strong> רשם ההוצאה לפועל בוחן את הבקשה והיכולת לפרוע בתקופות שבדין. <a href="https://www.gov.il/he/service/request_for_consolidation_portfolio">השירות הרשמי לאיחוד יזום</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>תקופות הפירעון</h2>
  <p>דף השירות מפרט פריסה של 3 שנים לחוב שאינו עולה על 100,000 ש״ח, ו-4 שנים לחוב העולה על סכום זה. לרשם סמכות להאריך בעד 3 שנים נוספות — עד 6 או 7 שנים בהתאמה. הארכה אינה אוטומטית: היא תלויה בשיקול דעת וביכולת לעמוד בתוכנית. <a href="https://www.gov.il/he/service/request_for_consolidation_portfolio">תנאי הפריסה</a>.</p>
  <h2>מה לא מצטרף לאיחוד?</h2>
  <p>השירות מחריג, בין היתר, תיקי מזונות לרבות מזונות ביטוח לאומי, כל סוגי המשכון והמשכנתה, תיקי שטרות ותביעות על סכום קצוב שהוגשה בהם התנגדות, פינוי והשבת מיטלטלין, תיקי פקודת המסים (גבייה), מימוש בהוראת משקם ותיקי ביצוע הליך. לכן ״חוב לביטוח לאומי״ או ״חוב למדינה״ אינם אישור כללי לצירוף. <a href="https://www.gov.il/he/service/request_for_consolidation_portfolio">הרשימה המלאה בשירות הרשמי</a>.</p>
  <h2>מסמכים והגשה</h2>
  <p>לפי השירות נדרשים טופס 7, רשימת תיקים עדכנית, טופס 529 — שאלון וכתב ויתור על סודיות — ומסמכי מצב כלכלי וזיהוי. בהגשה באזור האישי חלות הנחיות ייעודיות לגבי הטופס. יש לבדוק את הדרישה לאימות ואת ערוץ ההגשה בהתאם לייצוג. <a href="https://www.gov.il/he/service/request_for_consolidation_portfolio">הוראות וצרופות</a>.</p>
  <p>יש גם דרישה לתשלום לאחר הגשת הבקשה והפקת שובר, כתנאי לטיפול; אין להסתפק בשליחת טופס או להניח שסכום משוער ברשת הוא הדרישה בתיק. שומרים אישור הגשה ותשלום ועוקבים אחרי השלמות והחלטות.</p>
  <h2>האם ההגשה או האישור מקפיאים את כל העיקולים?</h2>
  <p><strong>הגשת בקשת איחוד אינה כשלעצמה הפסקת הליכים.</strong> אחרי צו איחוד ניהול ההליכים בתיקים הכלולים נעשה במסגרת האיחוד ובהתאם לצו ולדין; זה אינו ביטול אוטומטי של כל רישום וכל עיקול. תיקים שאינם נכללים ממשיכים להתנהל בנפרד. <a href="https://www.btl.gov.il/Laws1/00_0063_000000.pdf">פרק איחוד תיקים בחוק</a>.</p>
  <p>אם קיימת פעולה קרובה, בודקים צורך ב<a href="https://www.gov.il/he/service/delay_processes">בקשה לעיכוב</a>. אין להסיק מהאיחוד שמותר לצאת מהארץ או שניתן לבצע פעולה בנכס מעוקל; בודקים את ההגבלות וההחלטות בנפרד.</p>
  <h2>תשלום שוטף ותיק חדש</h2>
  <p>משלמים לפי הצו ובודקים קליטה. שינוי ביכולת מצריך בקשה ותיעוד, לא שינוי חד־צדדי. אם נפתח תיק נוסף, השירות מפנה לבקשה לצירוף תיק פרטני; הוא אינו מצטרף בהכרח מעצמו והרשם רשאי לשנות את התשלום. סגירת תיק האיחוד היא בהחלטת רשם. <a href="https://www.gov.il/he/service/request_for_consolidation_portfolio">המשך הטיפול</a>.</p>
  <h2>אם אין אפשרות לפירעון בתקופות אלו</h2>
  <p>צריך לבדוק חלופות לפי כלל הנתונים, לרבות <a href="/guides/pshitat-regel/">חדלות פירעון ושיקום כלכלי</a>. איחוד אינו מסלול הפטר, וחדלות פירעון אינה הבטחה למחיקת כל חוב. כדאי לברר את ההשלכות והזכאות במקום לבחור רק לפי גובה התשלום החודשי.</p>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
