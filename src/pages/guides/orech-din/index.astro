---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    "q": "האם חייבים עורך דין לכל בקשה?",
    "a": "לא. קיימים ערוצים רשמיים למי שאינם מיוצגים. צריך לבדוק את דרישות ההליך ומורכבותו ולא להניח שכל בקשה פשוטה.",
    "source": "https://www.gov.il/he/service/appointment-to-execution-bureau"
  },
  {
    "q": "מי זכאי לסיוע משפטי?",
    "a": "הזכאות נבדקת לפי תנאי השירות והנושא, לרבות מבחנים כלכליים ומשפטיים כאשר הם חלים וחריגים. אין סף אחד לכל אדם.",
    "source": "https://www.gov.il/he/service/legal_aid_application"
  },
  {
    "q": "האם בקשת סיוע מאריכה מועד?",
    "a": "אין להניח הארכה מעצם הבקשה. יש לבדוק בנפרד את ההליך והמועד ואת הצורך בבקשה מתאימה.",
    "source": "https://www.gov.il/he/service/legal_aid_application"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
const sources = [
  {
    "label": "בקשה לסיוע משפטי",
    "href": "https://www.gov.il/he/service/legal_aid_application"
  },
  {
    "label": "רשות האכיפה — פנייה למי שאינם מיוצגים",
    "href": "https://www.gov.il/he/service/appointment-to-execution-bureau"
  },
  {
    "label": "בקשה לצו תשלומים",
    "href": "https://www.gov.il/he/service/request-change-payment-arrangement-222"
  }
];
---

<GuideLayout
  title="עורך דין בהוצאה לפועל — ייצוג עצמי, סיוע משפטי והכנה"
  description="מתי אפשר להגיש לבד, מתי נדרש בירור מקצועי, איך בודקים זכאות לסיוע ומה מסכמים בכתב על היקף הייצוג והעלות."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: "ייצוג וסיוע משפטי", href: "/guides/orech-din/" }]}
  publishDate="2026-03-31"
  updateDate="2026-09-13"
  readTime="5 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box"><p><strong>יש ערוצי הגשה למי שאינם מיוצגים, אך אפשרות להגיש לבד אינה הבטחה שההליך פשוט.</strong> בחירת הייצוג תלויה בסוג הבעיה, במועדים ובהשלכות — לא בכלל של ״10% מהחוב״. <a href="https://www.gov.il/he/service/appointment-to-execution-bureau">שירות הרשות למי שאינם מיוצגים</a>.</p></div>
  <p class="text-sm">מידע כללי שנערך מול המקורות הרשמיים המצוינים בעמוד; אינו ייעוץ משפטי או בדיקה של תיק אישי. הוראות הדין, האזהרה וההחלטות בתיק גוברות. כשיש מועד קרוב או הליך דחוף, יש לבדוק את המסלול המתאים ללא דיחוי.</p>
  <h2>מה אפשר לבצע באופן עצמאי?</h2><p>בדיקת תיק ובקשות רבות זמינות בערוצים הרשמיים למי שאינם מיוצגים, בכפוף למסמכים ולדרישות. משתמשים בשירות הייעודי: למשל <a href="https://www.gov.il/he/service/request-change-payment-arrangement-222">צו תשלומים בטופס 233</a>, לא טופס 517 שהוזכר כאן בעבר.</p>
  <h2>מתי חשוב לקבל בדיקה מקצועית?</h2><p>כשקיים מועד קרוב, מכירת נכס, פינוי, מחלוקת על המצאה או בעלות, ערבות, ערעור או שאלת סמכות. הסכום לבדו אינו קובע מורכבות; גם תיק קטן עשוי לכלול טענה או מועד מהותיים.</p>
  <h2>סיוע משפטי ממשלתי</h2><p>ניתן להגיש בקשה לסיוע; הזכאות נבחנת לפי הנושא, מבחנים כלכליים וסיכוי משפטי כאשר הם חלים, וחריגים. אין סף הכנסה נטו אחיד לכל מבקש. את המסמכים והעלות, אם חלה, בודקים ב<a href="https://www.gov.il/he/service/legal_aid_application">דף השירות העדכני</a>. הגשת בקשת סיוע אינה מאריכה כשלעצמה מועד בתיק.</p>
  <h2>עלות והיקף השירות</h2><p>אין מחירון שוק מאומת בעמוד. מבקשים הסכם שכר טרחה בכתב שמבהיר את ההליך הכלול, הוצאות ואגרות, תשלומים, דיונים וערעורים שאינם כלולים ומי עוקב אחרי מועדים. אין הבטחה שהייצוג יחסוך שיעור מסוים מהחוב או ישיג מחיקה.</p>
  <h2>מה להכין לפגישה?</h2><ul><li>אזהרה, החלטות ומועדי המצאה.</li><li>מסמך החוב ופירוט יתרה.</li><li>אסמכתאות לתשלום והתכתבויות.</li><li>פרטי הליכים קרובים ושאלות ממוקדות.</li><li>מסמכים כלכליים כאשר בודקים פריסה או סיוע.</li></ul>
  <h2>בדיקת התאמה ומעקב</h2><p>מבררים ניסיון בסוג ההליך, זהות מי שמטפל, זמינות למועד הקרוב והיקף הרשאה. ייעוץ נקודתי שונה מייצוג מלא. גם בייצוג שומרים עותקים ואישורי הגשה. <a href="/guides/irur-hotzaa/">ערעורים ומועדים</a>; <a href="/guides/hitnagdut-letik/">התנגדות</a>.</p>
  <h2 id="faq">שאלות נפוצות</h2>
  <div class="space-y-4 my-6">
    {faqs.map(faq => (
      <details class="border border-neutral-border rounded-xl p-4">
        <summary class="font-semibold cursor-pointer">{faq.q}</summary>
        <p>{faq.a}</p>
        <p><a href={faq.source}>המקור הרשמי לתשובה</a></p>
      </details>
    ))}
  </div>
</GuideLayout>
