const KZ_CLAIM = 'https://www.kolzchut.org.il/he/%D7%AA%D7%91%D7%99%D7%A2%D7%94_%D7%A2%D7%9C_%D7%A1%D7%9B%D7%95%D7%9D_%D7%A7%D7%A6%D7%95%D7%91_%D7%91%D7%94%D7%95%D7%A6%D7%90%D7%94_%D7%9C%D7%A4%D7%95%D7%A2%D7%9C';
