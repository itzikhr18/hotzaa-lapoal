const DELAY = 'https://www.gov.il/he/service/delay_processes';
const LEGAL_AID = 'https://www.gov.il/he/service/legal_aid_application';

const faqs = [
  {
    q: 'כמה זמן יש להגיש התנגדות בהוצאה לפועל?',
    a: '30 ימים מיום המצאת האזהרה, גם בתיק שטרות (צ\'ק או שטר חוב) וגם בתיק תביעה על סכום קצוב. כך קובעים סעיפים 81א(ג1) ו־81א1(ה)(1) לחוק ההוצאה לפועל.',
    source: LAW,
  },
  {
    q: 'מה זה טופס 218?',
    a: 'טופס 218 הוא "טופס לבקשת התנגדות לביצוע שטר או תובענה" של רשות האכיפה והגבייה. בוחרים בו את סוג הבקשה: התנגדות לביצוע שטר (קוד 105), התנגדות לביצוע תביעה (קוד 106), או אותן בקשות יחד עם בקשה להארכת מועד (קודים 135 ו־136). מצרפים תצהיר ומסמכים.',
    source: FORM218,
  },
  {
    q: 'האם ההתנגדות עוצרת את הגבייה?',
    a: 'אם הוגשה במועד ובצירוף תצהיר — כן. לפי החוק, רשם ההוצאה לפועל מעכב את הביצוע ומעביר את העניין לבית המשפט. התנגדות שהוגשה באיחור לא מעכבת את ההליכים אוטומטית, ולכן מצרפים אליה גם בקשה לעיכוב הליכים.',
    source: LAW,
  },
  {
    q: 'מה עושים אם עברו 30 הימים?',
    a: 'מגישים את ההתנגדות יחד עם בקשה להארכת מועד ותצהיר שמסביר את האיחור (קוד 135 בשטר, 136 בתביעה), ובקשה לעיכוב הליכים. לפי הרשות, על בקשה נלווית כמו בקשה לעיכוב הליכים משלמים אגרה, ובלי תשלום היא לא תטופל. לפי כל זכות, בית המשפט מחליט קודם בבקשת ההארכה, ואם היא נדחית ההתנגדות לא תידון.',
    source: KZ_NOTE,
  },
  {
    q: 'שילמתי כבר את החוב. מגישים התנגדות?',
    a: 'תלוי במקרה. יש שני מסלולים: טענת "פרעתי" (טופס 236, קוד בקשה 119, עם תצהיר ואסמכתאות), או התנגדות בתוך 30 ימים מהאזהרה, שבה "החוב שולם" יכול להיות טענת הגנה. אם החוב שולם לפני שנפתח התיק ויש לכם גם טענות אחרות, אל תפספסו את מועד ההתנגדות.',
    source: PAID,
  },
  {
    q: 'אפשר להגיש התנגדות לפסק דין?',
    a: 'לא. התנגדות בהוצאה לפועל קיימת רק בתיקי שטרות ובתביעה על סכום קצוב. פסק דין של בית משפט תוקפים בבית המשפט — בבקשה לביטול פסק הדין או בערעור, לפי המקרה ובמועדים של אותו הליך.',
    source: LAW,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'חוק ההוצאה לפועל — סעיפים 81א ו־81א1', href: LAW },
  { label: 'טופס 218 — בקשת התנגדות לביצוע שטר או תובענה', href: FORM218 },
