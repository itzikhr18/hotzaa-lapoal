  { label: 'רשות האכיפה והגבייה — התנגדות לביצוע שטר', href: SERVICE_NOTE },
  { label: 'כל זכות — התנגדות לביצוע שטר בהוצאה לפועל', href: KZ_NOTE },
  { label: 'כל זכות — התנגדות לתביעה על סכום קצוב', href: KZ_CLAIM_OBJ },
  { label: 'כל זכות — תביעה על סכום קצוב בהוצאה לפועל', href: KZ_CLAIM },
  { label: 'רשות האכיפה והגבייה — טענת פרעתי', href: PAID },
];

const relatedGuides = [
  { title: 'קיבלתי מכתב מהוצאה לפועל', href: '/guides/michtav-hotzaa/' },
  { title: 'בדיקת תיק הוצאה לפועל', href: '/guides/bdika-tik/' },
  { title: 'טפסי הוצאה לפועל לפי מספר', href: '/forms/' },
  { title: 'התיישנות חוב', href: '/guides/hitiyashnoot-chov/' },
  { title: 'צו תשלומים', href: '/guides/tzav-tashlumim/' },
