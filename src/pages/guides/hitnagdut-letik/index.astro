import GuideLayout from '../../../layouts/GuideLayout.astro';

const LAW = 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf';
const FORM218 = 'https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf';
const SERVICE_CLAIM = 'https://www.gov.il/he/service/claim_objection';
const SERVICE_NOTE = 'https://www.gov.il/he/service/objection_iou_repayment';
const KZ_NOTE = 'https://www.kolzchut.org.il/he/%D7%94%D7%AA%D7%A0%D7%92%D7%93%D7%95%D7%AA_%D7%9C%D7%91%D7%99%D7%A6%D7%95%D7%A2_%D7%A9%D7%98%D7%A8_%D7%91%D7%94%D7%95%D7%A6%D7%90%D7%94_%D7%9C%D7%A4%D7%95%D7%A2%D7%9C';
