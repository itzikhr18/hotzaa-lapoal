const faqs = [
  {
    "q": "האם יש 30 ימים להתנגד לכל תיק?",
    "a": "לא. המועד הרגיל של 30 ימים מהמצאת האזהרה מתייחס להתנגדות לביצוע שטר או שיק ולתביעה על סכום קצוב. פסק דין, פרעתי וערעור הם מסלולים אחרים.",
    "source": "https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf"
  },
  {
    "q": "מה עושים אם חלף מועד ההתנגדות?",
    "a": "מגישים גם בקשה להארכת מועד עם תצהיר המנמק את האיחור. אין עיכוב אוטומטי בהגשה באיחור; אם דרוש עיכוב יש לבקש אותו לפי ההנחיות.",
    "source": "https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf"
  },
  {
    "q": "החוב שולם — האם מגישים התנגדות?",
    "a": "יש לבדוק את סוג התיק ואת מועד התשלום. מסלול פרעתי מיועד לטענה שהחיוב קוים או שאין עוד חובה לקיימו. השירות הרשמי מפנה לטופס 236, קוד בקשה 119, עם תצהיר ואסמכתאות.",
    "source": "https://www.gov.il/he/service/debt_repayment_argument"
  },
  {
    "q": "האם קבלת ההתנגדות במערכת סוגרת את התיק?",
    "a": "לא. קליטת מסמכים אינה החלטה בטענות ההגנה. ההתנגדות מועברת לבירור בבית המשפט בהתאם לדין ולהחלטות; יש לעקוב בנפרד אחר עיכוב ההליכים.",
    "source": "https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
