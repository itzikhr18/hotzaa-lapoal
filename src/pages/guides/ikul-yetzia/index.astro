---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const LAW = 'https://www.btl.gov.il/Laws1/00_0063_000000.pdf';
const CANCEL = 'https://www.gov.il/he/service/exit_order_cancel_stay';
const CHECK = 'https://www.gov.il/he/service/departure_prohibition_order_info_2';
const RESTRICT = 'https://www.gov.il/he/service/request_for_cancellation_of_restrictions';

const faqs = [
  {
    q: 'איך בודקים אם יש לי צו עיכוב יציאה מהארץ?',
    a: 'ברשות האוכלוסין וההגירה יש שירות מקוון לבדיקת עיכוב יציאה, בהזדהות לאומית ועם מספר תעודת זהות. השירות מציג רק צווים שפתוחים לעיון הציבור ולא מוסר מידע על אדם אחר. בהוצאה לפועל בודקים גם באזור האישי, בכל תיק בנפרד.',
    source: CHECK,
  },
  {
    q: 'כמה זמן לפני הטיסה צריך להגיש בקשה לביטול?',
    a: 'רשות האכיפה והגבייה ממליצה להגיש לפחות 14 ימים לפני הנסיעה. בקשה שנשלחת בדואר, בדוא"ל או בפקס נקלטת בתיק תוך 7 ימי עסקים, וההחלטה ניתנת תוך 45 יום מיום ההגשה.',
    source: CANCEL,
  },
  {
    q: 'כמה עולה להגיש בקשה לביטול עיכוב יציאה?',
    a: 'הבקשה עצמה, רגילה או דחופה, ניתנת ללא עלות. אם אין לכם החלטת בית משפט, צריך לצרף תצהיר שנחתם בפני עורך דין או עובד לשכה מוסמך, והחתימה עליו כרוכה באגרה לפי טבלת האגרות.',
    source: CANCEL,
  },
  {
    q: 'מה דורשים מהערבים?',
    a: 'לפי הרשות, בהצעת ערבים צריך לפחות שני ערבים. לכל ערב: כתב ערבות חתום בפני עובד מוסמך או עורך דין, צילום תעודת זהות עם ספח, ושלושה תלושי שכר אחרונים עם שכר חודשי של 8,000 ₪ לפחות (לעצמאי: דוח שנתי מרואה חשבון). ערב שהוא בעצמו חייב בהוצאה לפועל לא יתקבל. אם הרשם מאשר, ניתן צו עיכוב יציאה נגד הערבים עד שתחזרו לארץ.',
    source: CANCEL,
  },
  {
    q: 'הטיסה מחר — אפשר להגיש בקשה דחופה?',
    a: 'בקשה דחופה מיועדת למצב שבו נדרשת החלטה תוך 24 שעות, או שדחייה תגרום נזק בלתי הפיך. הרשות מבהירה שהפסד כספי מביטול טיסה אינו נזק מהותי בלתי הפיך שמצדיק טיפול דחוף אחרי שעות הפעילות. מקרים מוכרים: טיפול רפואי, טיפול רפואי של קרוב מדרגה ראשונה, הלוויה של קרוב מדרגה ראשונה, דיון משפטי דחוף בחו"ל ועוד. מגישים בקוד 62 באזור האישי ומעדכנים את הלשכה בטופס פנייה מקוון שהבקשה דחופה.',
    source: CANCEL,
  },
  {
    q: 'יש לי חוב קטן. אפשר לעכב לי את היציאה?',
    a: 'בצו לפי סעיף 14 לחוק — לא, אם סך החובות הפסוקים בכל תיקי ההוצאה לפועל נמוך מ-50,000 ₪. אם החובות ירדו מתחת ל-40,000 ₪, הרשם יבטל את הצו לבקשתכם. אבל זה לא חל על חוב מזונות, ולא על עיכוב יציאה שהוטל כהגבלה על חייב משתמט או בעקבות בקשה לאיחוד תיקים — שם הכללים אחרים.',
    source: LAW,
  },
  {
    q: 'הגשתי בקשה לאיחוד תיקים ופתאום יש לי עיכוב יציאה. למה?',
    a: 'לפי סעיף 74ד לחוק ההוצאה לפועל, כשמוגשת בקשת איחוד, הרשם מורה על עיכוב יציאה מהארץ. הצו מתבטל אם החובות סולקו, אם הבקשה נדחתה, אם כל הזוכים הסכימו או אם צו האיחוד בוטל. הרשם רשאי גם לבטל אותו מטעמים מיוחדים, לפי בקשה עם תצהיר ובתנאים כמו ערובה.',
    source: LAW,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'רשות האכיפה והגבייה — בקשה לביטול צו עיכוב יציאה מהארץ', href: CANCEL },
  { label: 'רשות האוכלוסין וההגירה — בדיקת עיכוב יציאה מהארץ', href: CHECK },
  { label: 'רשות האכיפה והגבייה — ביטול הגבלות על חייבים', href: RESTRICT },
  { label: 'חוק ההוצאה לפועל — סעיפים 14, 66א–66ד ו-74ד', href: LAW },
];

const relatedGuides = [
  { title: 'ביטול הגבלות', href: '/guides/bitul-hagbalot/' },
  { title: 'הגבלות על חייב', href: '/rights/hagbalot/' },
  { title: 'צו תשלומים', href: '/guides/tzav-tashlumim/' },
  { title: 'איחוד תיקים', href: '/guides/ichud-tikim/' },
  { title: 'בדיקת תיק לפי תעודת זהות', href: '/guides/bdika-tik/' },
  { title: 'מזונות בהוצאה לפועל', href: '/guides/mazamot/' },
];
---

<GuideLayout
  title="צו עיכוב יציאה מהארץ בהוצאה לפועל: איך בודקים ואיך מבטלים"
  description="איך בודקים אם יש צו עיכוב יציאה מהארץ, מתי מותר להטיל אותו (סף של 50,000 ₪), איך מבקשים ביטול בקוד 62 או בטופס 214, מה צריך מהערבים, בקשה דחופה לפני טיסה ומה קורה אחרי ההחלטה."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: 'עיכוב יציאה מהארץ', href: '/guides/ikul-yetzia/' }]}
  publishDate="2026-03-25"
  updateDate="2026-10-06"
  readTime="8 דקות"
  sources={sources}
  relatedGuides={relatedGuides}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> תשלום כל החוב בתיק שבו ניתן הצו מבטל אותו. כדי לצאת לנסיעה בלי לשלם הכול, מגישים בקשה לביטול צו עיכוב יציאה — באזור האישי בקוד 62, או בטופס 214 — עם כרטיס הטיסה, מסמכים על מטרת הנסיעה, תצהיר והצעת ערבות.</p>
    <p class="mb-0">הבקשה חינם. מומלץ להגיש לפחות 14 ימים לפני הטיסה. ובדקו את כל התיקים: ביטול בתיק אחד לא מבטל צו בתיק אחר. <a href="#cancel-request">איך מגישים</a> · <a href="#guarantors">מה צריך מהערבים</a> · <a href="#urgent">בקשה דחופה</a>.</p>
  </div>

  <h2 id="check">שלב 1: בודקים אם יש צו, ובאיזה תיק</h2>
  <ul>
    <li><strong>ברשות האוכלוסין וההגירה:</strong> <a href={CHECK}>שירות בדיקת עיכוב יציאה מהארץ</a>, בהזדהות לאומית ועם מספר תעודת זהות. השירות מציג רק צווים שפתוחים לעיון הציבור, ולא מוסר מידע על אדם אחר.</li>
    <li><strong>בהוצאה לפועל:</strong> באזור האישי, ברשימת התיקים ובכל תיק בנפרד, כדי לראות על מה מבוססת ההחלטה. <a href="/guides/bdika-tik/">איך בודקים תיקים לפי תעודת זהות</a>.</li>
    <li><strong>בודקים גם הגבלת דרכון.</strong> הרשות ממליצה לוודא מול מזכירות הלשכה שאין תיקים נוספים עם עיכוב יציאה או הגבלת דרכון.</li>
  </ul>

  <h2 id="types">שלושה מסלולים שונים לעיכוב יציאה בהוצאה לפועל</h2>
  <p>"עיכוב יציאה" בהוצאה לפועל יכול לבוא מכמה סעיפים שונים בחוק, ולכל אחד כללים משלו. כדאי לזהות מה מופיע בהחלטה שלכם:</p>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">המסלול</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מתי</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">איך מבטלים</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">צו לפי סעיף 14</td>
          <td class="border border-gray-300 px-4 py-2">יש יסוד להניח שאתם עומדים לצאת מהארץ בלי לפרוע את החוב או להבטיח אותו. <strong>לא יינתן אם סך החובות הפסוקים בכל התיקים נמוך מ-50,000 ₪</strong> (לא חל על מזונות). למי שמקיים צו תשלומים, הצו יינתן רק אם הרשם השתכנע שהיציאה עלולה לסכל את הביצוע</td>
          <td class="border border-gray-300 px-4 py-2">תשלום החוב; ביטול לבקשתכם אם החובות ירדו מתחת ל-40,000 ₪; ביטול כשהנסיעה למטרה מוצדקת, אפשר בתנאי ערובה</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">הגבלה לפי סעיף 66א</td>
          <td class="border border-gray-300 px-4 py-2">הגבלה על חייב שנקבע שהוא "בעל יכולת המשתמט מתשלום", או בחוב מזונות לפי פסק דין. נכנסת לתוקף 30 יום אחרי התראה בדואר. לא תוטל אם היציאה דרושה מטעמי בריאות שלכם או של בן משפחה התלוי בכם</td>
          <td class="border border-gray-300 px-4 py-2">תשלום החוב; <strong>הרשם חייב לבטל</strong> אם אתם מקיימים צו תשלומים או הסכם עם הזוכה. <a href="/guides/bitul-hagbalot/">ביטול הגבלות</a></td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">צו לפי סעיף 74ד</td>
          <td class="border border-gray-300 px-4 py-2">הגשתם בקשה ל<a class="text-brand underline" href="/guides/ichud-tikim/">איחוד תיקים</a>. הרשם מורה על עיכוב יציאה עם הגשת הבקשה</td>
          <td class="border border-gray-300 px-4 py-2">החובות סולקו, הבקשה נדחתה, כל הזוכים הסכימו או צו האיחוד בוטל. או בקשה עם תצהיר, מטעמים מיוחדים ובתנאים</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="text-sm">מקור: <a href={LAW}>חוק ההוצאה לפועל, סעיפים 14, 66א–66ד ו-74ד</a>. צווים של בית משפט או של רשויות אחרות, כמו רשות המסים, אינם מסלול של הוצאה לפועל ולא מטופלים כאן.</p>

  <h2 id="permanent">איך מבטלים את הצו לגמרי</h2>
  <ul>
    <li><strong>משלמים את כל החוב בתיק</strong> שבו ניתן הצו — לפי הרשות, זה מביא לביטול הצו. <a href="/guides/bdika-tik/">איך בודקים יתרה</a>.</li>
    <li><strong>מגיעים להסדר עם עורך הדין של הזוכה.</strong> אחרי ההסדר, הזוכה מגיש בקשה לביטול עיכוב היציאה. <a href="/guides/hisdurim-chov/">איך עושים הסדר חוב</a>.</li>
    <li><strong>מבקשים צו תשלומים ועומדים בו.</strong> בהגבלה לפי סעיף 66א, הרשם חייב לבטל אותה כשמקיימים צו תשלומים או הסכם עם הזוכה. אם מפסיקים לשלם, אפשר להטיל אותה מחדש בלי התראה נוספת. <a href="/guides/tzav-tashlumim/">צו תשלומים</a>.</li>
    <li><strong>החובות ירדו מתחת ל-40,000 ₪</strong> — בצו לפי סעיף 14, מגישים בקשה והרשם יבטל אותו (לא בחוב מזונות).</li>
  </ul>

  <h2 id="cancel-request">ביטול לצורך נסיעה: מה מגישים</h2>
  <p>אם אתם לא יכולים לשלם הכול לפני הנסיעה, אפשר לבקש מהרשם לבטל את הצו לתקופת הנסיעה. לפי <a href={CANCEL}>דף השירות של רשות האכיפה והגבייה</a>:</p>
  <ol class="step-list">
    <li><span class="step-num">1</span><span><strong>מכינים מסמכים על הנסיעה:</strong> כרטיס טיסה, ומסמכים על מטרת הנסיעה, היעד ומשך השהות בחו"ל. מפרטים מי מממן את הנסיעה ואת עלות השהות.</span></li>
    <li><span class="step-num">2</span><span><strong>תצהיר או החלטת בית משפט:</strong> אם יש החלטת בית משפט, מצרפים מקור או עותק "נאמן למקור", ואז לא צריך תצהיר. אחרת — תצהיר חתום בפני עורך דין או עובד לשכה מוסמך (בתשלום אגרה).</span></li>
    <li><span class="step-num">3</span><span><strong>מציעים ערבות מראש, בתוך הבקשה:</strong> ערבים (לפחות שניים) או ערבות בנקאית. <a href="#guarantors">הפרטים בהמשך</a>.</span></li>
    <li><span class="step-num">4</span><span><strong>מגישים:</strong> באזור האישי, בקשה בקוד 62, עם המסמכים ופירוט הסיבות. חייבים שאינם מיוצגים יכולים גם להגיש <a href="/forms/#form-214">טופס 214</a> בדוא"ל או בפקס ללשכה שבה מתנהל התיק, או בלשכה בזימון תור (‎*35592).</span></li>
    <li><span class="step-num">5</span><span><strong>עוקבים אחרי ההחלטה:</strong> ההחלטה ניתנת תוך 45 יום מיום ההגשה ומתעדכנת באזור האישי. אם הרשם התנה את הביטול בערבויות, צריך להשלים אותן — אחרת הצו נשאר.</span></li>
  </ol>
  <div class="tip-box">
    <p class="mb-0"><strong>תזמון:</strong> הרשות ממליצה להגיש לפחות 14 ימים לפני הנסיעה. בקשה שהוגשה באזור האישי מופיעה בתיק מיד אחרי ההגשה. לפי דף השירות, בקשה שנשלחת מתעדכנת בתיק תוך 7 ימי עסקים משליחתה, וההחלטה ניתנת תוך 45 יום.</p>
  </div>

  <h2 id="guarantors">ערבים או ערבות בנקאית: מה בדיוק דורשים</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">סוג הערבות</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מה צריך</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">ערבים (ערבות אישית)</td>
          <td class="border border-gray-300 px-4 py-2">לפחות <strong>שני ערבים</strong>. לכל ערב: כתב ערבות חתום בפני עובד הרשות המוסמך או עורך דין; צילום תעודת זהות עם ספח; <strong>שלושה תלושי שכר אחרונים עם שכר חודשי של 8,000 ₪ לפחות</strong> (לעצמאי — דוח שנתי מרואה חשבון)</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">ערבות בנקאית</td>
          <td class="border border-gray-300 px-4 py-2">על גובה החוב בתיק, או על חלק ממנו כפי שהרשם קבע; מופנית אל מערכת ההוצאה לפועל; <strong>לא מוגבלת בזמן</strong>. אם הרשם מאשר, הערבות מופקדת בלשכה</td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="warn-box">
    <p class="font-semibold mb-1">חשוב שהערבים יידעו</p>
    <p class="mb-0">ערב שהוא בעצמו חייב בהוצאה לפועל, או שאינו תושב קבע, לא יתקבל, ויידרש ערב אחר. אם הרשם מאשר את הערבים, <strong>ניתן נגדם צו עיכוב יציאה מהארץ</strong>, והם צריכים להתייצב שוב בלשכה לזיהוי. הצו נגדם מתבטל רק אחרי שמתקבל דיווח שחזרתם לארץ. בלי הדיווח, הצו נגדם נשאר, והם חשופים להליכים בגלל הערבות. מקור: <a href={CANCEL}>רשות האכיפה והגבייה</a>.</p>
  </div>

  <h2 id="urgent">בקשה דחופה לפני טיסה</h2>
  <p>בקשה דחופה מיועדת למצב שבו נדרשת החלטה תוך 24 שעות (לא כולל שבתות וחגים), או שדחייה תגרום לנזק בלתי הפיך. <strong>הפסד כספי מביטול טיסה, מלון או דמי ביטול לא נחשב נזק מהותי בלתי הפיך שמצדיק טיפול בבקשה דחופה אחרי שעות הפעילות,</strong> כי לרוב הייתה אפשרות להגיש בשעות הפעילות. מקרים שהרשות מכירה כדחופים, עם המסמכים שצריך לצרף:</p>
  <ul>
    <li><strong>הליך רפואי שלכם</strong> — אסמכתה רפואית ואישור על מועד ההליך.</li>
    <li><strong>הליך רפואי של קרוב מדרגה ראשונה</strong> (הורה, אח, בן, בת או בן זוג) — אסמכתה ומועד, והצהרה חתומה למה דווקא אתם צריכים ללוות.</li>
    <li><strong>הלוויה של קרוב מדרגה ראשונה</strong> בתוך 24–48 שעות — אישור פטירה ואישור על הקרבה המשפחתית.</li>
    <li><strong>דיון משפטי דחוף בחו"ל</strong> שהדרישה אליו התקבלה ב-24 השעות האחרונות — אסמכתה ותצהיר.</li>
    <li>פעילות מבצעית מטעם המדינה, וביקור משפחתי של חייל בודד — עם אסמכתה.</li>
  </ul>
  <p>מגישים באזור האישי בקוד 62, <strong>ובמקביל</strong> מעדכנים את הלשכה בטופס פנייה מקוון שנשלחה בקשה דחופה, עם מספר התיק. המסמכים צריכים להיות בעברית, באנגלית או בערבית, או עם תרגום מאושר. אחרי שעות הפעילות של המוקד: 074-7447070, בימים א'–ה' 16:00–22:00 ובימי שישי 08:00–13:00. מקור: <a href={CANCEL}>דף השירות</a>.</p>

  <h2 id="after">אחרי ההחלטה</h2>
  <ul>
    <li><strong>הלשכה מודיעה למשטרה.</strong> לפי סעיפים 14(ד) ו-66ד(ד) לחוק, כשצו או הגבלה מבוטלים, לשכת ההוצאה לפועל מודיעה על כך לגורמים הרלוונטיים תוך 24 שעות, ושולחת הודעה לכם ולזוכה. בכל זאת, שמרו את ההחלטה וקחו אותה איתכם.</li>
    <li><strong>בודקים שאין צו נוסף</strong> בתיק אחר או אצל גורם אחר. ביטול בתיק אחד לא מאפשר יציאה אם יש הגבלה בתיק אחר.</li>
    <li><strong>אם נתתם ערבים,</strong> דאגו שידווח על חזרתכם לארץ, כדי שהצו נגדם יבוטל.</li>
  </ul>

  <h2 id="help">מתי כדאי עורך דין</h2>
  <p>כשיש כמה תיקים, נסיעה רפואית קרובה, או החלטה שאתם לא מבינים על איזה סעיף היא מבוססת. אם אין לכם אפשרות לשלם לעורך דין, בדקו <a href="https://www.gov.il/he/service/legal_aid_application">זכאות לסיוע משפטי</a>. אין במדריך הבטחה לאישור נסיעה או לזמן טיפול מסוים.</p>

