const faqs = [
  {
    "q": "מה שיעור הריבית בהוצאה לפועל?",
    "a": "אין שיעור אחד לכל תיק. יש לבדוק את מקור החיוב, סוג הריבית, התקופה ופירוט היתרה הרשמי.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "q": "האם תיקון 9 עוצר ריבית כשהיא מגיעה לתקרה?",
    "a": "אין בו כלל של תקרה אחידה כאחוז מהקרן שעוצרת כל צבירה. הרפורמה שינתה את מנגנון הריבית ודמי הפיגורים לפי תנאיה.",
    "source": "https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot"
  },
  {
    "q": "האם אפשר לבקש הפחתה?",
    "a": "אפשר לבדוק בקשה מנומקת בהתאם לסמכות ולרכיב הרלוונטי. תיקון טעות, הפחתה בשיקול דעת והסכם עם הזוכה הם מסלולים שונים, ואין הבטחה למחיקה.",
    "source": "https://www.btl.gov.il/Laws1/00_0063_000000.pdf"
  },
  {
    "q": "האם כל החובות הישנים נהנים מאותה הפחתה?",
    "a": "לא ניתן לקבוע כך. בודקים את הוראות המעבר, מקור הריבית והתקופות; אין אחוז חיסכון אחיד.",
    "source": "https://main.knesset.gov.il/Activity/Legislation/Laws/pages/lawbill.aspx?lawitemid=2192648&t=lawreshumot"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
