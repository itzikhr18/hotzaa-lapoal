const faqs = [
  {
    "q": "איפה בודקים תיק לפי תעודת זהות?",
    "a": "באזור האישי הרשמי של ההוצאה לפועל לאחר הזדהות ובהתאם להרשאות. האתר הזה מפנה לשירות ואינו מבצע בדיקה או מקבל תעודת זהות.",
    "source": "https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page"
  },
  {
    "q": "אפשר לבדוק תיק של אדם אחר?",
    "a": "לא על סמך מספר תעודת הזהות שלו בלבד. גישה למסמכים מותנית בזיהוי ובהרשאה המתאימה בתיק.",
    "source": "https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page"
  },
  {
    "q": "איך רואים עיקולים?",
    "a": "פותחים את התיק ובודקים הליכים והחלטות. אם הצו מגוף אחר, הוא אינו בהכרח חלק מתיק הוצאה לפועל.",
    "source": "https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page"
  },
  {
    "q": "מהו דוח תיקים לחייב?",
    "a": "רשימה מרוכזת של תיקים; היא שונה מדף חשבון מפורט או מאישור סגירה. סוגי האישורים והפקתם מפורטים בשירות הממשלתי.",
    "source": "https://www.gov.il/he/pages/qf_personal"
  },
  {
    "q": "יש תמיד 20 ימים להגיב לאזהרה?",
    "a": "לא. המועד תלוי בהליך. בהתנגדות לשטר או לתביעה על סכום קצוב המועד הרגיל הוא 30 ימים מהמצאת האזהרה.",
    "source": "https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf"
  },
  {
    "q": "אין לי גישה לאזור האישי — מה אפשר לעשות?",
    "a": "ניתן לפנות לערוצי המידע הרשמיים ולבדוק שירות מתאים בלשכה, בהתאם לדרישות הזיהוי והזימון.",
    "source": "https://www.gov.il/he/pages/eca-call-center"
  }
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
