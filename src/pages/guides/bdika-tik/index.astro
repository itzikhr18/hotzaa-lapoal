---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const faqs = [
  {
    q: 'איך בודקים אם יש לי תיק בהוצאה לפועל לפי תעודת זהות?',
    a: 'הדרך הרשמית והחינמית היא האזור האישי של ההוצאה לפועל ב-gov.il. נרשמים פעם אחת למערכת ההזדהות הלאומית ורואים את כל התיקים הפתוחים נגדכם, כולל נתוני התיק, החלטות ודף חשבון. אפשר גם לפנות ללשכת הוצאה לפועל בזימון תור מראש.',
    source: 'https://www.gov.il/he/pages/qf_personal_information',
  },
  {
    q: 'אפשר לבדוק בלי מספר תיק?',
    a: 'כן, באזור האישי, שם רשימת התיקים מוצגת לפי הזיהוי שלכם. הצ\'אט האוטומטי והמענה הטלפוני דורשים מספר תיק ומספר זהות. גם בבנק הדואר, כשמזדהים בתעודת זהות בלי מספר תיק, מוצגות כל דרישות התשלום הפתוחות בתיקי ההוצאה לפועל.',
    source: 'https://www.gov.il/he/pages/execution_debtors_guide',
  },
  {
    q: 'האם הפקת רשימת תיקים יכולה להזיק לי?',
    a: 'כדאי לדעת את זה מראש. לפי רשות האכיפה והגבייה, כשמפיקים רשימת תיקים, נרשמת מסירת אזהרה בכל התיקים ברשימה שבהם עדיין לא נמסרה אזהרה. מאותו רגע מתחילה תקופת האזהרה. זו לא סיבה להימנע מבדיקה, אבל כדאי להיות מוכנים לפעול בתוך התקופה.',
    source: 'https://www.gov.il/he/service/lawyer-request-for-report-of-debt-files',
  },
  {
    q: 'איך רואים אם יש עיקול על חשבון הבנק?',
    a: 'באזור האישי, בפרטי התיק ובהחלטות שבו. במקביל אפשר לבקש מהבנק את פרטי הצו: מי הוציא אותו, באיזה תיק ובאיזה סכום. עיקול שלא מופיע בתיק הוצאה לפועל עשוי להיות עיקול מנהלי, למשל של עירייה או רשות המסים.',
    source: 'https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page',
  },
  {
    q: 'אפשר לבדוק תיקים של אדם אחר לפי תעודת הזהות שלו?',
    a: 'לא. צפייה בתיקים מותנית בהזדהות ובהרשאה. זוכה שמחפש מידע על חייב בתיק שלו פונה לשירות הייעודי לזוכים, ועורכי דין ועובדים סוציאליים מגישים בקשה נפרדת לרשימת תיקים של חייב.',
    source: 'https://www.gov.il/he/service/lawyer-request-for-report-of-debt-files',
  },
  {
    q: 'כמה זמן יש לי מרגע שקיבלתי אזהרה?',
    a: 'לפי מדריך הרשות לחייבים, תקופת האזהרה היא 30 ימים בתיקים מסוג תביעה על סכום קצוב ושטרות, ו-20 ימים בתיקים אחרים. התאריך המחייב הוא זה שמופיע באזהרה שלכם.',
    source: 'https://www.gov.il/he/pages/execution_debtors_guide',
  },
  {
    q: 'האם אתרים פרטיים לבדיקת תיק לפי תעודת זהות הם רשמיים?',
    a: 'לא. הבדיקה הרשמית נעשית באזור האישי, במוקד או בלשכה, והיא חינם. אל תמסרו מספר זהות, קוד הזדהות או סיסמה לאתר או לגורם שאינו רשמי.',
    source: 'https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

const sources = [
  { label: 'אזור אישי — הוצאה לפועל (gov.il)', href: 'https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page' },
  { label: 'רשות האכיפה והגבייה — קבלת מידע אישי ועדכני על תיקים', href: 'https://www.gov.il/he/pages/qf_personal_information' },
  { label: 'רשות האכיפה והגבייה — בקשה לקבלת רשימת תיקים של חייב', href: 'https://www.gov.il/he/service/lawyer-request-for-report-of-debt-files' },
  { label: 'רשות האכיפה והגבייה — מידע לחייבים בתיקי הוצאה לפועל', href: 'https://www.gov.il/he/pages/execution_debtors_guide' },
  { label: 'רשות האוכלוסין — בדיקת עיכוב יציאה מהארץ', href: 'https://www.gov.il/he/service/departure_prohibition_order_info_2' },
  { label: 'הנחיות התנגדות — טופס 218', href: 'https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf' },
];
---

<GuideLayout
  title="בדיקת תיק הוצאה לפועל לפי תעודת זהות: חובות, עיקולים ורשימת תיקים"
  description="איך בודקים חינם ובאופן רשמי אם יש נגדכם תיק בהוצאה לפועל: אזור אישי עם הזדהות לאומית, צ'אט אוטומטי, מוקד ‎*35592 או לשכה. איך רואים עיקולים ויתרת חוב, ומה חשוב לדעת לפני שמפיקים רשימת תיקים."
  breadcrumb={[{ label: 'מדריכים', href: '/guides/' }, { label: 'בדיקת תיק הוצאה לפועל', href: '/guides/bdika-tik/' }]}
  publishDate="2026-03-29"
  updateDate="2026-10-07"
  readTime="7 דקות"
  sources={sources}
  schema={[faqSchema]}
>
  <div class="info-box">
    <p class="mb-2"><strong>התשובה הקצרה:</strong> בודקים תיק בהוצאה לפועל, חינם, ב<a href="https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page">אזור האישי של ההוצאה לפועל ב-gov.il</a>. נכנסים עם מערכת ההזדהות הלאומית ורואים את כל התיקים הפתוחים נגדכם: יתרה, החלטות, עיקולים ודף חשבון.</p>
    <p class="mb-0">אפשר גם דרך הצ'אט האוטומטי או המוקד ‎*35592 (נדרש מספר תיק), או בלשכה בזימון תור. אין להזין באתר זה תעודת זהות או פרטי תיק — אנחנו אתר מידע ולא מבצעים בדיקות.</p>
  </div>

  <div class="not-prose my-6 flex flex-wrap gap-3">
    <a class="inline-block rounded-xl bg-brand-dark text-white px-5 py-3 font-bold" href="https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page">כניסה לאזור האישי הרשמי ←</a>
    <a class="inline-block rounded-xl border border-neutral-border px-5 py-3" href="#case-report">לפני שמפיקים רשימת תיקים</a>
  </div>

  <nav aria-label="ניווט מהיר במדריך" class="not-prose my-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
    <a class="text-brand underline" href="#ways">4 הדרכים לבדוק</a>
    <a class="text-brand underline" href="#check-by-id">בדיקת תיק לפי תעודת זהות</a>
    <a class="text-brand underline" href="#check-attachments">בדיקת עיקולים</a>
    <a class="text-brand underline" href="#case-report">דוח תיקים לחייב</a>
    <a class="text-brand underline" href="#next">מצאתי תיק — מה עכשיו?</a>
  </nav>

  <p>כשמגיע מכתב מהוצאה לפועל, או כשהבנק מודיע פתאום על עיקול, השאלה הראשונה היא כמה תיקים יש נגדי ועל כמה כסף מדובר. את התשובה המלאה מקבלים רק ממערכות רשות האכיפה והגבייה. הבדיקה חינמית ואפשר לעשות אותה מהבית. הנה כל הדרכים, ומה כדאי לדעת לפני שמתחילים.</p>

  <h2 id="ways">4 דרכים רשמיות לבדוק תיק בהוצאה לפועל</h2>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">ערוץ</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מה צריך</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מה מקבלים</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">אזור אישי — הוצאה לפועל</td>
          <td class="border border-gray-300 px-4 py-2">רישום חד-פעמי למערכת ההזדהות הלאומית. לא צריך מספר תיק</td>
          <td class="border border-gray-300 px-4 py-2">כל התיקים, נתוני התיק, בקשות, החלטות רשם ודף חשבון. אפשר גם להגיש בקשות</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">צ'אט — מענה אוטומטי</td>
          <td class="border border-gray-300 px-4 py-2">מספר זהות ומספר תיק</td>
          <td class="border border-gray-300 px-4 py-2">גובה החוב, תאריך החלטת רשם, תאריך וסכום התקבול האחרון, סטטוס התיק. זמין 24/7</td>
        </tr>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2 font-semibold">מוקד טלפוני ‎*35592 או 073-2055000</td>
          <td class="border border-gray-300 px-4 py-2">מספר תיק ומספר זהות</td>
          <td class="border border-gray-300 px-4 py-2">מענה אוטומטי בעברית, ערבית, אמהרית ורוסית, או נציג בשעות הפעילות</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-300 px-4 py-2 font-semibold">לשכת הוצאה לפועל</td>
          <td class="border border-gray-300 px-4 py-2">זימון תור מראש בלבד ותעודה מזהה</td>
          <td class="border border-gray-300 px-4 py-2">רשימת תיקים ומידע על התיקים. מתאים למי שאין לו גישה לאינטרנט</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="text-sm">מקור: <a href="https://www.gov.il/he/pages/qf_personal_information">רשות האכיפה והגבייה — קבלת מידע אישי ועדכני על תיקים</a>. שעות המוקד מתעדכנות מעת לעת, ולכן כדאי לבדוק אותן באתר הרשות.</p>

  <div class="tip-box">
    <p class="font-semibold mb-1">טיפ: לא יודעים את מספר התיק?</p>
    <p class="mb-0">באזור האישי מספר התיק לא נדרש. גם בבנק הדואר אפשר להזדהות בתעודת זהות בלבד: לפי מדריך הרשות, אם מספר התיק לא ידוע, יוצגו כל דרישות התשלום הפתוחות שלכם בתיקי ההוצאה לפועל.</p>
  </div>

  <h2 id="check-by-id" class="scroll-mt-24">בדיקת תיק לפי תעודת זהות באזור האישי — שלב אחר שלב</h2>
  <ol class="step-list">
    <li><span class="step-num">1</span><span><strong>נרשמים למערכת ההזדהות הלאומית</strong> (פעם אחת). זו אותה כניסה שמשמשת שירותי ממשלה אחרים. היכנסו דרך <a href="https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page">דף האזור האישי ב-gov.il</a> בלבד, ולא דרך קישור שהגיע אליכם בהודעה.</span></li>
    <li><span class="step-num">2</span><span><strong>נכנסים לאזור האישי — הוצאה לפועל.</strong> מוצגים התיקים שבהם אתם צד: כחייבים, כזוכים או כמסייעים.</span></li>
    <li><span class="step-num">3</span><span><strong>פותחים כל תיק בנפרד.</strong> בודקים את סוג התיק (פסק דין, שטרות, תביעה על סכום קצוב, מזונות), מי הזוכה, מה היתרה ומה ההחלטות האחרונות.</span></li>
    <li><span class="step-num">4</span><span><strong>מורידים את דף החשבון</strong> כדי לראות קרן, ריבית, הוצאות ותשלומים. היתרה היום כמעט אף פעם לא זהה לסכום המקורי. <a href="/guides/ribit-hotzaa/">איך קוראים את רכיבי החוב</a>.</span></li>
    <li><span class="step-num">5</span><span><strong>נרשמים לעדכוני החלטות</strong> ב-SMS או בדוא"ל. כך כל החלטה חדשה תגיע אליכם מיד ולא תפספסו מועד.</span></li>
  </ol>
  <p>שמות המסכים באתר הרשות משתנים מעת לעת. אם משהו לא ברור, יש באזור האישי צ'אט תמיכה עם נציג ו<a href="https://www.gov.il/he/departments/topics/personal-area-enforcement/govil-landing-page">הדרכות רשמיות</a>. אל תמסרו קוד הזדהות או סיסמה לאף אחד שפונה אליכם, גם אם הוא מציג את עצמו כנציג.</p>

  <h2 id="check-attachments" class="scroll-mt-24">בדיקת עיקולים לפי תעודת זהות</h2>
  <p>עיקול הוא פעולה שננקטת בתוך תיק מסוים. לכן בודקים אותו בתוך התיק: בהליכים ובהחלטות שמוצגים בו. אפשר גם לבדוק מהכיוון השני:</p>
  <ul>
    <li><strong>הבנק:</strong> בקשו מהבנק את פרטי צו העיקול: מי הוציא אותו, מספר התיק, התאריך והסכום. על חשבון אחד יכולים לחול כמה צווים מגופים שונים.</li>
    <li><strong>המעסיק:</strong> מחלקת השכר מחזיקה העתק של צו עיקול המשכורת ויכולה להראות לכם כמה מנוכה ולאיזה תיק.</li>
    <li><strong>העיקול לא מופיע בהוצאה לפועל?</strong> ייתכן שזה עיקול מנהלי, למשל של רשות מקומית על חוב ארנונה או של רשות המסים. עיקול כזה מטפלים מול הגוף שהטיל אותו. <a href="/guides/chov-arnona/">עיקול בגלל חוב ארנונה</a>.</li>
    <li><strong>עיכוב יציאה מהארץ:</strong> בודקים בשירות המקוון של <a href="https://www.gov.il/he/service/departure_prohibition_order_info_2">רשות האוכלוסין</a>, עם הזדהות לאומית. מוצגים רק צווים שמוגדרים "פתוחים לעיון הציבור". <a href="/guides/ikul-yetzia/">עיכוב יציאה מהארץ</a>.</li>
  </ul>
  <p>מצאתם עיקול? <a href="/guides/bitul-ikul/">כך מבקשים לבטל או לעכב אותו</a>, בטופס 214 או באזור האישי.</p>
  <p>מחפשים גם קנסות, דוחות משטרה, חוב לביטוח לאומי או נתוני אשראי? אלה בדרך כלל לא מופיעים בהוצאה לפועל (חריג: חוב מזונות לביטוח לאומי נגבה בתיק הוצאה לפועל). <a href="/guides/bdikat-hovot/">בדיקת חובות לפי תעודת זהות — כל הערוצים הרשמיים</a>.</p>

  <h2 id="case-report" class="scroll-mt-24">דוח תיקים לחייב (רשימת תיקים) — ומה חשוב לדעת לפני שמפיקים</h2>
  <p>"רשימת תיקים", או בשמה הנפוץ "דוח תיקים לחייב", היא רשימה מרוכזת של כל התיקים הפתוחים נגדכם בהוצאה לפועל, כולל מצב התיק וסוגו. חייבים שאינם מיוצגים מפיקים אותה <a href="https://www.gov.il/he/service/lawyer-request-for-report-of-debt-files">באזור האישי או בלשכה בזימון תור</a>. עורכי דין ועובדים סוציאליים מגישים בקשה נפרדת.</p>

  <div class="warn-box">
    <p class="font-semibold mb-1">שימו לב: הפקת הרשימה נחשבת קבלת אזהרה</p>
    <p class="mb-2">לפי רשות האכיפה והגבייה, כשמפיקים רשימת תיקים, נרשמת מסירת אזהרה בכל התיקים שברשימה שבהם עדיין לא נמסרה אזהרה. בפועל, מאותו יום מתחילה לרוץ תקופת האזהרה: 30 ימים בשטרות ובתביעה על סכום קצוב, ו-20 ימים בשאר התיקים.</p>
    <p class="mb-0">זו לא סיבה להימנע מהבדיקה. בדרך כלל עדיף לדעת מה פתוח נגדכם. אבל כדאי לפנות זמן לטפל בתיקים מיד אחר כך: לשלם, להגיש <a href="/guides/hitnagdut-letik/">התנגדות</a>, לבקש <a href="/guides/tzav-tashlumim/">צו תשלומים</a> או להתייצב ל<a href="/guides/hakirat-yecholet/">חקירת יכולת</a>.</p>
  </div>

  <p>רשימת התיקים היא לא דף חשבון ולא אישור על סגירת תיק. דף חשבון מפרט את התנועות בתיק אחד. אישור סגירה רלוונטי רק אחרי שהתיק נסגר. <a href="/guides/sgor-tik/">איך סוגרים תיק ומקבלים אישור</a>.</p>

  <h2 id="status">מה אומרים הסטטוסים של התיק?</h2>
  <p>הסטטוס הכללי ("פעיל", "מעוכב", "סגור") הוא רק נקודת התחלה. התמונה המלאה נמצאת בהחלטות עצמן:</p>
  <ul>
    <li><strong>פעיל:</strong> הזוכה יכול לבקש הליכי גבייה אחרי שעברה תקופת האזהרה.</li>
    <li><strong>מעוכב:</strong> לפעמים העיכוב חל רק על הליך מסוים, ולפעמים הוא מוגבל בזמן. קראו את ההחלטה.</li>
    <li><strong>סגור:</strong> בדקו את סיבת הסגירה. סגירה שאינה בגלל תשלום מלא לא בהכרח אומרת שהחוב נמחק. <a href="/guides/sgor-tik/">סגירת תיק</a>.</li>
  </ul>

  <h2 id="next">מצאתי תיק — מה עכשיו?</h2>
  <p>הצעד הנכון תלוי בסוג התיק ובמצב שלכם. לפי מדריך הרשות לחייבים, אלה האפשרויות העיקריות:</p>
  <div class="not-prose overflow-x-auto my-6">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-100 text-gray-700">
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">המצב</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מה עושים</th>
          <th class="border border-gray-300 px-4 py-2 text-right font-bold">מועד חשוב</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-white">
          <td class="border border-gray-300 px-4 py-2">לא מסכימים לחוב בתיק שטרות או תביעה על סכום קצוב</td>
          <td class="border border-gray-300 px-4 py-2"><a class="text-brand underline" href="/guides/hitnagdut-letik/">התנגדות</a></td>
          <td class="border border-gray-300 px-4 py-2">בדרך כלל 30 ימים מהמצאת האזהרה (<a class="text-brand underline" href="https://www.gov.il/BlobFolder/service/claim_objection/he/form218.pdf">הנחיות טופס 218</a>)</td>
        </tr>
        <tr class="bg-gray-50">
