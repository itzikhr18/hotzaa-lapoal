---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SalaryGarnishmentCalculator from '../../components/SalaryGarnishmentCalculator';
import { wageList, fmtILS, WAGE_AS_OF, WAGE_RULE_TEXT, WAGE_LAW_URL, WAGE_SOURCE_URL, WAGE_INCOME_LAW_URL } from '../../data/protected-amounts';
const questions = [
  { question: 'האם מותר לעקל רק 20% מהמשכורת?', answer: 'לא. בחוב שאינו מזונות ההגנה היא הנמוך מבין סכום הבסיס המשפחתי לבין 80% מהשכר לאחר ניכויי חובה בחוק. כשהבסיס נמוך מ-80% מהשכר, יתרת השכר שאינה מוגנת עשויה לעלות על 20%.' },
  { question: 'האם שכר נמוך מסכום הבסיס מוגן במלואו?', answer: 'לא מכוח סעיף 8 בלבד. אם סכום הבסיס גבוה מ-80% מהשכר, הסכום המוגן קטן ל-80% מהשכר. אין להסיק שהעיקול יהיה אפס.' },
  { question: 'לאיזה מועד וסוג הכנסה מתאימה ההדגמה?', answer: 'לשכר חודשי ממשלם אחד המשולם בספטמבר 2026, בחוב שאינו מזונות ובהרכב משפחה המתאים להגדרות. נעשה שימוש בסכומי 2026 שהיו בתוקף בחודש שקדם לתשלום. אין להשתמש בה לקצבת פנסיה, לשכר יומי או לתקופה אחרת בלי אימות מתאים.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'מחשבון עיקול משכורת — הדגמת כלל סעיף 8', description: 'הדגמה מוגבלת לשכר חודשי וחוב שאינו מזונות. אינה קובעת את סכום הניכוי בתיק.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', isAccessibleForFree: true, url: 'https://hotzaa-lapoal.info/tools/ikul-maskoret/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions.map(q => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })) },
];
---
<BaseLayout title="מחשבון עיקול משכורת — כלל 80% וסכומי הבסיס (2026)" description="הדגמה של החלק המוגן בשכר חודשי לפי סעיף 8: הנמוך בין הבסיס המשפחתי ל-80% מהשכר. כולל חריג מזונות, מקורות רשמיים ותנאי שימוש." schema={schema}>
  <Header />
  <main id="main-content" class="max-w-3xl mx-auto px-4 py-10 space-y-7">
    <Breadcrumb items={[{ label: 'כלים', href: '/tools/' }, { label: 'מחשבון עיקול משכורת' }]} />
    <h1 class="text-3xl font-bold text-brand-dark">מחשבון עיקול משכורת</h1>
    <p>הדגמה של כלל ההגנה בחוק — לא אישור לסכום עיקול בתיק מסוים. עריכת תוכן: 13.09.2026; ללא טענה לביקורת מקצועית של עורך דין.</p>
    <section class="bg-blue-50 border rounded-xl p-5 space-y-3">
      <h2 class="text-xl font-bold">מה באמת אומר כלל 80%?</h2>
      <p>{WAGE_RULE_TEXT}</p>
      <p>סעיף 8 מפנה לגמלה לפי טור ג׳ בתוספת השנייה לחוק הבטחת הכנסה, בהרכב המשפחה הרלוונטי ובחודש שקדם לתשלום השכר. ההפניה אינה מחייבת שהעובד יהיה בן 55.</p>
      <p>מקור: <a href={WAGE_LAW_URL} class="underline">חוק הגנת השכר, סעיף 8</a>; <a href={WAGE_INCOME_LAW_URL} class="underline">חוק הבטחת הכנסה, התוספת השנייה</a>.</p>
    </section>
    <section class="bg-white border rounded-xl p-5"><SalaryGarnishmentCalculator client:idle /><noscript>ההדגמה דורשת JavaScript. הכלל וטבלת המקור זמינים גם ללא הפעלתו; אין תוצאה אישית ללא בדיקה.</noscript></section>
    <section class="space-y-3">
      <h2 class="text-xl font-bold">סכומי בסיס לפי הרכב משפחה ({WAGE_AS_OF})</h2>
      <p>אלה אינם סכומים שחייבים תמיד להישאר בידך. ההגנה כפופה לתקרת 80% מהשכר ולחריגים. הנתונים מטבלת ביטוח לאומי, בתוקף מ-01.01.2026, קבוצת 55 עד גיל הפרישה; נבדקו ב-13.09.2026.</p>
      <div class="overflow-x-auto"><table class="w-full text-sm">
        <caption class="text-right mb-2">סכום הבסיס לפני השוואה ל-80% מהשכר</caption>
        <thead><tr><th scope="col" class="text-right p-2 border">הרכב משפחה</th><th scope="col" class="text-right p-2 border">סכום בסיס</th></tr></thead>
        <tbody>{wageList.map(item => <tr><th scope="row" class="text-right p-2 border font-normal">{item.label}</th><td class="p-2 border">{fmtILS(item.amount)}</td></tr>)}</tbody>
      </table></div>
      <p><a href={WAGE_SOURCE_URL} class="underline">טבלת הסכומים והגדרות בני זוג וילד — ביטוח לאומי</a>. אם המעמד המשפחתי אינו מתאים בבירור, אל תבחרו קטגוריה רק לפי מספר האנשים בבית.</p>
    </section>
    <section class="space-y-4"><h2 class="text-xl font-bold">שאלות נפוצות</h2>{questions.map(q => <details class="border rounded-lg p-4"><summary class="font-semibold">{q.question}</summary><p class="mt-3">{q.answer}</p></details>)}</section>
    <section class="space-y-3"><h2 class="text-xl font-bold">הניכוי בפועל נראה שגוי?</h2><p>אספו את צו העיקול, התלוש, פירוט הניכויים ומסמכי הרכב המשפחה. בקשו בירור מהמעסיק והגישו את הבקשה המתאימה בתיק לפי <a href="https://www.gov.il/he/service/cancel_salary_foreclosure" class="underline">שירות ביטול עיקול משכורת</a>. הגשת בקשה, תשלום חלקי או בקשה לצו תשלומים אינם כשלעצמם מבטלים עיקול; דרושה החלטה מתאימה.</p><p><a href="/guides/ikul-maskoret/" class="underline">מדריך עיקול משכורת</a> · <a href="/rights/skhomim-mugganim/" class="underline">כספים מוגנים מעיקול</a></p></section>
  </main>
  <Footer />
</BaseLayout>
