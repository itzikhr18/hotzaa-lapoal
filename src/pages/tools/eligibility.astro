---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EligibilityChecker from '../../components/EligibilityChecker';

const title = 'בדיקת מצב בהוצאה לפועל — מדריכים לפי הנושא שלך';
const description = 'ארבע שאלות לבחירת מדריכים ומקורות רשמיים על אזהרה, עיקולים, טפסים והסדרת חובות. בלי פרטים מזהים, סכומי חוב או קביעה משפטית.';
const pageUrl = 'https://hotzaa-lapoal.info/tools/eligibility/';
const faqs = [
  { q: 'האם הכלי קובע זכאות לחדלות פירעון או לביטול עיקול?', a: 'לא. הכלי בוחר קישורים לפי נושאי קריאה. הוא אינו בוחן את התיק, מחשב יכולת תשלום או ממליץ על הליך משפטי אישי.' },
  { q: 'אילו שאלות מופיעות בכלי?', a: 'נושא הקריאה, הצורך בהסבר לבדיקת תיק, סוג המידע הנוסף והרצון במידע על ריבוי תיקים. אין שאלות על גובה החוב, הכנסה, שם או מספר תיק.' },
  { q: 'האם הבחירות נשמרות או נשלחות?', a: 'הבחירות נשארות בזיכרון הדף ואינן נשלחות או נשמרות על ידי הכלי. מעבר לקישור חיצוני פותח את האתר הרשמי, שבו חלים כללי השירות והפרטיות שלו.' },
  { q: 'האם שימוש בכלי או הגשת בקשה עוצרים הליכים?', a: 'לא. השאלון אינו פעולה בתיק. גם הגשת בקשה אינה מבטיחה עיכוב; יש לבדוק את הדין, סוג הבקשה והחלטת הגורם המוסמך.' },
];
const appSchema = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: title, description, url: pageUrl,
  inLanguage: 'he', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any',
  isAccessibleForFree: true, browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS' },
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---
<BaseLayout title={title} description={description} canonicalUrl={pageUrl} schema={[appSchema, faqSchema]}>
  <Header />
  <main id="main-content" class="max-w-3xl mx-auto px-4 py-10">
    <Breadcrumb items={[{ label: 'כלים', href: '/tools/' }, { label: 'בדיקת מצב' }]} />
    <h1 class="text-3xl font-bold text-brand-dark mb-3">בדיקת מצב — איפה להתחיל לקרוא?</h1>
    <p class="text-lg text-gray-600 mb-6">ארבע שאלות קצרות יבחרו עבורך מדריכים ומקורות לפי נושא. זהו כלי ניווט למידע, לא בדיקת זכאות ולא המלצה על ההליך המתאים למקרה שלך.</p>
    <div class="rounded-xl bg-amber-50 border border-amber-200 p-4 mb-6 text-sm text-gray-800">אם מופיע במסמך מועד תגובה או מימוש — בדוק אותו בלי להמתין. הכלי אינו פונה לרשות, אינו מגיש בקשה ואינו עוצר הליכים.</div>
    <div class="bg-white border border-neutral-border rounded-2xl p-5 md:p-6">
      <EligibilityChecker client:load />
    </div>
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-3">אפשר גם לדלג ישר למידע</h2>
      <ul class="space-y-3 text-gray-700">
        <li><a href="/guides/bdika-tik/" class="underline">בדיקת תיק והחלטות באזור האישי</a> — כשלא ברור מה פתוח ומה נקבע.</li>
        <li><a href="/forms/" class="underline">טפסים 214, 218 ו־233</a> — הבחנה בין ביטול הליך, התנגדות ובקשת תשלומים.</li>
        <li><a href="/guides/tzav-tashlumim/" class="underline">צו תשלומים</a> — בקשה לפריסה אינה הבטחה לביטול עיקולים.</li>
        <li><a href="/guides/ichud-tikim/" class="underline">איחוד תיקים</a> — תנאים ותיקים שאינם נכללים, לא איחוד אוטומטי של הכול.</li>
        <li><a href="/insolvency/" class="underline">חדלות פירעון</a> — תנאים, השלכות והחריגים להפטר.</li>
      </ul>
    </section>
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-3">הגורמים הרשמיים מחליטים</h2>
      <p class="text-gray-700">המסלול, המסמכים, המועדים וההחלטות נקבעים לפי הדין והגורם המוסמך. ניתן לקרוא את <a href="https://www.gov.il/he/pages/insovlency-request-guide?chapterindex=4" target="_blank" rel="noopener noreferrer" class="underline">מדריך חדלות הפירעון הרשמי</a>, את <a href="https://www.gov.il/he/service/request_for_consolidation_portfolio" target="_blank" rel="noopener noreferrer" class="underline">תנאי איחוד התיקים</a> ואת <a href="https://www.gov.il/he/service/request-change-payment-arrangement-222" target="_blank" rel="noopener noreferrer" class="underline">הנחיות בקשת צו תשלומים</a>.</p>
    </section>
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-4">שאלות נפוצות</h2>
      <div class="space-y-3">{faqs.map(faq => (
        <details class="border border-neutral-border rounded-xl"><summary class="p-4 font-semibold cursor-pointer">{faq.q}</summary><p class="px-4 pb-4 text-sm text-gray-700">{faq.a}</p></details>
      ))}</div>
    </section>
  </main>
  <Footer />
</BaseLayout>
