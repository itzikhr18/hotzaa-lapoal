---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RequestLetterGenerator from '../../components/RequestLetterGenerator';
import Breadcrumb from '../../components/Breadcrumb.astro';

const siteUrl = 'https://hotzaa-lapoal.info';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'מחולל נוסח בקשה לרשם ההוצאה לפועל',
  description: 'יצירת טיוטת נוסח בקשה לעריכה ולבדיקה לרשם ההוצאה לפועל: ביטול עיקול חשבון, ביטול עיקול משכורת, צו תשלומים והשבת סכום שנוכה ביתר.',
  url: `${siteUrl}/tools/noseach-bakasha/`,
  inLanguage: 'he',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS' },
  isAccessibleForFree: true,
  audience: { '@type': 'Audience', audienceType: 'חייבים בהוצאה לפועל בישראל', geographicArea: { '@type': 'Country', name: 'Israel' } },
  publisher: { '@type': 'Organization', name: 'הוצאהלפועל.info', url: siteUrl, logo: { '@type': 'ImageObject', url: `${siteUrl}/og-image.png` } },
  featureList: [
    '4 סוגי בקשות: ביטול עיקול חשבון, ביטול/הפחתת עיקול משכורת, צו תשלומים, השבת סכום שנוכה ביתר',
    'דוגמאות לנימוקים לבחירה רק לאחר בדיקת נכונותם',
    'רשימת מסמכים מצורפים מומלצת לכל סוג בקשה',
    'העתקה או הורדה כקובץ — הכל בדפדפן, בלי לשלוח פרטים לשרת',
  ],
};

const faqs = [
  {
    "q": "איך משתמשים בטיוטה להגשת בקשה?",
    "a": "בודקים את דף השירות והטופס הרשמי, עורכים את הנימוקים ומוחקים טענות שאינן נכונות. מצרפים מסמכים ומגישים בדרך הרשמית המותרת לסוג הבקשה והייצוג. הטיוטה לבדה אינה הגשה."
  },
  {
    "q": "האם חובה להזין פרטים מזהים בכלי?",
    "a": "לא. אפשר להעתיק או להוריד טיוטה עם שדות ריקים, ולהשלים את הפרטים מחוץ לאתר לפני הגשה רשמית. הכלי אינו שולח את הנתונים לשרת ואינו שומר אותם."
  },
  {
    "q": "מתי תינתן החלטה בבקשה?",
    "a": "יש לבדוק את זמני הטיפול והמעקב בדף השירות הרשמי לסוג הבקשה. אין זמן אחיד של שבועיים עד ארבעה שבועות לכל הבקשות. במקרה דחוף יש להסביר ולתמוך בדחיפות, בלי להניח שהתקבל עיכוב."
  },
  {
    "q": "האם טופס 233 עוצר עיקולים?",
    "a": "בקשת צו תשלומים אינה הבטחה לעיכוב הליכים. אם נדרש עיכוב של הליך מסוים, בודקים את הבקשה המתאימה, מנמקים אותה ועוקבים אחר ההחלטה."
  },
  {
    "q": "מה עושים אם הבקשה נדחתה?",
    "a": "בודקים את ההחלטה ואת מסלול ההשגה והמועד המתאימים לה. אין להניח שבקשה חוזרת עוצרת מועד ערעור, או שכל החלטה ניתנת לערעור באותה דרך."
  }
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---

<BaseLayout
  title="מחולל בקשה להוצאה לפועל — נוסח חינם"
  description="צור בחינם טיוטת נוסח בקשה לעריכה ולבדיקה לרשם ההוצאה לפועל: ביטול עיקול חשבון או משכורת, צו תשלומים והשבת כסף שנוכה ביתר. הכל בדפדפן — בלי לשלוח פרטים."
  schema={[appSchema, faqSchema]}
>
  <Header />
  <main id="main-content" class="max-w-3xl mx-auto px-4 py-10">

<Breadcrumb items={[{ label: 'כלים', href: '/tools/' }, { label: 'מחולל נוסח בקשה' }]} />

    <h1 class="text-3xl font-bold text-brand-dark mb-2">מחולל נוסח בקשה לרשם ההוצאה לפועל</h1>
    <p class="text-gray-600 mb-2">ממלאים פרטים, מסמנים נימוקים — ומקבלים טיוטה לעריכה ולבדיקה לפני הגשה</p>

    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6 text-sm text-blue-800">
      <strong>איך זה עובד?</strong> בוחרים את סוג הבקשה, ממלאים את הפרטים ומסמנים את הנימוקים
      שמתאימים למצב שלך. הנוסח נבנה אוטומטית — מעתיקים או מורידים, מצרפים מסמכים,
      ומגישים בדרך המתאימה לסוג הבקשה לפי ההנחיות הרשמיות. אפשר להשאיר את הפרטים המזהים ריקים ולהשלימם מחוץ לאתר.
    </div>

    <section class="bg-gray-50 border border-gray-200 rounded-xl p-4 mb-6 text-sm">
      <h2 class="font-bold mb-2">מקורות להגשה — לפני השימוש בטיוטה</h2>
      <ul class="space-y-2">
        <li><a class="underline" href="https://www.gov.il/BlobFolder/service/processes_cancellation/he/form214.pdf" target="_blank" rel="noopener noreferrer">טופס 214 — ביטול, עיכוב וחידוש הליכים</a></li>
        <li><a class="underline" href="https://www.gov.il/he/service/request-change-payment-arrangement-222" target="_blank" rel="noopener noreferrer">בקשת צו תשלומים — טופס 233 ונספחים</a></li>
        <li><a class="underline" href="https://www.gov.il/he/service/delay_processes" target="_blank" rel="noopener noreferrer">בקשה לעיכוב הליכים — שירות רשמי</a></li>
      </ul>
      <p class="mt-3">אין בקשה שנשלחת מכאן לרשות. ייתכנו חריגים להגנות על שכר וקצבאות, והחלטה על ביטול או השבה אינה מובטחת.</p>
    </section>
    <div class="bg-white border border-neutral-border rounded-2xl p-6 shadow-xs">
      <!-- גילוי נאות -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6 text-sm text-gray-700">
      <p class="font-semibold text-gray-800 mb-1">⚠️ גילוי נאות</p>
      <p>הנוסח המופק הוא <strong>נוסח עזר כללי</strong> המבוסס על הפרטים שהזנת. הוא <strong>אינו מהווה ייעוץ משפטי</strong>, אינו מותאם לנסיבות המשפטיות הספציפיות שלך, ואינו מחליף נוסח של עורך דין. <strong>לפני הגשה:</strong> בדוק את הטופס הרשמי העדכני באתר רשות האכיפה והגבייה, התאם את הנוסח לפרטי התיק, וודא שכל המסמכים הנדרשים מצורפים. מומלץ להתייעץ עם עורך דין לפני הגשה.</p>
    </div>
    <RequestLetterGenerator client:idle />
    </div>

    <div class="mt-10 border-t pt-8 border-gray-200">
      <h2 class="text-xl font-bold text-gray-800 mb-4">שאלות נפוצות</h2>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="border border-neutral-border rounded-xl group">
            <summary class="p-4 font-semibold text-gray-800 cursor-pointer hover:bg-gray-50 rounded-xl list-none flex justify-between items-center text-sm">
              {faq.q}
              <span class="text-neutral-muted group-open:rotate-180 transition-transform flex-shrink-0 mr-2">▼</span>
            </summary>
            <p class="px-4 pb-4 text-gray-600 text-sm">{faq.a}</p>
          </details>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/forms/" class="inline-flex items-center gap-1 text-sm text-brand hover:underline">
          ← כל הטפסים והנוסחים
        </a>
        <span class="text-gray-300">|</span>
        <a href="/guides/bitul-ikul/" class="inline-flex items-center gap-1 text-sm text-brand hover:underline">
          ← המדריך המלא לביטול עיקול
        </a>
        <span class="text-gray-300">|</span>
        <a href="/tools/ikul-maskoret/" class="inline-flex items-center gap-1 text-sm text-brand hover:underline">
          ← מחשבון עיקול משכורת
        </a>
      </div>
    </div>

  </main>
  <Footer />
</BaseLayout>
